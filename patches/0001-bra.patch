+/*
+ * Thumbnail of the current game screen for the saved games, kept in the
+ * screen's aspect ratio (16:9 in HD widescreen, 8:5 at 640x400) instead of
+ * ScummVM's default 4:3 one, and box filtered so that a 3x HD frame does not
+ * alias.
+ */
+bool createSaveThumbnail(Graphics::Surface &thumb) {
+	Graphics::Surface *screen = g_system->lockScreen();
+	if (!screen || screen->w <= 0 || screen->h <= 0) {
+		if (screen)
+			g_system->unlockScreen();
+		return false;
+	}
+
+	const Graphics::PixelFormat fmt = screen->format;
+	byte pal[256 * 3];
+	if (fmt.bytesPerPixel == 1)
+		g_system->getPaletteManager()->grabPalette(pal, 0, 256);
+
+	const int tw = kThumbnailWidth;
+	const int th = CLIP<int>((screen->h * tw + screen->w / 2) / screen->w, 1, kThumbnailHeight2);
+	thumb.create(tw, th, Graphics::PixelFormat(2, 5, 6, 5, 0, 11, 5, 0, 0));
+
+	for (int ty = 0; ty < th; ty++) {
+		const int y0 = ty * screen->h / th, y1 = MAX(y0 + 1, (ty + 1) * screen->h / th);
+		for (int tx = 0; tx < tw; tx++) {
+			const int x0 = tx * screen->w / tw, x1 = MAX(x0 + 1, (tx + 1) * screen->w / tw);
+			uint32 r = 0, g = 0, b = 0, n = 0;
+			for (int y = y0; y < y1; y++) {
+				const byte *p = (const byte *)screen->getBasePtr(x0, y);
+				for (int x = x0; x < x1; x++, p += fmt.bytesPerPixel) {
+					byte cr, cg, cb;
+					if (fmt.bytesPerPixel == 1) {
+						cr = pal[*p * 3]; cg = pal[*p * 3 + 1]; cb = pal[*p * 3 + 2];
+					} else if (fmt.bytesPerPixel == 2) {
+						fmt.colorToRGB(READ_UINT16(p), cr, cg, cb);
+					} else {
+						fmt.colorToRGB(READ_UINT32(p), cr, cg, cb);
+					}
+					r += cr; g += cg; b += cb; n++;
+				}
+			}
+			*(uint16 *)thumb.getBasePtr(tx, ty) = thumb.format.RGBToColor(r / n, g / n, b / n);
+		}
+	}
+
+	g_system->unlockScreen();
+	return true;
 }
 
