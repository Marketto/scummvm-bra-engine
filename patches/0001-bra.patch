+float hdBalloonDistance(const HDBalloonShape &s, float x, float y) {
+	// oval: first order distance from the implicit function (exact enough near the outline)
+	float dx = x - s.cx, dy = y - s.cy;
+	float k = sqrtf(dx * dx / (s.a * s.a) + dy * dy / (s.b * s.b));
+	float gx = dx / (s.a * s.a), gy = dy / (s.b * s.b);
+	float g = sqrtf(gx * gx + gy * gy);
+	float d = (k < 1e-4f || g < 1e-6f) ? -MIN(s.a, s.b) : (k * k - 1) / (2 * g);
+	if (!s.tail)
+		return d;
+	// tail: a triangle from two points of the oval (around the direction of the tip) to the tip
+	float ang = atan2f((s.tipY - s.cy) / s.b, (s.tipX - s.cx) / s.a);
+	const float spread = 0.22f;
+	float p0x = s.cx + s.a * cosf(ang - spread) * 0.92f, p0y = s.cy + s.b * sinf(ang - spread) * 0.92f;
+	float p1x = s.cx + s.a * cosf(ang + spread) * 0.92f, p1y = s.cy + s.b * sinf(ang + spread) * 0.92f;
+	float p2x = s.tipX, p2y = s.tipY;
+	// signed distance to a triangle (Inigo Quilez)
+	float e0x = p1x - p0x, e0y = p1y - p0y, e1x = p2x - p1x, e1y = p2y - p1y, e2x = p0x - p2x, e2y = p0y - p2y;
+	float v0x = x - p0x, v0y = y - p0y, v1x = x - p1x, v1y = y - p1y, v2x = x - p2x, v2y = y - p2y;
+	float t0 = CLIP((v0x * e0x + v0y * e0y) / (e0x * e0x + e0y * e0y), 0.0f, 1.0f);
+	float t1 = CLIP((v1x * e1x + v1y * e1y) / (e1x * e1x + e1y * e1y), 0.0f, 1.0f);
+	float t2 = CLIP((v2x * e2x + v2y * e2y) / (e2x * e2x + e2y * e2y), 0.0f, 1.0f);
+	float q0x = v0x - e0x * t0, q0y = v0y - e0y * t0, q1x = v1x - e1x * t1, q1y = v1y - e1y * t1, q2x = v2x - e2x * t2, q2y = v2y - e2y * t2;
+	float sgn = (e0x * e2y - e0y * e2x) < 0 ? -1.0f : 1.0f;
+	float d0 = q0x * q0x + q0y * q0y, s0 = sgn * (v0x * e0y - v0y * e0x);
+	float d1 = q1x * q1x + q1y * q1y, s1 = sgn * (v1x * e1y - v1y * e1x);
+	float d2 = q2x * q2x + q2y * q2y, s2 = sgn * (v2x * e2y - v2y * e2x);
+	float dmin = MIN(d0, MIN(d1, d2)), smin = MIN(s0, MIN(s1, s2));
+	float dt = -sqrtf(dmin) * (smin < 0 ? -1.0f : 1.0f);
+	return MIN(d, dt);
+}
+
+void hdPaintRays(Graphics::Surface &s, const Graphics::PixelFormat &f, int w, int h, float cyf, float dark) {
+	s.create(w, h, f);
+	const float cx = w / 2.0f, cy = h * cyf, m = (float)MAX(w, h);
+	const float red[3] = { 179, 18, 31 }, deep[3] = { 92, 8, 16 }, night[3] = { 42, 3, 7 };
+	for (int y = 0; y < h; y++) {
+		for (int x = 0; x < w; x++) {
+			// 2x2 samples: soft edges between the bands
+			float k = 0;
+			for (int sy = 0; sy < 2; sy++) {
+				for (int sx = 0; sx < 2; sx++) {
+					float a = atan2f(y + 0.25f + sy * 0.5f - cy, x + 0.25f + sx * 0.5f - cx) * 180.0f / 3.14159265f + 360.0f;
+					k += ((int)(a / 9.0f) & 1) ? 0.0f : 0.25f;
+				}
+			}
+			float d = sqrtf((x - cx) * (x - cx) + (y - cy) * (y - cy)) / m;
+			// the loader's vignette: clear in the middle, then 55% and 92% of the night colour
+			float v = d < 0.12f ? 0.0f : d < 0.37f ? 0.55f * (d - 0.12f) / 0.25f : d < 0.71f ? 0.55f + 0.37f * (d - 0.37f) / 0.34f : 0.92f;
+			v = dark + (1 - dark) * v;
+			byte c[3];
+			for (int i = 0; i < 3; i++)
+				c[i] = (byte)((red[i] * k + deep[i] * (1 - k)) * (1 - v) + night[i] * v);
+			uint32 px = f.RGBToColor(c[0], c[1], c[2]);
+			if (f.bytesPerPixel == 4)
+				*(uint32 *)s.getBasePtr(x, y) = px;
+			else
+				*(uint16 *)s.getBasePtr(x, y) = px;
+		}
+	}
+}
+
+static void runBackup(Graphics::Surface *s, HDTextRun &r) {
+	Common::Rect rc(r.x, r.y, r.x + r.w, r.y + r.h);
+	rc.clip(Common::Rect(s->w, s->h));
+	r.saved = rc;
+	r.backup.resize(MAX<int>(0, rc.width() * rc.height()));
+	for (int y = rc.top; y < rc.bottom; y++)
+		memcpy(&r.backup[(y - rc.top) * rc.width()], s->getBasePtr(rc.left, y), rc.width());
+}
+
+static void runRestore(Graphics::Surface *s, HDTextRun &r) {
+	const Common::Rect &rc = r.saved;
+	if (r.backup.empty())
+		return;
+	for (int y = rc.top; y < rc.bottom; y++)
+		memcpy(s->getBasePtr(rc.left, y), &r.backup[(y - rc.top) * rc.width()], rc.width());
+	r.backup.clear();
+}
+static bool g_hdFontActive[HDRenderer::kNumHDFonts] = { false, false, false };
+
+static bool g_hdItalian = false;
+
+// The Italian texts write accents as apostrophes (e' piu' perche'): the new font
+// has the real letters (CP437 codes, like the rest of the game text)
+static Common::String italianAccents(const char *s) {
+	static const char *const keep[] = { "po", "be", "mo", "to", "va", "fa", "sta", "da", "di", "de", nullptr };
+	static const char *const acute[] = { "perche", "poiche", "affinche", "benche", "giacche", "finche", "cosicche", "nonche", "sicche", "purche", "ne", nullptr };
+	Common::String in(s), out;
+	for (uint i = 0; i < in.size(); i++) {
+		char c = in[i];
+		bool end = (i + 1 == in.size()) || strchr(" .,!?;:\"\\)", in[i + 1]);
+		if (c == '\'' && i > 0 && end && strchr("aeiouAEIOU", in[i - 1])) {
+			// the word before the apostrophe
+			int j = (int)out.size();
+			while (j > 0 && Common::isAlpha(out[j - 1]))
+				j--;
+			Common::String word = out.substr(j);
+			word.toLowercase();
+			bool isKeep = false, isAcute = false;
+			for (int k = 0; keep[k]; k++)
+				if (word == keep[k])
+					isKeep = true;
+			for (int k = 0; acute[k]; k++)
+				if (word == acute[k])
+					isAcute = true;
+			char v = out.lastChar();
+			byte r = 0;
+			if (!isKeep) {
+				if (isAcute && (v == 'e'))
+					r = 0x82;	// é
+				else switch (v) {
+				case 'a': r = 0x85; break;	// à
+				case 'e': r = 0x8A; break;	// è
+				case 'i': r = 0x8D; break;	// ì
+				case 'o': r = 0x95; break;	// ò
+				case 'u': r = 0x97; break;	// ù
+				case 'E': r = 0x90; break;	// É (CP437 has no È)
+				default: break;
+				}
+			}
+			if (r) {
+				out.deleteLastChar();
+				out += (char)r;
+				continue;
+			}
+		}
+		out += c;
+	}
+	return out;
+}
+
+static HDSurfaceRuns *findRuns(Graphics::Surface *surf, bool create) {
+	for (uint i = 0; i < g_hdTextRuns.size(); i++)
+		if (g_hdTextRuns[i].surf == surf)
+			return &g_hdTextRuns[i];
+	if (!create)
+		return nullptr;
+	HDSurfaceRuns r;
+	r.surf = surf;
+	g_hdTextRuns.push_back(r);
+	return &g_hdTextRuns.back();
+}
+
+bool hdTextCapture(Graphics::Surface *surf, int font, int x, int y, const char *s, byte color, int w, int h) {
+	if (font < 0 || font >= HDRenderer::kNumHDFonts || !g_hdFontActive[font] || !surf)
+		return false;
+	HDSurfaceRuns *sr = findRuns(surf, true);
+	HDTextRun run;
+	run.text = g_hdItalian ? italianAccents(s) : Common::String(s);
+	run.orig = s;
+	run.x = x;
+	run.y = y;
+	run.w = w;
+	run.h = h;
+	run.color = color;
+	run.font = font;
+	run.xorMask = 0;
+	run.left = (x > 0 && x <= 6);
+	// the same spot written again (e.g. a dialogue answer changing colour): replace
+	for (uint i = 0; i < sr->runs.size(); i++) {
+		if (sr->runs[i].x == x && sr->runs[i].y == y) {
+			runRestore(surf, sr->runs[i]);
+			if (g_hdClassic)
+				runBackup(surf, run);
+			sr->runs[i] = run;
+			return !g_hdClassic;
+		}
+	}
+	if (g_hdClassic)
+		runBackup(surf, run);	// the caller draws it with the original font
+	sr->runs.push_back(run);
+	return !g_hdClassic;
+}
+
+void hdTextSetClassic(bool classic) {
+	if (classic == g_hdClassic)
+		return;
+	g_hdClassic = classic;
+	for (uint i = 0; i < g_hdTextRuns.size(); i++) {
+		HDSurfaceRuns &sr = g_hdTextRuns[i];
+		for (uint j = 0; j < sr.runs.size(); j++) {
+			HDTextRun &r = sr.runs[j];
+			if (classic) {
+				if (r.xorMask || !g_hdBitmapDraw)
+					continue;
+				runBackup(sr.surf, r);
+				g_hdBitmapDraw(sr.surf, r.font, r.x, r.y, r.orig.c_str(), r.color);
+			} else {
+				runRestore(sr.surf, r);
+			}
+		}
+	}
+}
+
+bool hdTextActive() {
+	for (int i = 0; i < HDRenderer::kNumHDFonts; i++)
+		if (g_hdFontActive[i])
+			return true;
+	return false;
+}
+
+static void hdTextShutdown() {
+	for (int i = 0; i < HDRenderer::kNumHDFonts; i++)
+		g_hdFontActive[i] = false;
+	g_hdTextRuns.clear();
+}
+
+void hdTextForget(Graphics::Surface *surf) {
+	for (uint i = 0; i < g_hdTextRuns.size(); i++) {
+		if (g_hdTextRuns[i].surf == surf) {
+			g_hdTextRuns.remove_at(i);
+			return;
+		}
+	}
+}
+
+void hdTextXor(Graphics::Surface *surf, int yFrom, byte mask) {
+	HDSurfaceRuns *sr = findRuns(surf, false);
+	if (!sr)
+		return;
+	for (uint i = 0; i < sr->runs.size(); i++)
+		if (sr->runs[i].y >= yFrom)
+			sr->runs[i].xorMask ^= mask;
+}
+
+bool HDRenderer::loadFont(int id, const char *name) {
+	HDFont &f = _fonts[id];
+	f.ok = false;
+	Common::SeekableReadStream *dat = openHDFile(Common::String::format("fonts/%s.dat", name));
+	Common::SeekableReadStream *png = openHDFile(Common::String::format("fonts/%s.png", name));
+	if (!dat || !png) {
+		delete dat;
+		delete png;
+		return false;
+	}
+	bool ok = dat->readUint32BE() == MKTAG('B', 'R', 'F', 'N');
+	dat->readUint16LE();	// version
+	dat->readUint16LE();	// scale (3)
+	f.line = dat->readUint16LE();
+	f.asc = dat->readUint16LE();
+	f.outline = dat->readUint16LE();
+	for (int i = 0; i < 256; i++) {
+		f.g[i].ax = dat->readUint16LE();
+		f.g[i].ay = dat->readUint16LE();
+		f.g[i].w = dat->readUint16LE();
+		f.g[i].h = dat->readUint16LE();
+		f.g[i].bx = dat->readSint16LE();
+		f.g[i].by = dat->readSint16LE();
+		f.g[i].adv = dat->readUint16LE();
+	}
+	ok = ok && !dat->err();
+	delete dat;
+
+	Image::PNGDecoder dec;
+	ok = ok && dec.loadStream(*png);
+	delete png;
+	if (!ok)
+		return false;
+	const Graphics::PixelFormat argb(4, 8, 8, 8, 8, 16, 8, 0, 24);
+	Graphics::Surface *s = dec.getSurface()->convertTo(argb, dec.getPalette().data(), dec.getPalette().size());
+	f.aw = s->w;
+	f.ah = s->h;
+	f.atlas.resize(f.aw * f.ah * 2);
+	for (int y = 0; y < f.ah; y++) {
+		const uint32 *p = (const uint32 *)s->getBasePtr(0, y);
+		for (int x = 0; x < f.aw; x++) {
+			f.atlas[(y * f.aw + x) * 2] = (p[x] >> 16) & 0xff;		// fill
+			f.atlas[(y * f.aw + x) * 2 + 1] = (p[x] >> 8) & 0xff;	// outline
+		}
+	}
+	s->free();
+	delete s;
+	f.ok = true;
+	debug(1, "HD font %s loaded (line %d)", name, f.line);
+	return true;
+}
+
+void HDRenderer::loadFonts() {
+	if (ConfMan.hasKey("hd_fonts") && !ConfMan.getBool("hd_fonts"))
+		return;
+	g_hdItalian = (_vm->getInternLanguage() == kItalian);
+	static const char *const names[kNumHDFonts] = { "comic", "russia", "subtitle" };
+	for (int i = 0; i < kNumHDFonts; i++)
+		g_hdFontActive[i] = loadFont(i, names[i]);
+}
