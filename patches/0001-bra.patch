+		for (int i = 0; i < 81; i += 3) {
+			for (int c = 0; c < 3; c++)
+				pal.setEntry(base + i + c, colors[c][0], colors[c][1], colors[c][2]);
+		}
+		break;
+	case 1:
+		for (int i = 0; i < 81; i += 9) {
+			for (int j = 0; j < 3; j++) {
+				for (int c = 0; c < 3; c++)
+					pal.setEntry(base + i + j + 3 * c, colors[c][0], colors[c][1], colors[c][2]);
+			}
+		}
+		break;
+	case 2:
+		for (int i = 0; i < 81; i += 27) {
+			for (int j = 0; j < 9; j++) {
+				for (int c = 0; c < 3; c++)
+					pal.setEntry(base + i + j + 9 * c, colors[c][0], colors[c][1], colors[c][2]);
+			}
+		}
+		break;
+	case 3:
+		for (int j = 0; j < 27; j++) {
+			for (int c = 0; c < 3; c++)
+				pal.setEntry(base + j + 27 * c, colors[c][0], colors[c][1], colors[c][2]);
+		}
+		break;
+	default:
+		break;
+	}
+
+	_gfx->setPalette(pal);
+	_albcycleMode = (_albcycleMode + 1) % 4;
 }
 
