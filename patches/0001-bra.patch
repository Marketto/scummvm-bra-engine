+bool HDRenderer::fontsEnabled() const {
+	for (int i = 0; i < kNumHDFonts; i++)
+		if (g_hdFontActive[i])
+			return true;
+	return false;
+}
+
+void HDRenderer::addSurfaceText(Graphics::Surface *surf, int offY, int frameH, int x, int y, const Common::Rect &clip, bool band) {
+	HDSurfaceRuns *sr = findRuns(surf, false);
+	if (!sr)
+		return;
+	for (uint i = 0; i < sr->runs.size(); i++) {
+		const HDTextRun &r = sr->runs[i];
+		if (r.y < offY || r.y >= offY + frameH)
+			continue;
+		FrameText ft;
+		ft.text = r.text;
+		ft.x = x + r.x;
+		ft.y = y + r.y - offY;
+		ft.w = r.w;
+		ft.h = r.h;
+		ft.font = r.font;
+		ft.xorMask = r.xorMask;
+		ft.color = r.color;
+		ft.left = r.left;
+		ft.band = band;
+		// subtitles: their own, more readable face (still in the game's fake Cyrillic)
+		if (band && _fonts[2].ok && ft.font == 1)
+			ft.font = 2;
+		ft.clip = clip;
+		// labels may grow a bit with the new font
+		ft.clip.grow(6);
+		_frameText.push_back(ft);
+	}
+}
+
+static Common::String frameTextSignature(const Common::Array<HDRenderer::FrameText> &a) {
+	Common::String s;
+	for (uint i = 0; i < a.size(); i++)
+		s += Common::String::format("%d,%d,%d,%d,%d|", a[i].x, a[i].y, a[i].color, a[i].xorMask, a[i].font) + a[i].text + "\n";
+	return s;
+}
+
+static bool sameFrameText(const HDRenderer::FrameText &a, const HDRenderer::FrameText &b) {
+	return a.x == b.x && a.y == b.y && a.w == b.w && a.h == b.h && a.color == b.color && a.font == b.font &&
+		a.xorMask == b.xorMask && a.left == b.left && a.band == b.band && a.clip == b.clip && a.text == b.text;
+}
+
+// area a text can paint, in game coordinates (original pixels): the glyphs stay inside the clip box,
+// the subtitle band can reach a little beyond it (see drawTexts)
+static Common::Rect frameTextBounds(const HDRenderer::FrameText &ft) {
+	Common::Rect r(ft.clip);
+	if (ft.band)
+		r.extend(Common::Rect(ft.x - ft.w / 20 - 16, ft.y - 4, ft.x + ft.w + ft.w / 20 + 16, ft.y + ft.h + 5));
+	r.grow(1);
+	return r;
+}
+
+template<typename PixelT>
+static inline void blendPixel(PixelT *d, byte r, byte g, byte b, int a, const Graphics::PixelFormat &fmt) {
+	if (a <= 0)
+		return;
+	if (a >= 255) {
+		*d = (PixelT)fmt.RGBToColor(r, g, b);
+		return;
+	}
+	byte r0, g0, b0;
+	fmt.colorToRGB(*d, r0, g0, b0);
+	*d = (PixelT)fmt.RGBToColor((r * a + r0 * (255 - a)) / 255, (g * a + g0 * (255 - a)) / 255, (b * a + b0 * (255 - a)) / 255);
+}
+
+template<typename PixelT>
+void HDRenderer::drawFrameText(const FrameText &ft, const Common::Rect &area, int scrollX, int scrollY) {
+	const HDFont &f = _fonts[ft.font];
+	if (!f.ok)
+		return;
+	const int S = _scale;
+
+	// colours from the current palette, so that fades and the gray view apply
+	int fillIdx, outIdx;
+	if (ft.font == 2) {
+		fillIdx = 12;
+		outIdx = 1;
+	} else if (ft.font == 0) {
+		fillIdx = ft.color ? ft.color : 1;
+		outIdx = -1;
+	} else {
+		fillIdx = ft.color ? ft.color : 12;
+		outIdx = ft.color ? -2 : 1;
+	}
+	fillIdx ^= ft.xorMask;
+	if (outIdx >= 0)
+		outIdx ^= ft.xorMask;
+	byte fr = _curPal[fillIdx * 3], fg = _curPal[fillIdx * 3 + 1], fb = _curPal[fillIdx * 3 + 2];
+	byte orr = 0, og = 0, ob = 0;
+	bool outline = f.outline > 0 && outIdx != -1;
+	if (ft.font == 2) {
+		// light text with a black outline
+		fr = 246; fg = 238; fb = 222;
+		orr = og = ob = 0;
+	} else if (outIdx >= 0) {
+		orr = _curPal[outIdx * 3]; og = _curPal[outIdx * 3 + 1]; ob = _curPal[outIdx * 3 + 2];
+	} else if (outIdx == -2) {
+		orr = fr / 4; og = fg / 4; ob = fb / 4;
+	}
+
+	// labels, menus and subtitles: capitals, like the original Cyrillic-style font
+	Common::String text = ft.text;
+	if (ft.font == 1 || ft.font == 2)
+		for (uint i = 0; i < text.size(); i++)
+			if ((byte)text[i] < 128)
+				text.setChar(toupper((byte)text[i]), i);
+
+	// layout: the line keeps its original box; the new text is centred in it
+	const int k3num = S, k3den = 3;		// atlas is at 3x
+	int textW = 0;
+	for (uint i = 0; i < text.size(); i++)
+		textW += f.g[(byte)text[i]].adv;
+	int boxW = ft.w * S, boxH = ft.h * S;
+	int scaledW = textW * k3num / k3den;
+	// 16.16 horizontal factor (condense lines that would not fit)
+	int64 kx = 65536 * k3num / k3den;
+	if (scaledW > boxW * 11 / 10 && scaledW > 0) {
+		kx = kx * (boxW * 11 / 10) / scaledW;
+		kx = MAX<int64>(kx, 65536 * k3num * 7 / (k3den * 10));
+		scaledW = (int)(textW * kx / 65536);
+	}
+	int64 ky = 65536 * k3num / k3den;
+	int originX = (ft.x - scrollX) * S + (ft.left ? 0 : (boxW - scaledW) / 2);
+	int originY = (ft.y - scrollY) * S + (boxH - (int)(f.line * ky / 65536)) / 2;
+
+	Common::Rect clip((ft.clip.left - scrollX) * S, (ft.clip.top - scrollY) * S, (ft.clip.right - scrollX) * S, (ft.clip.bottom - scrollY) * S);
+	clip.clip(area);
+	clip.clip(Common::Rect(_screen.w, _screen.h));
+	if (clip.isEmpty())
+		return;
+
+	int pen = 0;	// in atlas units
+	for (uint i = 0; i < text.size(); i++) {
+		const HDFont::Glyph &g = f.g[(byte)text[i]];
+		if (g.w && g.h) {
+			int gx0 = originX + (int)((pen + g.bx) * kx / 65536);
+			int gy0 = originY + (int)(g.by * ky / 65536);
+			int gw = (int)(g.w * kx / 65536) + 1, gh = (int)(g.h * ky / 65536) + 1;
+			Common::Rect gr(gx0, gy0, gx0 + gw, gy0 + gh);
+			gr.clip(clip);
+			for (int y = gr.top; y < gr.bottom; y++) {
+				// atlas coordinate (16.16) of the pixel centre
+				int64 ay = ((int64)(y - gy0) * 65536 + 32768) * 65536 / ky - 32768;
+				int ay0 = (int)(ay >> 16), wy = (int)(ay & 0xffff) >> 8;
+				if (ay < 0) { ay0 = -1; wy = (int)((ay + 65536) >> 8); }
+				PixelT *d = (PixelT *)_screen.getBasePtr(gr.left, y);
+				for (int x = gr.left; x < gr.right; x++, d++) {
+					int64 ax = ((int64)(x - gx0) * 65536 + 32768) * 65536 / kx - 32768;
+					int ax0 = (int)(ax >> 16), wx = (int)(ax & 0xffff) >> 8;
+					if (ax < 0) { ax0 = -1; wx = (int)((ax + 65536) >> 8); }
+					int cov[2] = { 0, 0 };
+					for (int c = 0; c < 2; c++) {
+#define AT(xx, yy) (((xx) >= 0 && (yy) >= 0 && (xx) < g.w && (yy) < g.h) ? f.atlas[((g.ay + (yy)) * f.aw + g.ax + (xx)) * 2 + c] : 0)
+						int v = (AT(ax0, ay0) * (256 - wx) + AT(ax0 + 1, ay0) * wx) * (256 - wy) +
+								(AT(ax0, ay0 + 1) * (256 - wx) + AT(ax0 + 1, ay0 + 1) * wx) * wy;
+#undef AT
+						cov[c] = v >> 16;
+					}
+					if (outline)
+						blendPixel<PixelT>(d, orr, og, ob, cov[1], _format);
+					blendPixel<PixelT>(d, fr, fg, fb, cov[0], _format);
+				}
+			}
+		}
+		pen += g.adv;
+	}
+}
+
+// The remastered balloons: oval and tail with an anti-aliased outline, over the upscaled 8-bit balloon (same shape),
+// in the parts of the frame composed again (areas, HD pixels); the texts go over them afterwards
+void HDRenderer::drawBalloons(const Common::Array<Common::Rect> &areas, int scrollX, int scrollY) {
+	const int S = _scale;
+	for (uint i = 0; i < _balloons.size(); i++) {
+		const BalloonDraw &bd = _balloons[i];
+		const HDBalloonShape &sh = bd.shape;
+		byte fr, fg, fb, lr, lg, lb;
+		fr = _curPal[sh.fill * 3]; fg = _curPal[sh.fill * 3 + 1]; fb = _curPal[sh.fill * 3 + 2];
+		lr = _curPal[sh.line * 3]; lg = _curPal[sh.line * 3 + 1]; lb = _curPal[sh.line * 3 + 2];
+		// bounds of the shape in window pixels at 1x
+		float l = MIN(sh.cx - sh.a, sh.tail ? sh.tipX : sh.cx) - 2, r = MAX(sh.cx + sh.a, sh.tail ? sh.tipX : sh.cx) + 2;
+		float t = MIN(sh.cy - sh.b, sh.tail ? sh.tipY : sh.cy) - 2, b = MAX(sh.cy + sh.b, sh.tail ? sh.tipY : sh.cy) + 2;
+		Common::Rect box(((int)floorf(l) + bd.x - scrollX) * S, ((int)floorf(t) + bd.y - scrollY) * S,
+			((int)ceilf(r) + bd.x - scrollX) * S, ((int)ceilf(b) + bd.y - scrollY) * S);
+		for (uint j = 0; j < areas.size(); j++) {
+			Common::Rect hd = areas[j];	// HD pixels, like the texts' areas
+			hd.clip(box);
+			hd.clip(Common::Rect(_screen.w, _screen.h));
+			if (hd.isEmpty())
+				continue;
+			for (int y = hd.top; y < hd.bottom; y++) {
+				float fy = (y + 0.5f) / S + scrollY - bd.y;
+				for (int x = hd.left; x < hd.right; x++) {
+					float fx = (x + 0.5f) / S + scrollX - bd.x;
+					float d = hdBalloonDistance(sh, fx, fy) * S;	// HD pixels
+					float outer = CLIP(0.5f - d, 0.0f, 1.0f);
+					if (outer <= 0)
+						continue;
+					float inner = CLIP(0.5f - (d + sh.lineWidth * S), 0.0f, 1.0f);
+					byte r0, g0, b0;
+					uint32 c = _format.bytesPerPixel == 4 ? *(uint32 *)_screen.getBasePtr(x, y) : *(uint16 *)_screen.getBasePtr(x, y);
+					_format.colorToRGB(c, r0, g0, b0);
+					float cr = r0 + (lr - r0) * outer, cg = g0 + (lg - g0) * outer, cb = b0 + (lb - b0) * outer;
+					cr += (fr - cr) * inner; cg += (fg - cg) * inner; cb += (fb - cb) * inner;
+					c = _format.RGBToColor((byte)(cr + 0.5f), (byte)(cg + 0.5f), (byte)(cb + 0.5f));
+					if (_format.bytesPerPixel == 4)
+						*(uint32 *)_screen.getBasePtr(x, y) = c;
+					else
+						*(uint16 *)_screen.getBasePtr(x, y) = (uint16)c;
+				}
+			}
+		}
+	}
+}
+
+void HDRenderer::drawTexts(const Common::Array<Common::Rect> &areas, int scrollX, int scrollY) {
+	// subtitles: a translucent dark band behind them, readable over any picture
+	for (uint i = 0; i < _frameText.size(); i++) {
+		const FrameText &ft = _frameText[i];
+		if (!ft.band || ft.text.empty())
+			continue;
+		// as wide as the text actually drawn (see drawFrameText), centred in the original box
+		int tw = ft.w * _scale;
+		const HDFont &hf = _fonts[ft.font];
+		if (hf.ok) {
+			int adv = 0;
+			for (uint c = 0; c < ft.text.size(); c++) {
+				byte ch = (byte)ft.text[c];
+				if (ft.font != 0 && ch < 128)
+					ch = toupper(ch);
+				adv += hf.g[ch].adv;
+			}
+			tw = MIN(adv * _scale / 3, ft.w * _scale * 11 / 10);
+		}
+		int cx = (ft.x - scrollX) * _scale + ft.w * _scale / 2;
+		int pad = 12 * _scale / 3 * 3;
+		Common::Rect b(cx - tw / 2 - pad, (ft.y - scrollY - 2) * _scale,
+			cx + tw / 2 + pad, (ft.y - scrollY + ft.h + 3) * _scale);
+		for (uint j = 0; j < areas.size(); j++) {
+			Common::Rect r(b);
+			r.clip(areas[j]);
+			r.clip(Common::Rect(_screen.w, _screen.h));
+			for (int y = r.top; y < r.bottom; y++) {
+				for (int x = r.left; x < r.right; x++) {
+					uint32 c = _format.bytesPerPixel == 4 ? *(uint32 *)_screen.getBasePtr(x, y) : *(uint16 *)_screen.getBasePtr(x, y);
+					byte cr, cg, cb;
+					_format.colorToRGB(c, cr, cg, cb);
+					c = _format.RGBToColor(cr * 2 / 5, cg * 2 / 5, cb * 2 / 5);
+					if (_format.bytesPerPixel == 4)
+						*(uint32 *)_screen.getBasePtr(x, y) = c;
+					else
+						*(uint16 *)_screen.getBasePtr(x, y) = (uint16)c;
+				}
+			}
+		}
+	}
+	for (uint i = 0; i < _frameText.size(); i++) {
+		for (uint j = 0; j < areas.size(); j++) {
+			if (_format.bytesPerPixel == 4)
+				drawFrameText<uint32>(_frameText[i], areas[j], scrollX, scrollY);
+			else
+				drawFrameText<uint16>(_frameText[i], areas[j], scrollX, scrollY);
+		}
+	}
+}
+
+void HDRenderer::beginScene(int bbW, int bbH) {
+	_frameNo++;
+	_frameText.clear();
+	_balloons.clear();
+	_slots.resize(1);
+	_slotOfKey.clear();
+
+	// 16:9 with a widened background: two strips of M columns beside the back buffer, where
+	// Gfx::drawGfxObject draws again the part of a sprite that leaves the back buffer (it was cut at
+	// the edge of the original 640 pixels). They start as the background the composer expects there
+	// (the edge column of the original, see _origBgWide): a pixel left like that shows the HD band
+	const int M = _wideM;
+	_sidesOn = M && _hdBgWide.getPixels() && _origBgWide.getPixels() && !_classic;
+	if (_sidesOn) {
+		for (int s = 0; s < 2; s++) {
+			if (_side[s].w != M || _side[s].h != bbH) {
+				_side[s].free();
+				_side[s].create(M, bbH, Graphics::PixelFormat::createFormatCLUT8());
+			}
+			_sideIds[s].resize(M * bbH * 2);
+			memset(&_sideIds[s][0], 0, M * bbH * 2 * sizeof(uint32));
+			for (int y = 0; y < bbH; y++) {
+				byte *d = (byte *)_side[s].getBasePtr(0, y);
+				int oy = y - _bgY;
+				for (int i = 0; i < M; i++) {
+					int ox = (s ? bbW + i : i - M) - _bgX + M;	// in _origBgWide
+					d[i] = (oy >= 0 && oy < _origBgWide.h) ? *(const byte *)_origBgWide.getBasePtr(CLIP(ox, 0, _origBgWide.w - 1), oy) : 0;
+				}
+			}
+		}
+		_sideW = bbW;
+	}
+	if (!_sprEnabled)
+		return;
+	if (_idW != bbW || _idH != bbH) {
+		delete[] _ids;
+		_ids = new uint32[bbW * bbH * 2];
+		_idW = bbW;
+		_idH = bbH;
+	}
+	memset(_ids, 0, bbW * bbH * 2 * sizeof(uint32));
+
+	// keep the cache within budget: drop what was not used recently
+	if (_sprCacheBytes > 96 * 1024 * 1024) {
+		Common::Array<uint32> drop;
+		for (Common::HashMap<uint32, HDSprite *>::iterator it = _sprCache.begin(); it != _sprCache.end(); ++it) {
+			if (it->_value && it->_value->lastUsed + 2 < _frameNo)
+				drop.push_back(it->_key);
+		}
+		for (uint i = 0; i < drop.size(); i++) {
+			HDSprite *spr = _sprCache[drop[i]];
+			_sprCacheBytes -= spr->w * spr->h * _scale * _scale * 4;
+			delete[] spr->px;
+			delete spr;
+			_sprCache.erase(drop[i]);
+		}
+	}
+}
+
+void HDRenderer::clearIds(int x, int y, int w, int h) {
+	if (!_ids)
+		return;
+	Common::Rect r(x, y, x + w, y + h);
+	r.clip(Common::Rect(_idW, _idH));
+	if (r.isEmpty())
+		return;
+	for (int yy = r.top; yy < r.bottom; yy++) {
+		memset(_ids + yy * _idW + r.left, 0, r.width() * sizeof(uint32));
+		memset(_ids + _idW * _idH + yy * _idW + r.left, 0, r.width() * sizeof(uint32));
+	}
+}
+
+uint32 HDRenderer::spriteSlot(const byte *pixels, int w, int h, byte transparentKey, int scale, int ox, int oy) {
+	if (dumping())
+		dumpFrame(pixels, w, h, transparentKey);
+	if (!_sprEnabled || !_ids || w >= 1024 || h >= 1024 || w <= 0 || h <= 0)
+		return 0;
+
+	uint32 key = frameKey(pixels, w, h);
+	Common::HashMap<uint32, uint32>::iterator is = _slotOfKey.find(key);
+	if (scale == 100 && is != _slotOfKey.end())
+		return is->_value;
+
+	uint32 slot = 0;
+	Common::HashMap<uint32, SpriteEntry>::iterator ie = _sprIndex.find(key);
+	if (ie != _sprIndex.end() && ie->_value.w == w && ie->_value.h == h && _slots.size() < 4095) {
+		HDSprite *spr = nullptr;
+		// timed HD frames: the image of this moment, cached under a key of its own
+		const SpriteEntry &se = ie->_value;
+		int sub = -1;
+		uint32 ck = key;
+		if (se.animFrames > 1) {
+			sub = (int)((g_system->getMillis() / se.animMs) % se.animFrames);
+			ck = key ^ (0x9e3779b9u * (uint32)(sub + 1));
+			Common::HashMap<uint32, int>::iterator il = _animLastSub.find(key);
+			if (il == _animLastSub.end() || il->_value != sub) {
+				// same 8-bit frame, new picture: its area is composed again (with the margins)
+				int sw = w * scale / 100, sh = h * scale / 100;
+				_animDirty.push_back(Common::Rect(ox - se.ml - 1, oy - 1, ox + sw + se.mr + 1, oy + sh + 1));
+				_animLastSub[key] = sub;
+			}
+		}
+		Common::HashMap<uint32, HDSprite *>::iterator ic = _sprCache.find(ck);
+		if (ic != _sprCache.end()) {
+			spr = ic->_value;
+		} else {
+			spr = sub >= 0 ? loadSprite(key, se, pixels, transparentKey, sub) : nullptr;
+			if (!spr)
+				spr = loadSprite(key, se, pixels, transparentKey);
+			_sprCache[ck] = spr;	// failures are cached too
+			if (spr) {
+				for (int i = 0; i < w * h; i++)
+					if (pixels[i] != transparentKey)
+						spr->used[pixels[i] >> 5] |= 1u << (pixels[i] & 31);
+			}
+		}
+		if (spr) {
+			spr->lastUsed = _frameNo;
+			Slot sl;
+			sl.spr = spr;
+			sl.key = key;
+			sl.scale = scale;
+			sl.ox = ox;
+			sl.oy = oy;
+			computeModes(&_sprPalettes[spr->pal * 768], sl.mode, sl.factor);
+			// colors that can't be mapped (palette changed): keep the whole frame original
+			bool ok = true;
+			for (int i = 0; i < 256 && ok; i++)
+				if ((spr->used[i >> 5] & (1u << (i & 31))) && sl.mode[i] == kLowRes)
+					ok = false;
+			if (!ok && _glassKeys.contains(key)) {
+				// a window ("vetro"): its cycling glass colours are covered by the landscape, the rest
+				// of the picture (curtains, lamp) stays HD
+				for (int i = 0; i < 256; i++)
+					if (sl.mode[i] == kLowRes)
+						sl.mode[i] = kHDSame;
+				ok = true;
+			}
+			if (ok) {
+				_slots.push_back(sl);
+				slot = _slots.size() - 1;
+			}
+		}
+	}
+	if (scale == 100)
+		_slotOfKey[key] = slot;
+	return slot;
+}
+
+void HDRenderer::dumpFrame(const byte *pixels, int w, int h, byte transparentKey) {
+	if (w <= 0 || h <= 0 || w >= 1024 || h >= 1024)
+		return;
+	uint32 key = frameKey(pixels, w, h);
+	if (_dumped.contains(key))
+		return;
+	_dumped[key] = true;
+	Common::String base = _dumpDir + "/" + Common::String::format("%08x", key);
+	Common::FSNode node{Common::Path(base + ".raw", '/')};
+	if (node.exists())
+		return;
+
+	Graphics::Surface surf;
+	surf.create(w, h, Graphics::PixelFormat(4, 8, 8, 8, 8, 24, 16, 8, 0));
+	for (int y = 0; y < h; y++) {
+		for (int x = 0; x < w; x++) {
+			byte c = pixels[y * w + x];
+			uint32 v = (c == transparentKey) ? 0 :
+				surf.format.ARGBToColor(255, _bgPal[c * 3], _bgPal[c * 3 + 1], _bgPal[c * 3 + 2]);
+			*(uint32 *)surf.getBasePtr(x, y) = v;
+		}
+	}
+	Common::DumpFile out;
+	if (out.open(Common::Path(base + ".png", '/'), true))
+		Image::writePNG(out, surf);
+	out.close();
+	surf.free();
+	// raw frame + reference palette, for the pack builder
+	if (out.open(Common::Path(base + ".raw", '/'), true)) {
+		out.writeUint16LE(w);
+		out.writeUint16LE(h);
+		out.writeByte(transparentKey);
+		out.write(_bgPal, 768);
+		out.write(pixels, w * h);
+	}
+	out.close();
+}
+
+// band of the 16:9 pictures (name_w.jpg), in original pixels on each side
+static const int kWideFileMargin = 36;
+
+bool HDRenderer::loadHDBackground(const Common::String &name, int w, int h) {
+	_hdBg.free();
+	if (name.empty())
+		return false;
+
+	Common::FSNode gameDir(ConfMan.getPath("path"));
+	Common::FSNode hdDir = gameDir.getChild("hd");
+	if (!hdDir.exists() || !hdDir.isDirectory())
+		return false;
+
+	Common::FSDirectory dir(hdDir, 4);
+	// PNG (lossless) or JPEG (much smaller packs)
+	Image::PNGDecoder png;
+	Image::JPEGDecoder jpeg;
+	jpeg.setOutputPixelFormat(Graphics::PixelFormat(4, 8, 8, 8, 8, 24, 16, 8, 0));
+	Image::ImageDecoder *decoder = nullptr;
+	Common::SeekableReadStream *stream = dir.createReadStreamForMember(Common::Path(name + ".png", '/'));
+	if (stream) {
+		decoder = &png;
+	} else {
+		stream = dir.createReadStreamForMember(Common::Path(name + ".jpg", '/'));
+		if (stream)
+			decoder = &jpeg;
+	}
+	// no picture for 4:3: the centre of the 16:9 one (name_w.jpg, tools/hd/widen.py: 36 original pixels
+	// of band on each side), so a pack can leave the 4:3 file out
+	bool fromWide = false;
+	if (!stream) {
+		stream = dir.createReadStreamForMember(Common::Path(name + "_w.jpg", '/'));
+		if (stream) {
+			decoder = &jpeg;
+			fromWide = true;
+		}
+	}
+	if (!stream)
+		return false;
+
+	bool ok = decoder->loadStream(*stream);
+	delete stream;
+	if (!ok)
+		return false;
+
+	const Graphics::Surface *src = decoder->getSurface();
+	Graphics::Surface centre;
+	if (fromWide) {
+		const int k = h > 0 ? src->h / h : 0;
+		if (k <= 0 || src->h != h * k || src->w != (w + 2 * kWideFileMargin) * k) {
+			warning("HD wide background %s_w has an unexpected size %dx%d (original %dx%d)", name.c_str(), src->w, src->h, w, h);
+			return false;
+		}
+		centre = src->getSubArea(Common::Rect(kWideFileMargin * k, 0, (kWideFileMargin + w) * k, h * k));
+		src = &centre;
+	}
+	if (src->w < w || src->h < h || (src->w % w) != 0 || (src->h % h) != 0 || (src->w / w) != (src->h / h)) {
+		warning("HD background %s has an unexpected size %dx%d (original %dx%d)", name.c_str(), src->w, src->h, w, h);
+		return false;
+	}
+	Graphics::Surface *rgb = src->convertTo(Graphics::PixelFormat(4, 8, 8, 8, 8, 24, 16, 8, 0), decoder->getPalette().data(), decoder->getPalette().size());
+
+	// area-average resample from k x to _scale x
+	int srcScale = src->w / w;
+	int dw = w * _scale, dh = h * _scale;
+	_hdBg.create(dw, dh, _format);
+
+	if (srcScale == _scale && rgb->format == _format) {
+		for (int y = 0; y < dh; y++)
+			memcpy(_hdBg.getBasePtr(0, y), rgb->getBasePtr(0, y), dw * 4);
+	} else if (srcScale == _scale) {
+		for (int y = 0; y < dh; y++) {
+			const uint32 *s = (const uint32 *)rgb->getBasePtr(0, y);
+			for (int x = 0; x < dw; x++) {
+				byte a, r, g, b;
+				rgb->format.colorToARGB(s[x], a, r, g, b);
+				uint32 c = _format.RGBToColor(r, g, b);
+				if (_format.bytesPerPixel == 4)
+					*(uint32 *)_hdBg.getBasePtr(x, y) = c;
+				else
+					*(uint16 *)_hdBg.getBasePtr(x, y) = c;
+			}
+		}
+	} else {
+		// generic box filter: each destination pixel covers srcScale/_scale source pixels
+		// computed in units of 1/_scale source pixels to stay integer
+		for (int y = 0; y < dh; y++) {
+			int sy0 = y * srcScale, sy1 = (y + 1) * srcScale;	// in 1/_scale units
+			for (int x = 0; x < dw; x++) {
+				int sx0 = x * srcScale, sx1 = (x + 1) * srcScale;
+				uint32 ar = 0, ag = 0, ab = 0, aw = 0;
+				for (int yy = sy0 / _scale; yy * _scale < sy1; yy++) {
+					int wy = MIN(sy1, (yy + 1) * _scale) - MAX(sy0, yy * _scale);
+					const uint32 *s = (const uint32 *)rgb->getBasePtr(0, yy);
+					for (int xx = sx0 / _scale; xx * _scale < sx1; xx++) {
+						int wx = MIN(sx1, (xx + 1) * _scale) - MAX(sx0, xx * _scale);
+						byte a, r, g, b;
+						rgb->format.colorToARGB(s[xx], a, r, g, b);
+						uint32 wgt = wx * wy;
+						ar += r * wgt; ag += g * wgt; ab += b * wgt; aw += wgt;
+					}
+				}
+				uint32 c = _format.RGBToColor(ar / aw, ag / aw, ab / aw);
+				if (_format.bytesPerPixel == 4)
+					*(uint32 *)_hdBg.getBasePtr(x, y) = c;
+				else
+					*(uint16 *)_hdBg.getBasePtr(x, y) = c;
+			}
+		}
+	}
+
+	rgb->free();
+	delete rgb;
+	debug(1, "HD background loaded: %s (%dx -> %dx)%s", name.c_str(), srcScale, _scale, fromWide ? " from the 16:9 picture" : "");
+	return true;
+}
+
+// mirrors a picture horizontally, in place
+static void mirrorSurface(Graphics::Surface &s) {
+	if (!s.getPixels())
+		return;
+	const int bpp = s.format.bytesPerPixel;
+	byte tmp[4];
+	for (int y = 0; y < s.h; y++) {
+		byte *row = (byte *)s.getBasePtr(0, y);
+		for (int a = 0, b = s.w - 1; a < b; a++, b--) {
+			memcpy(tmp, row + a * bpp, bpp);
+			memcpy(row + a * bpp, row + b * bpp, bpp);
+			memcpy(row + b * bpp, tmp, bpp);
+		}
+	}
+}
+
+void HDRenderer::setBackground(const Common::String &name, const Graphics::Surface &bg, const byte *rgb8, int bgX, int bgY, bool flip) {
+	_origBg.free();
+	_bgX = bgX;
+	_bgY = bgY;
+
+	memcpy(_bgPal, rgb8, 768);
+	_paletteDirty = true;
+
+	_fullRedraw = true;
+	_hdBgWide.free();
+	_sidesOn = false;	// until the next beginScene
+	// a mirrored room (LOCATION ... FLIP) mirrors the HD picture and its 16:9 version (bands
+	// included); the cache keeps it apart from the same picture shown the normal way
+	const Common::String cacheKey = flip ? name + "#flip" : name;
+	if (bg.getPixels() && restoreCachedBg(cacheKey, bg.w * _scale, bg.h * _scale)) {
+		_origBg.copyFrom(bg);
+	} else if (bg.getPixels() && loadHDBackground(name, bg.w, bg.h)) {
+		_origBg.copyFrom(bg);
+		if (_wideM)
+			loadWideBackground(name + "_w", bg.w, bg.h);
+		if (flip) {
+			mirrorSurface(_hdBg);
+			mirrorSurface(_hdBgWide);
+		}
+		storeCachedBg(cacheKey);
+	} else {
+		_hdBg.free();
+	}
+	loadEffects(name, bg.w, bg.h);
+	if (flip) {
+		mirrorSurface(_waterMask);
+		mirrorSurface(_waterMaskWide);
+	}
+	// 16:9: the original background extended by its edge columns, the 8-bit reference of the
+	// widened HD picture for the sprites drawn in the bands (see beginScene)
+	_origBgWide.free();
+	if (_wideM && _hdBgWide.getPixels() && _origBg.getPixels()) {
+		int M = _wideM, W2 = _origBg.w + 2 * M;
+		_origBgWide.create(W2, _origBg.h, Graphics::PixelFormat::createFormatCLUT8());
+		for (int y = 0; y < _origBg.h; y++) {
+			const byte *src = (const byte *)_origBg.getBasePtr(0, y);
+			byte *dst = (byte *)_origBgWide.getBasePtr(0, y);
+			for (int x = 0; x < W2; x++)
+				dst[x] = src[CLIP(x - M, 0, _origBg.w - 1)];
+		}
+	}
+}
+
+bool HDRenderer::restoreCachedBg(const Common::String &name, int w, int h) {
+	for (int i = 0; i < ARRAYSIZE(_bgCache); i++) {
+		CachedBg &c = _bgCache[i];
+		if (c.name.empty() || c.name != name || c.bg.format != _format || !c.bg.getPixels() || c.bg.w != w || c.bg.h != h)
+			continue;
+		_hdBg.copyFrom(c.bg);
+		if (c.wide.getPixels() && _wideM)
+			_hdBgWide.copyFrom(c.wide);
+		debug(1, "HD background from cache: %s", name.c_str());
+		return true;
+	}
+	return false;
+}
+
+void HDRenderer::storeCachedBg(const Common::String &name) {
+	// keep the most recent two: drop the older entry
+	CachedBg &old = _bgCache[1];
+	old.bg.free();
+	old.wide.free();
+	old.name.clear();
+	SWAP(_bgCache[0], _bgCache[1]);
+	CachedBg &c = _bgCache[0];
+	c.name = name;
+	c.bg.copyFrom(_hdBg);
+	if (_hdBgWide.getPixels())
+		c.wide.copyFrom(_hdBgWide);
+}
+
+// ---------------------------------------------------------------------------
+// Room effects from the patch
+// ---------------------------------------------------------------------------
+
+void HDRenderer::freePano() {
+	for (uint i = 0; i < _pano.size(); i++) {
+		if (_pano[i].mask) {
+			_pano[i].mask->free();
+			delete _pano[i].mask;
+		}
+		if (_pano[i].maskWide) {
+			_pano[i].maskWide->free();
+			delete _pano[i].maskWide;
+		}
+	}
+	_pano.clear();
+}
+
+void HDRenderer::loadEffects(const Common::String &name, int w, int h) {
+	memset(_frozen, 0, sizeof(_frozen));
+	freePano();
+	_glassKeys.clear();
+	_panoStep = -1;
+	_waterMask.free();
+	_waterMaskWide.free();
+	_waterAmp = 0;
+	_waterStep = -1;
+	if (name.empty())
+		return;
+	Common::FSNode hdDir = Common::FSNode(ConfMan.getPath("path")).getChild("hd");
+	if (!hdDir.exists() || !hdDir.isDirectory())
+		return;
+	Common::FSDirectory dir(hdDir, 4);
+	Common::SeekableReadStream *f = dir.createReadStreamForMember(Common::Path(name + "_effetti.txt", '/'));
+	if (!f)
+		return;
+	bool water = false;
+	while (!f->eos() && !f->err()) {
+		Common::String line = f->readLine();
+		int hash = line.findFirstOf('#');
+		if (hash >= 0)
+			line = line.substr(0, hash);
+		line.trim();
+		if (line.empty())
+			continue;
+		Common::StringTokenizer tok(line, " \t");
+		Common::String cmd = tok.nextToken();
+		if (cmd == "fermi") {	// fermi 224-255 240 ...
+			while (!tok.empty()) {
+				Common::String r = tok.nextToken();
+				int dash = r.findFirstOf('-');
+				int a = atoi(r.c_str()), b = dash > 0 ? atoi(r.c_str() + dash + 1) : a;
+				for (int i = MAX(0, a); i <= MIN(255, b); i++)
+					_frozen[i] = true;
+			}
+		} else if (cmd == "vetro") {	// vetro 5b514328 ...: keys of sprite frames with a window (hd/spr/index.dat)
+			while (!tok.empty())
+				_glassKeys[(uint32)strtoul(tok.nextToken().c_str(), nullptr, 16)] = true;
+		} else if (cmd == "paesaggio" || cmd == "suolo") {
+			// paesaggio [maschera <file>] <strip.png> <speed> [<strip.png> <speed> ...]
+			// suolo [maschera <file>] <texture.png> <speed> <x0> <y0> <spread> <depth>
+			int slash = name.findLastOf('/');
+			Common::String folder = slash >= 0 ? name.substr(0, slash + 1) : Common::String();
+			PanoGroup g;
+			g.ground = cmd == "suolo";
+			g.maskFile = name + "_finestre.png";
+			Common::String t = tok.nextToken();
+			if (t == "maschera") {
+				g.maskFile = folder + tok.nextToken();
+				t = tok.nextToken();
+			}
+			while (!t.empty()) {
+				Common::String file = t;
+				float speed = (float)atof(tok.nextToken().c_str());
+				Common::SeekableReadStream *ps = dir.createReadStreamForMember(Common::Path(folder + file, '/'));
+				Image::PNGDecoder pd;
+				if (!ps || !pd.loadStream(*ps)) {
+					delete ps;
+					warning("%s_effetti.txt: landscape strip %s not found", name.c_str(), file.c_str());
+					break;
+				}
+				delete ps;
+				Graphics::Surface *ls = pd.getSurface()->convertTo(Graphics::PixelFormat(4, 8, 8, 8, 8, 24, 16, 8, 0), pd.getPalette().data(), pd.getPalette().size());
+				// strips: to the HD scale in use (nearest sample of the strip's own scale); a ground texture as it is
+				int k = g.ground ? 1 : ls->h / h, S = g.ground ? 1 : _scale;
+				if (!g.ground && ls->h % h) {
+					warning("%s: strip %s is %d pixels tall, not a multiple of %d", name.c_str(), file.c_str(), ls->h, h);
+				} else {
+					PanoLayer L;
+					L.w = ls->w * S / k;
+					L.h = g.ground ? ls->h : h * S;
+					L.speed = speed;
+					L.px.resize(L.w * L.h);
+					uint64 sr = 0, sg = 0, sb = 0;
+					for (int y = 0; y < L.h; y++) {
+						const uint32 *sp = (const uint32 *)ls->getBasePtr(0, y * k / S);
+						for (int x = 0; x < L.w; x++) {
+							byte a, r, gg, bb;
+							ls->format.colorToARGB(sp[x * k / S], a, r, gg, bb);
+							L.px[y * L.w + x] = ((uint32)a << 24) | (r << 16) | (gg << 8) | bb;
+							sr += r; sg += gg; sb += bb;
+						}
+					}
+					uint64 n = MAX<uint64>(1, (uint64)L.w * L.h);
+					L.avg = 0xff000000 | (uint32)(sr / n) << 16 | (uint32)(sg / n) << 8 | (uint32)(sb / n);
+					if (L.w > 0)
+						g.layers.push_back(L);
+				}
+				ls->free();
+				delete ls;
+				if (g.ground) {
+					g.x0 = (float)atof(tok.nextToken().c_str());
+					g.y0 = (float)atof(tok.nextToken().c_str());
+					g.spread = MAX(0.01f, (float)atof(tok.nextToken().c_str()));
+					g.depth = (float)atof(tok.nextToken().c_str());
+					break;
+				}
+				t = tok.nextToken();
+			}
+			if (!g.layers.empty())
+				_pano.push_back(g);
+		} else if (cmd == "acqua") {	// acqua <amplitude> <wavelength> <speed>: HD pixels of the scale in use, turns per second
+			_waterAmp = (float)atof(tok.nextToken().c_str());
+			_waterLen = MAX(4.0f, (float)atof(tok.nextToken().c_str()));
+			_waterSpeed = (float)atof(tok.nextToken().c_str());
+			water = _waterAmp > 0;
+		} else {
+			warning("%s_effetti.txt: unknown line '%s'", name.c_str(), line.c_str());
+		}
+	}
+	delete f;
+	_paletteDirty = true;
+	for (uint gi = 0; gi < _pano.size(); gi++) {
+		PanoGroup &g = _pano[gi];
+		Common::SeekableReadStream *pm = dir.createReadStreamForMember(Common::Path(g.maskFile, '/'));
+		Image::PNGDecoder mp;
+		if (!pm || !mp.loadStream(*pm)) {
+			warning("%s: landscape without a mask (%s)", name.c_str(), g.maskFile.c_str());
+			delete pm;
+			continue;
+		}
+		delete pm;
+		Graphics::Surface *rgb = mp.getSurface()->convertTo(Graphics::PixelFormat(4, 8, 8, 8, 8, 24, 16, 8, 0), mp.getPalette().data(), mp.getPalette().size());
+		int ww = w + 2 * _wideM;
+		bool wide = _wideM && rgb->w % ww == 0 && rgb->h % h == 0 && rgb->w / ww == rgb->h / h;
+		int gw = wide ? ww : w;
+		if (rgb->w % gw || rgb->h % h || rgb->w / gw != rgb->h / h) {
+			warning("%s has an unexpected size %dx%d", g.maskFile.c_str(), rgb->w, rgb->h);
+		} else {
+			int k = rgb->w / gw, S = _scale;
+			Graphics::Surface *dst = new Graphics::Surface();
+			dst->create(gw * S, h * S, Graphics::PixelFormat::createFormatCLUT8());
+			for (int y = 0; y < dst->h; y++) {
+				byte *d = (byte *)dst->getBasePtr(0, y);
+				const uint32 *sp = (const uint32 *)rgb->getBasePtr(0, y * k / S);
+				for (int x = 0; x < dst->w; x++) {
+					byte a, r, gg, bb;
+					rgb->format.colorToARGB(sp[x * k / S], a, r, gg, bb);
+					d[x] = a > 127 ? (byte)((r + gg + bb) / 3) : 0;	// grey: soft edge of the glass
+				}
+			}
+			if (wide) {
+				g.maskWide = dst;
+				g.mask = new Graphics::Surface();
+				g.mask->create(w * S, h * S, Graphics::PixelFormat::createFormatCLUT8());
+				for (int y = 0; y < h * S; y++)
+					memcpy(g.mask->getBasePtr(0, y), dst->getBasePtr(_wideM * S, y), w * S);
+			} else {
+				g.mask = dst;
+			}
+		}
+		rgb->free();
+		delete rgb;
+	}
+	if (!water)
+		return;
+	Common::SeekableReadStream *m = dir.createReadStreamForMember(Common::Path(name + "_acqua.png", '/'));
+	Image::PNGDecoder png;
+	if (!m || !png.loadStream(*m)) {
+		delete m;
+		warning("%s: water without a mask (%s_acqua.png)", name.c_str(), name.c_str());
+		return;
+	}
+	delete m;
+	const Graphics::Surface *src = png.getSurface();
+	Graphics::Surface *rgb = src->convertTo(Graphics::PixelFormat(4, 8, 8, 8, 8, 24, 16, 8, 0), png.getPalette().data(), png.getPalette().size());
+	// the mask may be drawn for the normal or for the widened background, at any whole scale
+	int ww = w + 2 * _wideM;
+	bool wide = _wideM && rgb->w % ww == 0 && rgb->h % h == 0 && rgb->w / ww == rgb->h / h;
+	int gw = wide ? ww : w;
+	if (rgb->w % gw || rgb->h % h || rgb->w / gw != rgb->h / h) {
+		warning("%s_acqua.png has an unexpected size %dx%d", name.c_str(), rgb->w, rgb->h);
+	} else {
+		int k = rgb->w / gw, S = _scale;
+		Graphics::Surface &dst = wide ? _waterMaskWide : _waterMask;
+		dst.create(gw * S, h * S, Graphics::PixelFormat::createFormatCLUT8());
+		for (int y = 0; y < dst.h; y++) {
+			byte *d = (byte *)dst.getBasePtr(0, y);
+			const uint32 *sp = (const uint32 *)rgb->getBasePtr(0, y * k / S);
+			for (int x = 0; x < dst.w; x++) {
+				byte a, r, g, b;
+				rgb->format.colorToARGB(sp[x * k / S], a, r, g, b);
+				d[x] = (a > 127 && r + g + b > 384) ? 255 : 0;
+			}
+		}
+		if (wide) {	// and its middle for the normal background (classic 4:3 HD)
+			_waterMask.create(w * S, h * S, Graphics::PixelFormat::createFormatCLUT8());
+			for (int y = 0; y < h * S; y++)
+				memcpy(_waterMask.getBasePtr(0, y), _waterMaskWide.getBasePtr(_wideM * S, y), w * S);
+		}
+	}
+	rgb->free();
+	delete rgb;
+}
+
+// Waves on the water of the room (a step every 60 ms): every background pixel of the mask that shows the background
+// (no sprite, the 8-bit pixel is the background's, its palette entry untouched) takes the HD
+// background from a little further, along sines that are longer and stronger towards the bottom
+// (nearer to the viewer). Only water feeds water: the pier's edge never smears into the sea.
+// all: a new wave step (the whole water); otherwise only what was composed again this frame.
+template<typename PixelT>
+static inline void putHD(PixelT *dst, PixelT src, byte mode, uint16 factor, const Graphics::PixelFormat &fmt);
+
+// "paesaggio" (loadEffects): inside the glass of the mask, where the background shows (no sprite in
+// front), the landscape strips loop sideways over the HD background; the glass edge (grey in the mask)
+// blends them with it. Fades and the grey comment view are applied as to the background.
+void HDRenderer::applyPanorama(const PanoGroup &g, const byte *frame, int pitch, int w, int h, const uint32 *ids, int idsPitch,
+		const Graphics::Surface *hd, const Graphics::Surface *ob, int offX, int offY, bool all,
+		Common::Array<Common::Rect> &dirtyRects) {
+	const Graphics::Surface *mp = (hd == &_hdBgWide) ? g.maskWide : g.mask;
+	if (!hd || !hd->getPixels() || !mp || !mp->getPixels() || mp->w != hd->w || mp->h != hd->h || g.layers.empty())
+		return;
+	const Graphics::Surface &mask = *mp;
+	const int S = _scale, MW = mask.w, MH = mask.h;
+	// 16:9 bands painted apart (paintOutside, no sprite in them): the widened mask and picture there
+	const bool bands = hd != &_hdBgWide && g.maskWide && _hdBgWide.getPixels() && g.maskWide->w == _hdBgWide.w;
+	const float t = g_system->getMillis() * 0.001f;
+	Common::Array<int> shift(g.layers.size());
+	for (uint i = 0; i < g.layers.size(); i++) {
+		int W = g.layers[i].w;
+		int o = (int)floorf(fmodf(t * g.layers[i].speed * S, (float)W));
+		shift[i] = ((o % W) + W) % W;
+	}
+	// a fade of the scene (most of the palette fading or gray): the landscape follows it; single entries
+	// that only look faded are the old colour cycling of the windows, and must not draw its shapes
+	byte gMode = kHDSame;
+	uint16 gFactor = 0;
+	{
+		int cnt[6] = { 0 };
+		for (int i = 0; i < 256; i++)
+			if (_mode[i] < 6)
+				cnt[_mode[i]]++;
+		for (byte m : { (byte)kHDFade, (byte)kHDGray, (byte)kHDDarken })
+			if (cnt[m] > 160) {
+				gMode = m;
+				Common::HashMap<uint16, int> f;
+				int best = 0;
+				for (int i = 0; i < 256; i++)
+					if (_mode[i] == m && ++f[_factor[i]] > best) {
+						best = f[_factor[i]];
+						gFactor = _factor[i];
+					}
+			}
+	}
+	Common::Array<Common::Rect> todo;
+	Common::Rect win(0, 0, _screen.w, _screen.h);
+	if (all)
+		todo.push_back(win);
+	else
+		todo = dirtyRects;
+	const int bpp = _format.bytesPerPixel;
+	for (uint ri = 0; ri < todo.size(); ri++) {
+		Common::Rect r = todo[ri];
+		r.clip(win);
+		bool touched = false;
+		for (int sy = r.top; sy < r.bottom; sy++) {
+			int gy = sy / S, by = sy + offY * S;
+			if (by < 0 || by >= MH || gy >= h)
+				continue;
+			const byte *mrow = (const byte *)mask.getBasePtr(0, by);
+			for (int sx = r.left; sx < r.right; sx++) {
+				int gx = sx / S;
+				if (gx >= w)
+					continue;
+				const Graphics::Surface *src = hd;
+				const byte *mr = mrow;
+				int bx = sx + offX * S;
+				byte idx;
+				int ox = gx + offX, oy = gy + offY;
+				if (bands && (gx < _outL || gx >= w - _outR)) {
+					bx = sx + (offX + _wideM) * S;
+					if (bx < 0 || bx >= g.maskWide->w)
+						continue;
+					mr = (const byte *)g.maskWide->getBasePtr(0, by);
+					if (!mr[bx])
+						continue;
+					src = &_hdBgWide;
+					idx = *(const byte *)ob->getBasePtr(CLIP(ox, 0, ob->w - 1), oy);
+					goto paint;
+				}
+				if (bx < 0 || bx >= MW || !mrow[bx])
+					continue;
+				idx = frame[gy * pitch + gx];
+				if (ids && ids[gy * idsPitch + gx] && !_glassKeys.empty()) {
+					uint32 sl = ids[gy * idsPitch + gx] >> 20;
+					if (sl < _slots.size() && _glassKeys.contains(_slots[sl].key))
+						goto paint;	// the glass of a window drawn by a picture of the room (mask = glass)
+				}
+				if (ox < 0 || oy < 0 || ox >= ob->w || oy >= ob->h || *(const byte *)ob->getBasePtr(ox, oy) != idx)
+					continue;	// a sprite drawn into the frame
+				if (ids && ids[gy * idsPitch + gx]) {
+					// an HD sprite, unless its frame shows exactly the background there (animations that
+					// carry a piece of it, as composeFrame): a whole 3x3 block of background pixels
+					bool baked = true;
+					for (int dy = -1; dy <= 1 && baked; dy++)
+						for (int dx = -1; dx <= 1 && baked; dx++) {
+							int yy = gy + dy, xx = gx + dx, byy = oy + dy, bxx = ox + dx;
+							if (yy < 0 || yy >= h || xx < 0 || xx >= w || byy < 0 || byy >= ob->h || bxx < 0 || bxx >= ob->w)
+								continue;
+							baked = frame[yy * pitch + xx] == *(const byte *)ob->getBasePtr(bxx, byy);
+						}
+					if (!baked)
+						continue;
+				}
+			paint:
+				// back to front over the HD background
+				float cr, cg, cb;
+				{
+					uint32 bp = bpp == 4 ? *(const uint32 *)src->getBasePtr(bx, by) : *(const uint16 *)src->getBasePtr(bx, by);
+					byte r8, g8, b8;
+					_format.colorToRGB(bp, r8, g8, b8);
+					cr = r8; cg = g8; cb = b8;
+				}
+				const float m = mr[bx] / 255.0f;
+				float lr = cr, lg = cg, lb = cb;
+				if (g.ground) {
+					// the ground in perspective: across the track u = (x - x0) / (dy * spread) in -1..1 spans the
+					// texture's width, along it the texture repeats every depth / dy, moving away at speed
+					// repeats per second; near the horizon its average colour (no shimmering)
+					const PanoLayer &L = g.layers[0];
+					float gx = (float)bx / S - (src == &_hdBgWide ? _wideM : 0), gyf = (float)by / S;
+					float dy = gyf - g.y0;
+					uint32 c = L.avg;
+					if (dy > 0.5f) {
+						float u = (gx - g.x0) / (dy * g.spread);
+						float v = g.depth / dy + t * L.speed;
+						v -= floorf(v);
+						int tx = CLIP((int)((u * 0.5f + 0.5f) * L.w), 0, L.w - 1);
+						int ty = CLIP((int)(v * L.h), 0, L.h - 1);
+						uint32 s = L.px[ty * L.w + tx];
+						// where one repeat of the texture gets thinner than ~3 game pixels (dy^2 / depth), towards
+						// its average colour: no shimmering of the sleepers near the horizon
+						float fog = CLIP((dy * dy / MAX(g.depth, 0.01f) - 1.0f) / 3.0f, 0.0f, 1.0f);
+						float rr = ((L.avg >> 16) & 255) + ((((s >> 16) & 255)) - (float)((L.avg >> 16) & 255)) * fog;
+						float gg2 = ((L.avg >> 8) & 255) + ((((s >> 8) & 255)) - (float)((L.avg >> 8) & 255)) * fog;
+						float bb2 = (L.avg & 255) + (((s & 255)) - (float)(L.avg & 255)) * fog;
+						c = 0xff000000 | ((uint32)rr << 16) | ((uint32)gg2 << 8) | (uint32)bb2;
+					}
+					lr = (c >> 16) & 255;
+					lg = (c >> 8) & 255;
+					lb = c & 255;
+				}
+				for (uint i = 0; i < g.layers.size() && !g.ground; i++) {
+					const PanoLayer &L = g.layers[i];
+					if (by >= L.h)
+						continue;
+					int lx = bx + shift[i];
+					lx %= L.w;
+					uint32 c = L.px[by * L.w + lx];
+					float a = (c >> 24) / 255.0f;
+					lr += (((c >> 16) & 255) - lr) * a;
+					lg += (((c >> 8) & 255) - lg) * a;
+					lb += ((c & 255) - lb) * a;
+				}
+				cr += (lr - cr) * m;
+				cg += (lg - cg) * m;
+				cb += (lb - cb) * m;
+				uint32 out = _format.RGBToColor((byte)(cr + 0.5f), (byte)(cg + 0.5f), (byte)(cb + 0.5f));
+				if (gMode != kHDSame) {
+					if (bpp == 4) {
+						uint32 p = out;
+						putHD<uint32>(&p, out, gMode, gFactor, _format);
+						out = p;
+					} else {
+						uint16 p = (uint16)out;
+						putHD<uint16>(&p, (uint16)out, gMode, gFactor, _format);
+						out = p;
+					}
+				}
+				if (bpp == 4)
+					*(uint32 *)_screen.getBasePtr(sx, sy) = out;
+				else
+					*(uint16 *)_screen.getBasePtr(sx, sy) = (uint16)out;
+				touched = true;
+			}
+		}
+		if (all && touched)
+			dirtyRects.push_back(r);
+	}
+}
+
+void HDRenderer::applyWater(const byte *frame, int pitch, int w, int h, const uint32 *ids, int idsPitch,
+		const Graphics::Surface *hd, const Graphics::Surface *ob, int offX, int offY, bool all,
+		Common::Array<Common::Rect> &dirtyRects) {
+	const Graphics::Surface &mask = (hd == &_hdBgWide) ? _waterMaskWide : _waterMask;
+	if (!hd || !hd->getPixels() || !mask.getPixels() || mask.w != hd->w || mask.h != hd->h)
+		return;
+	const int S = _scale, MW = mask.w, MH = mask.h;
+	if ((int)_waterDX.size() != MH) {
+		_waterDX.resize(MH);
+		_waterF.resize(MH);
+	}
+	if ((int)_waterDY.size() != MW)
+		_waterDY.resize(MW);
+	if ((int)_waterDiag.size() != MW + 2 * MH)
+		_waterDiag.resize(MW + 2 * MH);
+	const float PI2 = 2.0f * 3.14159265f;
+	const float t = g_system->getMillis() * 0.001f * _waterSpeed * PI2;
+	// a long swell along the rows, a shorter wave over it at another speed, and ripples crossing
+	// them on the diagonal: the water does not slide as one sheet. Longer and stronger towards
+	// the bottom of the picture (nearer to the viewer)
+	for (int y = 0; y < MH; y++) {
+		float depth = CLIP((float)y / MH * 1.4f - 0.4f, 0.0f, 1.0f);
+		float amp = _waterAmp * (0.3f + 0.7f * depth), len = _waterLen * (0.4f + 0.6f * depth);
+		_waterDX[y] = (int16)floorf(amp * (sinf(y / len * PI2 - t) + 0.45f * sinf(y / (len * 0.43f) * PI2 + 1.6f * t)) + 0.5f);
+		_waterF[y] = (int16)(256 * (0.3f + 0.7f * depth));
+	}
+	for (int x = 0; x < MW; x++)
+		_waterDY[x] = (int16)floorf(_waterAmp * 0.35f * sinf(x / (_waterLen * 3.1f) * PI2 + t * 0.7f) + 0.5f);
+	for (int i = 0; i < MW + 2 * MH; i++)
+		_waterDiag[i] = (int16)floorf(16.0f * _waterAmp * 0.5f * sinf(i / (_waterLen * 2.3f) * PI2 + 0.8f * t) + 0.5f);
+
+	Common::Array<Common::Rect> todo;
+	Common::Rect win(0, 0, _screen.w, _screen.h);
+	if (all)
+		todo.push_back(win);
+	else
+		todo = dirtyRects;
+	const int bpp = _format.bytesPerPixel;
+	for (uint ri = 0; ri < todo.size(); ri++) {
+		Common::Rect r = todo[ri];
+		r.clip(win);
+		bool touched = false;
+		// row pointers and the per-row tests out of the inner loop: this runs over the whole water 16 times
+		// a second (the dock used a full core of the Mac)
+		const byte *maskPx = (const byte *)mask.getPixels();
+		const int maskPitch = mask.pitch, hdPitch = hd->pitch, scrPitch = _screen.pitch;
+		const byte *hdPx = (const byte *)hd->getPixels();
+		for (int sy = r.top; sy < r.bottom; sy++) {
+			int gy = sy / S, by = sy + offY * S;
+			if (by < 0 || by >= MH || gy >= h)
+				continue;
+			int oy = gy + offY;
+			if (oy < 0 || oy >= ob->h)
+				continue;
+			const byte *mrow = maskPx + by * maskPitch;
+			const byte *frow = frame + gy * pitch;
+			const uint32 *irow = ids ? ids + gy * idsPitch : nullptr;
+			const byte *orow = (const byte *)ob->getBasePtr(0, oy);
+			const int dxRow = _waterDX[by], fRow = _waterF[by];
+			byte *srow = (byte *)_screen.getBasePtr(0, sy);
+			int x0 = MAX<int>(r.left, -offX * S), x1 = MIN<int>(r.right, MW - offX * S);
+			for (int sx = x0; sx < x1; sx++) {
+				int bx = sx + offX * S;
+				if (!mrow[bx])
+					continue;
+				int gx = sx / S;
+				if (gx >= w)
+					break;
+				if (irow && irow[gx])
+					continue;	// an HD sprite
+				int ox = gx + offX;
+				byte idx = frow[gx];
+				if (ox < 0 || ox >= ob->w || orow[ox] != idx)
+					continue;	// a sprite drawn into the frame
+				if (_mode[idx] != kHDSame)
+					continue;	// fading: the composed pixel stays
+				int ripple = (_waterDiag[bx + 2 * by] * fRow) >> 12;
+				int qx = CLIP(bx + dxRow + ripple, 0, MW - 1), qy = CLIP(by + _waterDY[bx], 0, MH - 1);
+				if (!maskPx[qy * maskPitch + qx])
+					continue;
+				if (bpp == 4)
+					((uint32 *)srow)[sx] = *(const uint32 *)(hdPx + qy * hdPitch + qx * 4);
+				else
+					((uint16 *)srow)[sx] = *(const uint16 *)(hdPx + qy * hdPitch + qx * 2);
+				touched = true;
+			}
+		}
+		if (all && touched)
+			dirtyRects.push_back(r);
+	}
+}
+
+// background widened for 16:9 (tools/hd/widen.py): (w + 2 * margin) x h at the HD scale
+bool HDRenderer::loadWideBackground(const Common::String &name, int w, int h) {
+	Common::FSNode gameDir(ConfMan.getPath("path"));
+	Common::FSNode hdDir = gameDir.getChild("hd");
+	if (!hdDir.exists() || !hdDir.isDirectory())
+		return false;
+	Common::FSDirectory dir(hdDir, 4);
+	Common::SeekableReadStream *stream = dir.createReadStreamForMember(Common::Path(name + ".jpg", '/'));
+	if (!stream)
+		return false;
+	Image::JPEGDecoder jpeg;
+	jpeg.setOutputPixelFormat(Graphics::PixelFormat(4, 8, 8, 8, 8, 24, 16, 8, 0));
+	bool ok = jpeg.loadStream(*stream);
+	delete stream;
+	const Graphics::Surface *src = ok ? jpeg.getSurface() : nullptr;
+	if (!src || src->w != (w + 2 * _wideM) * _scale || src->h != h * _scale) {
+		if (src)
+			warning("HD wide background %s has an unexpected size %dx%d", name.c_str(), src->w, src->h);
+		return false;
+	}
+	_hdBgWide.create(src->w, src->h, _format);
+	for (int y = 0; y < src->h && src->format == _format; y++)
+		memcpy(_hdBgWide.getBasePtr(0, y), src->getBasePtr(0, y), src->w * 4);
+	for (int y = 0; y < src->h && src->format != _format; y++) {
+		const uint32 *sp = (const uint32 *)src->getBasePtr(0, y);
+		for (int x = 0; x < src->w; x++) {
+			byte a, r, g, b;
+			src->format.colorToARGB(sp[x], a, r, g, b);
+			uint32 c = _format.RGBToColor(r, g, b);
+			if (_format.bytesPerPixel == 4)
+				*(uint32 *)_hdBgWide.getBasePtr(x, y) = c;
+			else
+				*(uint16 *)_hdBgWide.getBasePtr(x, y) = (uint16)c;
+		}
+	}
+	// the widened picture repaints the black border columns of some originals: use its centre
+	// for the normal background too, so no dark line is left where the original ended
+	if (_hdBg.w == w * _scale && _hdBg.h == h * _scale && _hdBg.format == _format) {
+		for (int y = 0; y < _hdBg.h; y++)
+			memcpy(_hdBg.getBasePtr(0, y), _hdBgWide.getBasePtr(_wideM * _scale, y), _hdBg.w * _format.bytesPerPixel);
+	}
+	debug(1, "HD wide background loaded: %s", name.c_str());
+	return true;
+}
+
+// Scale2x / Scale3x (AdvanceMAME) on palette indices
+void HDRenderer::scaleFrame(const byte *src, int pitch, int w, int h) {
+	int dw = w * _scale, dh = h * _scale;
+	if (!_scaled || _scaledPitch != dw) {
+		delete[] _scaled;
+		_scaled = new byte[dw * dh];
+		_scaledPitch = dw;
+	}
+	scaleRect(src, pitch, w, h, 0, 0, w, h);
+}
+
+// scales the source pixels in [x0,x1) x [y0,y1) into _scaled (sized for the whole w x h frame)
+void HDRenderer::scaleRect(const byte *src, int pitch, int w, int h, int x0, int y0, int x1, int y1) {
+	int dw = _scaledPitch;
+
+	for (int y = y0; y < y1; y++) {
+		const byte *row = src + y * pitch;
+		const byte *up = (y > 0) ? row - pitch : row;
+		const byte *dn = (y < h - 1) ? row + pitch : row;
+		byte *d0 = _scaled + (y * _scale) * dw;
+
+		for (int x = x0; x < x1; x++) {
+			int xl = (x > 0) ? x - 1 : x;
+			int xr = (x < w - 1) ? x + 1 : x;
+			byte E = row[x];
+			byte B = up[x], D = row[xl], F = row[xr], H = dn[x];
+
+			if (_scale == 2) {
+				byte *p = d0 + x * 2;
+				if (B != H && D != F) {
+					p[0] = (D == B) ? D : E;
+					p[1] = (B == F) ? F : E;
+					p[dw] = (D == H) ? D : E;
+					p[dw + 1] = (H == F) ? F : E;
+				} else {
+					p[0] = p[1] = p[dw] = p[dw + 1] = E;
+				}
+			} else {
+				byte A = up[xl], C = up[xr], G = dn[xl], I = dn[xr];
+				byte *p = d0 + x * 3;
+				if (B != H && D != F) {
+					p[0] = (D == B) ? D : E;
+					p[1] = ((D == B && E != C) || (B == F && E != A)) ? B : E;
+					p[2] = (B == F) ? F : E;
+					p[dw] = ((D == B && E != G) || (D == H && E != A)) ? D : E;
+					p[dw + 1] = E;
+					p[dw + 2] = ((B == F && E != I) || (H == F && E != C)) ? F : E;
+					p[2 * dw] = (D == H) ? D : E;
+					p[2 * dw + 1] = ((D == H && E != I) || (H == F && E != G)) ? H : E;
+					p[2 * dw + 2] = (H == F) ? F : E;
+				} else {
+					p[0] = p[1] = p[2] = E;
+					p[dw] = p[dw + 1] = p[dw + 2] = E;
+					p[2 * dw] = p[2 * dw + 1] = p[2 * dw + 2] = E;
+				}
+			}
+		}
+	}
+}
+
+// A picture of the patch for an original image (the mouse pointers, hd/pointer1.png...), at the HD scale.
+// The file may be any integer multiple of the original size not below the scale: reduced with a box
+// filter weighted by alpha, as the HD sprites
+const Graphics::Surface *HDRenderer::hdPicture(const Common::String &name, int w, int h) {
+	Common::HashMap<Common::String, Graphics::Surface *>::iterator it = _pictures.find(name);
+	if (it != _pictures.end())
+		return it->_value;
+	_pictures[name] = nullptr;	// failures are cached too
+	Common::SeekableReadStream *stream = openHDFile(name);
+	if (!stream || w <= 0 || h <= 0) {
+		delete stream;
+		return nullptr;
+	}
+	Image::PNGDecoder png;
+	bool ok = png.loadStream(*stream);
+	delete stream;
+	if (!ok)
+		return nullptr;
+	const Graphics::Surface *src = png.getSurface();
+	int k = src->w / w;
+	if (src->w % w || src->h % h || src->h / h != k || k < _scale) {
+		warning("HD picture %s: unexpected size %dx%d (original %dx%d, scale %d)", name.c_str(), src->w, src->h, w, h, _scale);
+		return nullptr;
+	}
+	Graphics::Surface *rgb = src->convertTo(cursorFormat(), png.getPalette().data(), png.getPalette().size());
+	Graphics::Surface *out = new Graphics::Surface;
+	out->create(w * _scale, h * _scale, cursorFormat());
+	for (int y = 0; y < out->h; y++) {
+		uint32 *dp = (uint32 *)out->getBasePtr(0, y);
+		for (int x = 0; x < out->w; x++) {
+			// source pixels [x*k/s, (x+1)*k/s) with partial weights at the ends (in 1/s units)
+			uint32 aa = 0, ar = 0, ag = 0, ab = 0, aw = 0;
+			int sy0 = y * k, sy1 = (y + 1) * k, sx0 = x * k, sx1 = (x + 1) * k;
+			for (int yy = sy0 / _scale; yy * _scale < sy1; yy++) {
+				int wy = MIN(sy1, (yy + 1) * _scale) - MAX(sy0, yy * _scale);
+				const uint32 *sp = (const uint32 *)rgb->getBasePtr(0, yy);
+				for (int xx = sx0 / _scale; xx * _scale < sx1; xx++) {
+					int wx = MIN(sx1, (xx + 1) * _scale) - MAX(sx0, xx * _scale);
+					uint32 c = sp[xx], a = c >> 24, wgt = wx * wy;
+					aa += a * wgt;
+					ar += ((c >> 16) & 0xff) * a * wgt;
+					ag += ((c >> 8) & 0xff) * a * wgt;
+					ab += (c & 0xff) * a * wgt;
+					aw += wgt;
+				}
+			}
+			dp[x] = aa ? ((aa / aw) << 24) | ((ar / aa) << 16) | ((ag / aa) << 8) | (ab / aa) : 0;
+		}
+	}
+	rgb->free();
+	delete rgb;
+	_pictures[name] = out;
+	return out;
+}
+
+const uint32 *HDRenderer::spriteImage(const byte *pixels, int w, int h, byte transparentKey) {
+	if (!_sprEnabled || w <= 0 || h <= 0 || w >= 1024 || h >= 1024)
+		return nullptr;
+	uint32 key = frameKey(pixels, w, h);
+	Common::HashMap<uint32, SpriteEntry>::iterator ie = _sprIndex.find(key);
+	if (ie == _sprIndex.end() || ie->_value.w != w || ie->_value.h != h || ie->_value.ml || ie->_value.mr)
+		return nullptr;
+	HDSprite *spr;
+	Common::HashMap<uint32, HDSprite *>::iterator ic = _sprCache.find(key);
+	if (ic != _sprCache.end()) {
+		spr = ic->_value;
+	} else {
+		spr = loadSprite(key, ie->_value, pixels, transparentKey);
+		_sprCache[key] = spr;
+		if (spr)
+			for (int i = 0; i < w * h; i++)
+				if (pixels[i] != transparentKey)
+					spr->used[pixels[i] >> 5] |= 1u << (pixels[i] & 31);
+	}
+	if (!spr)
+		return nullptr;
+	spr->lastUsed = _frameNo;
+	return spr->px;
+}
+
+byte *HDRenderer::scaleIndexed(const byte *src, int w, int h, int pitch) {
+	scaleFrame(src, pitch, w, h);
+	int n = w * h * _scale * _scale;
+	byte *out = new byte[n];
+	memcpy(out, _scaled, n);
+	// force reallocation next frame (sizes differ)
+	delete[] _scaled;
+	_scaled = nullptr;
+	return out;
+}
