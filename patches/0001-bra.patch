+void HDRenderer::render(const Graphics::Surface &backBuffer, int scrollX, int scrollY, int w, int h) {
+	const uint32 *ids = nullptr, *ids2 = nullptr;
+	bool idsOk = _ids && _idW == backBuffer.w && _idH == backBuffer.h;
+	int M = _wideM;
+	if (!M) {
+		_outL = _outR = 0;
+		_sidesUsed = false;
+		if (idsOk && scrollX + w <= _idW && scrollY + h <= _idH) {
+			ids = _ids + scrollY * _idW + scrollX;
+			ids2 = _ids + _idW * _idH + scrollY * _idW + scrollX;
+		}
+		renderWindow((const byte *)backBuffer.getBasePtr(scrollX, scrollY), backBuffer.pitch, scrollX, scrollY, w, h, ids, ids2, _idW);
+		if (_verifyShift && (_statShifted || _verifyAll))
+			verifyShift((const byte *)backBuffer.getBasePtr(scrollX, scrollY), backBuffer.pitch, scrollX, scrollY, w, h, ids, ids2, _idW);
+		return;
+	}
+	// 16:9: a window M pixels wider on each side; what lies outside the back buffer comes from
+	// the widened HD background (or stays black)
+	int W2 = w + 2 * M, sx0 = scrollX - M;
+	bool sides = _sidesOn && _sideW == (int)backBuffer.w;
+	_sidesUsed = sides;
+	_ext.resize(W2 * h);
+	_extIds.resize(W2 * h * 2);
+	_outL = CLIP(-sx0, 0, W2);
+	_outR = CLIP(sx0 + W2 - (int)backBuffer.w, 0, W2);
+	// row by row: the part inside the back buffer is copied, only the columns beside it are looked
+	// at one by one (per pixel this took ~2 ms of every frame)
+	const int bw = backBuffer.w, bh = backBuffer.h;
+	const int xin0 = CLIP(-sx0, 0, W2), xin1 = CLIP(bw - sx0, 0, W2);	// [xin0, xin1): inside, if the row is
+	for (int y = 0; y < h; y++) {
+		int by = scrollY + y;
+		byte *e = &_ext[y * W2];
+		uint32 *ei = &_extIds[y * W2], *ei2 = &_extIds[W2 * h + y * W2];
+		bool rowIn = by >= 0 && by < bh;
+		int a = rowIn ? xin0 : W2, b = rowIn ? xin1 : W2;
+		if (a < b) {
+			memcpy(e + a, (const byte *)backBuffer.getBasePtr(sx0 + a, by), b - a);
+			if (idsOk) {
+				memcpy(ei + a, _ids + by * _idW + sx0 + a, (b - a) * sizeof(uint32));
+				memcpy(ei2 + a, _ids + _idW * _idH + by * _idW + sx0 + a, (b - a) * sizeof(uint32));
+			} else {
+				memset(ei + a, 0, (b - a) * sizeof(uint32));
+				memset(ei2 + a, 0, (b - a) * sizeof(uint32));
+			}
+		} else {
+			a = b = 0;
+		}
+		for (int x = 0; x < W2; x++) {
+			if (x == a && a < b) {
+				x = b - 1;
+				continue;
+			}
+			int bx = sx0 + x;
+			e[x] = 0;
+			ei[x] = 0;
+			ei2[x] = 0;
+			if (sides && by >= 0 && by < _side[0].h) {
+				// beside the back buffer: the strips with the sprites that leave it (beginScene)
+				int s = bx < 0 ? 0 : 1, sx = s ? bx - bw : bx + M;
+				if (sx >= 0 && sx < M) {
+					e[x] = *(const byte *)_side[s].getBasePtr(sx, by);
+					if (idsOk) {
+						ei[x] = _sideIds[s][by * M + sx];
+						ei2[x] = _sideIds[s][M * _side[s].h + by * M + sx];
+					}
+				}
+			}
+		}
+	}
+	renderWindow(&_ext[0], W2, sx0, scrollY, W2, h, idsOk ? &_extIds[0] : nullptr, idsOk ? &_extIds[W2 * h] : nullptr, W2);
+	if (_verifyShift && (_statShifted || _verifyAll))
+		verifyShift(&_ext[0], W2, sx0, scrollY, W2, h, idsOk ? &_extIds[0] : nullptr, idsOk ? &_extIds[W2 * h] : nullptr, W2);
+}
+
+// test aid (autotest "verifyscroll"): compose a scrolled frame again from scratch and log how many
+// HD pixels differ from the moved picture
+void HDRenderer::verifyShift(const byte *frame, int pitch, int scrollX, int scrollY, int w, int h, const uint32 *idsWin, const uint32 *ids2Win, int idsPitch) {
+	Graphics::Surface copy;
+	copy.copyFrom(_screen);
+	Common::Array<FrameText> texts = _frameText;
+	_fullRedraw = true;
+	renderWindow(frame, pitch, scrollX, scrollY, w, h, idsWin, ids2Win, idsPitch);
+	_frameText = texts;
+	int diff = 0, minX = _screen.w, maxX = -1;
+	for (int y = 0; y < _screen.h; y++) {
+		for (int x = 0; x < _screen.w; x++) {
+			bool d = _format.bytesPerPixel == 4 ? *(const uint32 *)copy.getBasePtr(x, y) != *(const uint32 *)_screen.getBasePtr(x, y)
+				: *(const uint16 *)copy.getBasePtr(x, y) != *(const uint16 *)_screen.getBasePtr(x, y);
+			if (d) {
+				diff++;
+				minX = MIN(minX, x);
+				maxX = MAX(maxX, x);
+			}
+		}
+	}
+	debug("SHIFTCHECK scroll=%d,%d differing=%d x=%d..%d", scrollX, scrollY, diff, minX, maxX);
+	copy.free();
+}
+
+void HDRenderer::paintOutside(const byte *frame, int pitch, const uint32 *ids, int idsPitch, int scrollX, int scrollY, int w, int h) {
+	const int S = _scale, M = _wideM;
+	bool wide = _hdBgWide.getPixels() && _origBg.getPixels() && !_classic;
+	bool sides = wide && _sidesUsed;
+	for (int y = 0; y < h; y++) {
+		int by = y + scrollY - _bgY;
+		for (int x = 0; x < w; x++) {
+			if (x >= _outL && x < w - _outR)
+				continue;
+			int bx = x + scrollX - _bgX;		// outside the original background
+			bool have = wide && by >= 0 && by < _origBg.h && bx >= -M && bx < _origBg.w + M;
+			// fades and the gray view: as the nearest original background pixel
+			byte idx = have ? *(const byte *)_origBg.getBasePtr(CLIP(bx, 0, _origBg.w - 1), by) : 0;
+			// sprites in the bands (beginScene): composeFrame drew the band already, only what it
+			// cannot show in HD (a palette effect with no HD equivalent) goes black as before
+			if (sides && (frame[y * pitch + x] != idx || (ids && ids[y * idsPitch + x]) || (have && _mode[idx] != 3)))
+				continue;
+			for (int j = 0; j < S; j++) {
+				for (int i = 0; i < S; i++) {
+					uint32 c = 0;
+					if (have && _mode[idx] != 3) {
+						uint32 p = _format.bytesPerPixel == 4 ? *(const uint32 *)_hdBgWide.getBasePtr((bx + M) * S + i, by * S + j)
+								: *(const uint16 *)_hdBgWide.getBasePtr((bx + M) * S + i, by * S + j);
+						if (_format.bytesPerPixel == 4) {
+							uint32 q = p;
+							putHD<uint32>(&q, p, _mode[idx], _factor[idx], _format);
+							c = q;
+						} else {
+							uint16 q = (uint16)p;
+							putHD<uint16>(&q, (uint16)p, _mode[idx], _factor[idx], _format);
+							c = q;
+						}
+					} else {
+						c = _format.RGBToColor(0, 0, 0);
+					}
+					if (_format.bytesPerPixel == 4)
+						*(uint32 *)_screen.getBasePtr(x * S + i, y * S + j) = c;
+					else
+						*(uint16 *)_screen.getBasePtr(x * S + i, y * S + j) = (uint16)c;
+				}
+			}
+		}
+	}
+}
+
+// whether the frame uses one of the changed palette entries in [x0, x1) x [y0, y1)
+static bool usesEntries(const byte *frame, int pitch, const bool *changed, int x0, int x1, int y0, int y1) {
+	for (int y = y0; y < y1; y++) {
+		const byte *p = frame + y * pitch;
+		for (int x = x0; x < x1; x++)
+			if (changed[p[x]])
+				return true;
+	}
+	return false;
+}
+
+static bool hitsAny(const Common::Array<Common::Rect> &rects, int x0, int x1, int y0, int y1) {
+	Common::Rect t(x0, y0, x1, y1);
+	for (uint i = 0; i < rects.size(); i++)
+		if (rects[i].intersects(t))
+			return true;
+	return false;
+}
+
+// whether the 16:9 bands take their colours from a changed palette entry: paintOutside follows the
+// nearest original background pixel, which lies in the first or last column of the background
+bool HDRenderer::bandsUseChanged(int scrollY, int h) const {
+	if (!_origBg.getPixels())
+		return false;
+	for (int y = 0; y < h; y++) {
+		int by = y + scrollY - _bgY;
+		if (by < 0 || by >= _origBg.h)
+			continue;
+		const byte *row = (const byte *)_origBg.getBasePtr(0, by);
+		if ((_outL && _palChanged[row[0]]) || (_outR && _palChanged[row[_origBg.w - 1]]))
+			return true;
+	}
+	return false;
+}
+
+void HDRenderer::renderWindow(const byte *frame, int pitch, int scrollX, int scrollY, int w, int h, const uint32 *idsWin, const uint32 *ids2Win, int idsPitch) {
+	const int T = 16;	// tile size, in original pixels
+
+	if (_screen.w != w * _scale || _screen.h != h * _scale) {
+		_screen.create(w * _scale, h * _scale, _format);
+		delete[] _prevFrame;
+		_prevFrame = new byte[w * h];
+		_fullRedraw = true;
+	}
+	if (!_scaled || _scaledPitch != w * _scale) {
+		delete[] _scaled;
+		_scaled = new byte[w * _scale * h * _scale];
+		_scaledPitch = w * _scale;
+		delete[] _xbr;
+		_xbr = _useXBR ? new uint32[w * _scale * h * _scale] : nullptr;
+		_fullRedraw = true;
+	}
+
+	if (_paletteDirty)
+		updateModes();
+
+	_idsPitchCur = idsPitch;
+	_statPixels = 0;
+	// scrolling: move what is already on screen and redraw only the uncovered strip and what
+	// changed (a full redraw at 3x took ~90 ms, so a scrolling room ran at ~10 fps)
+	Common::Array<Common::Rect> forceRects;	// window coordinates, original pixels
+	bool shifted = false;
+	if (scrollX != _prevScrollX || scrollY != _prevScrollY) {
+		int dx = scrollX - _prevScrollX, dy = scrollY - _prevScrollY;
+		if (_fullRedraw || ABS(dx) * 2 > w || ABS(dy) * 2 > h || _prevIdsSize != w * h) {
+			_fullRedraw = true;
+		} else {
+			shiftWindow(dx, dy, w, h);
+			shifted = true;
+			// uncovered strip, plus the old window edges: the scalers clamp their neighbourhood
+			// (2 pixels for xBR) at the window border, so those pixels change once inside
+			// at the window border, and the new border too (inside before)
+			const int B = 3;
+			if (dx) {
+				forceRects.push_back(Common::Rect(MAX(0, w - MAX(dx, 0) - B), 0, w, h));
+				forceRects.push_back(Common::Rect(0, 0, MIN(w, MAX(-dx, 0) + B), h));
+			}
+			if (dy) {
+				forceRects.push_back(Common::Rect(0, MAX(0, h - MAX(dy, 0) - B), w, h));
+				forceRects.push_back(Common::Rect(0, 0, w, MIN(h, MAX(-dy, 0) + B)));
+			}
+			// 16:9: the columns outside the back buffer (painted by paintOutside) before and now
+			int oldL = CLIP(_prevOutL - dx, 0, w), oldR = CLIP(_prevOutR + dx, 0, w);
+			int l = MAX(_outL, oldL), r = MAX(_outR, oldR);
+			if (l)
+				forceRects.push_back(Common::Rect(0, 0, MIN(w, l + B), h));
+			if (r)
+				forceRects.push_back(Common::Rect(MAX(0, w - r - B), 0, w, h));
+			// HD texts are painted over the frame: where they were (now moved with the picture)
+			// and where they are now
+			for (uint i = 0; i < _prevFrameText.size(); i++) {
+				Common::Rect t = frameTextBounds(_prevFrameText[i]);
+				t.translate(-_prevScrollX - dx, -_prevScrollY - dy);
+				t.clip(Common::Rect(w, h));
+				if (!t.isEmpty())
+					forceRects.push_back(t);
+			}
+			for (uint i = 0; i < _frameText.size(); i++) {
+				Common::Rect t = frameTextBounds(_frameText[i]);
+				t.translate(-scrollX, -scrollY);
+				t.clip(Common::Rect(w, h));
+				if (!t.isEmpty())
+					forceRects.push_back(t);
+			}
+		}
+	}
+
+	// timed HD frames that changed with the clock (spriteSlot): compose their area again
+	for (uint i = 0; i < _animDirty.size(); i++) {
+		Common::Rect t = _animDirty[i];
+		t.translate(-scrollX, -scrollY);
+		t.clip(Common::Rect(w, h));
+		if (!t.isEmpty())
+			forceRects.push_back(t);
+	}
+	_animDirty.clear();
+
+	const Graphics::Surface *hd = _hdBg.getPixels() ? &_hdBg : nullptr;
+	const Graphics::Surface *ob = &_origBg;
+	int offX = scrollX - _bgX, offY = scrollY - _bgY;
+	if (_sidesUsed && !_classic) {
+		// 16:9 with sprites beside the back buffer: the widened backgrounds, so the bands are
+		// composed like the rest of the picture (HD band, sprites over it, soft edges)
+		hd = &_hdBgWide;
+		ob = &_origBgWide;
+		offX += _wideM;
+	}
+
+	// HD text: a text that appears, disappears or moves (the name label follows the pointer) redraws
+	// only the tiles under its old and new place, not the whole frame (a full redraw per mouse move
+	// slowed down the pointer while a label was shown)
+	Common::String textSig = frameTextSignature(_frameText);
+	Common::Array<Common::Rect> textRects;	// window coordinates, original pixels
+	if (textSig != _prevTextSig && !_fullRedraw) {
+		for (int pass = 0; pass < 2; pass++) {
+			const Common::Array<FrameText> &a = pass ? _prevFrameText : _frameText;
+			const Common::Array<FrameText> &b = pass ? _frameText : _prevFrameText;
+			for (uint i = 0; i < a.size(); i++) {
+				bool same = false;
+				for (uint j = 0; j < b.size() && !same; j++)
+					same = sameFrameText(a[i], b[j]);
+				if (same)
+					continue;
+				Common::Rect r = frameTextBounds(a[i]);
+				r.translate(-scrollX, -scrollY);
+				r.clip(Common::Rect(w, h));
+				if (!r.isEmpty())
+					textRects.push_back(r);
+			}
+		}
+	}
+	_prevTextSig = textSig;
+	_prevFrameText = _frameText;
+	Common::Array<Common::Rect> dirtyRects;
+
+	// a few palette entries changed (colour cycling, see setPalette): the tiles that use them are
+	// composed again, with 2 pixels around (the xBR neighbourhood); HD texts take their colours from
+	// the palette, so they are drawn again too
+	const bool palPartial = _palChangedCount > 0 && !_fullRedraw;
+	if (palPartial) {
+		for (uint i = 0; i < _frameText.size(); i++) {
+			Common::Rect r = frameTextBounds(_frameText[i]);
+			r.translate(-scrollX, -scrollY);
+			r.clip(Common::Rect(w, h));
+			if (!r.isEmpty())
+				textRects.push_back(r);
+		}
+	}
+
+	// sprite slots of this frame
+	const uint32 *ids = nullptr, *ids2 = nullptr;
+	Common::Array<SlotView> views;
+	if (idsWin && _slots.size() > 1) {
+		ids = idsWin;
+		ids2 = ids2Win;
+		views.resize(_slots.size());
+		for (uint i = 1; i < _slots.size(); i++) {
+			views[i].px = _slots[i].spr->px;
+			views[i].w = _slots[i].spr->w;
+			views[i].ml = _slots[i].spr->ml;
+			views[i].ow = _slots[i].spr->w - _slots[i].spr->ml - _slots[i].spr->mr;
+			views[i].h = _slots[i].spr->h;
+			views[i].scale = _slots[i].scale;
+			views[i].ox = _slots[i].ox - scrollX;
+			views[i].oy = _slots[i].oy - scrollY;
+			views[i].mode = _slots[i].mode;
+			views[i].factor = _slots[i].factor;
+		}
+	}
+	const SlotView *slotViews = views.empty() ? nullptr : &views[0];
+
+	int tilesX = (w + T - 1) / T, tilesY = (h + T - 1) / T;
+	for (int ty = 0; ty < tilesY; ty++) {
+		int y0 = ty * T, y1 = MIN(h, y0 + T);
+		int tx = 0;
+		while (tx < tilesX) {
+			// find a run of dirty tiles on this tile row
+			bool dirty = _fullRedraw;
+			if (!dirty) {
+				int x0 = tx * T, x1 = MIN(w, x0 + T);
+				// a pixel change also affects the scaled neighbours: check a 1 pixel border
+				int cx0 = MAX(0, x0 - 1), cx1 = MIN(w, x1 + 1);
+				int cy0 = MAX(0, y0 - 1), cy1 = MIN(h, y1 + 1);
+				for (int y = cy0; y < cy1 && !dirty; y++)
+					dirty = memcmp(frame + y * pitch + cx0, _prevFrame + y * w + cx0, cx1 - cx0) != 0;
+				// same 8-bit pixels can come from a different sprite frame, whose HD image differs:
+				// without this a turning head ends up made of tiles of two different frames
+				if (!dirty)
+					dirty = idsChanged(ids, w, cx0, cx1, cy0, cy1);
+				if (!dirty)
+					dirty = hitsAny(textRects, x0, x1, y0, y1);
+				if (!dirty)
+					dirty = hitsAny(forceRects, x0, x1, y0, y1);
+				if (!dirty && palPartial)
+					dirty = usesEntries(frame, pitch, _palChanged, MAX(0, x0 - 2), MIN(w, x1 + 2), MAX(0, y0 - 2), MIN(h, y1 + 2));
+			}
+			if (!dirty) {
+				tx++;
+				continue;
+			}
+			int run = tx + 1;
+			if (_fullRedraw) {
+				run = tilesX;
+			} else {
+				while (run < tilesX) {
+					int x0 = run * T, x1 = MIN(w, x0 + T);
+					int cx0 = MAX(0, x0 - 1), cx1 = MIN(w, x1 + 1);
+					int cy0 = MAX(0, y0 - 1), cy1 = MIN(h, y1 + 1);
+					bool d = false;
+					for (int y = cy0; y < cy1 && !d; y++)
+						d = memcmp(frame + y * pitch + cx0, _prevFrame + y * w + cx0, cx1 - cx0) != 0;
+					if (!d)
+						d = idsChanged(ids, w, cx0, cx1, cy0, cy1);
+					if (!d)
+						d = hitsAny(textRects, x0, x1, y0, y1);
+					if (!d)
+						d = hitsAny(forceRects, x0, x1, y0, y1);
+					if (!d && palPartial)
+						d = usesEntries(frame, pitch, _palChanged, MAX(0, x0 - 2), MIN(w, x1 + 2), MAX(0, y0 - 2), MIN(h, y1 + 2));
+					if (!d)
+						break;
+					run++;
+				}
+			}
+			int x0 = tx * T, x1 = MIN(w, run * T);
+			_statPixels += (x1 - x0) * (y1 - y0);
+			if (_classic) {
+				composeClassic(frame, pitch, x0, y0, x1, y1);
+				if (!_fullRedraw)
+					dirtyRects.push_back(Common::Rect(x0 * _scale, y0 * _scale, x1 * _scale, y1 * _scale));
+				tx = run;
+				continue;
+			}
+			if (_xbr)
+				xbrRect(frame, pitch, w, h, x0, y0, x1, y1);
+			else
+				scaleRect(frame, pitch, w, h, x0, y0, x1, y1);
+			if (_format.bytesPerPixel == 4)
+				composeFrame<uint32>(_screen, frame, pitch, w, x0, y0, x1, y1, _scaled, _xbr, _scale, _curPalPixel, hd, ob, offX, offY, _mode, _factor, _format, ids, ids2, idsPitch, slotViews, h);
+			else
+				composeFrame<uint16>(_screen, frame, pitch, w, x0, y0, x1, y1, _scaled, _xbr, _scale, _curPalPixel, hd, ob, offX, offY, _mode, _factor, _format, ids, ids2, idsPitch, slotViews, h);
+			if (!_fullRedraw)
+				dirtyRects.push_back(Common::Rect(x0 * _scale, y0 * _scale, x1 * _scale, y1 * _scale));
+			tx = run;
+		}
+	}
+
+	if (_fullRedraw) {
+		dirtyRects.clear();
+		dirtyRects.push_back(Common::Rect(_screen.w, _screen.h));
+	}
+	if (_fullRedraw && (_outL || _outR))
+		paintOutside(frame, pitch, ids, idsPitch, scrollX, scrollY, w, h);
+	else if (_outL || _outR) {
+		// a sprite next to the edge redraws tiles that reach into the outside columns (the black
+		// border of the original picture): paint them again, or a black bar follows the sprite
+		Common::Rect left(0, 0, _outL * _scale, _screen.h), right((w - _outR) * _scale, 0, _screen.w, _screen.h);
+		// (their colours follow the palette of the nearest original pixel: a few changed entries
+		// matter only when the edge columns of the original background use them. Repainting the
+		// bands at every colour cycling step sent two full height strips to the screen, so the
+		// backend uploaded the whole picture at each step of the park fountain)
+		bool hit = palPartial && bandsUseChanged(scrollY, h);
+		for (uint i = 0; i < dirtyRects.size() && !hit; i++)
+			hit = (_outL && dirtyRects[i].intersects(left)) || (_outR && dirtyRects[i].intersects(right));
+		if (hit) {
+			paintOutside(frame, pitch, ids, idsPitch, scrollX, scrollY, w, h);
+			if (_outL)
+				dirtyRects.push_back(left);
+			if (_outR)
+				dirtyRects.push_back(right);
+		}
+	}
+	if (!_pano.empty() && !_classic) {
+		int step = (int)(g_system->getMillis() / 33);	// 30 steps per second
+		bool all = step != _panoStep || shifted || _fullRedraw;
+		_panoStep = step;
+		for (uint i = 0; i < _pano.size(); i++)
+			applyPanorama(_pano[i], frame, pitch, w, h, ids, idsPitch, hd, ob, offX, offY, all, dirtyRects);
+	}
+	if ((_waterMask.getPixels() || _waterMaskWide.getPixels()) && !_classic) {
+		int step = (int)(g_system->getMillis() / 60);	// 16 wave steps per second
+		bool all = step != _waterStep || shifted || _fullRedraw;
+		_waterStep = step;
+		applyWater(frame, pitch, w, h, ids, idsPitch, hd, ob, offX, offY, all, dirtyRects);
+	}
+	if (!_balloons.empty() && !_classic)
+		drawBalloons(dirtyRects, scrollX, scrollY);
+	if (!_frameText.empty() && !_classic)
+		drawTexts(dirtyRects, scrollX, scrollY);
+	if (shifted) {
+		// the whole picture moved
+		present(Common::Rect(_screen.w, _screen.h));
+	} else {
+		for (uint i = 0; i < dirtyRects.size(); i++)
+			present(dirtyRects[i]);
+	}
+
+	for (int y = 0; y < h; y++)
+		memcpy(_prevFrame + y * w, frame + y * pitch, w);
+	if (_prevIdsSize != w * h) {
+		delete[] _prevIds;
+		_prevIds = new uint32[w * h];
+		_prevIdsSize = w * h;
+	}
+	for (int y = 0; y < h; y++) {
+		if (ids)
+			memcpy(_prevIds + y * w, ids + y * idsPitch, w * sizeof(uint32));
+		else
+			memset(_prevIds + y * w, 0, w * sizeof(uint32));
+	}
+	_prevScrollX = scrollX;
+	_prevScrollY = scrollY;
+	_prevOutL = _outL;
+	_prevOutR = _outR;
+	_statShifted = shifted;
+	_fullRedraw = false;
+	if (_palChangedCount) {
+		memset(_palChanged, 0, sizeof(_palChanged));
+		_palChangedCount = 0;
+	}
+}
+
+// A part of the composed picture to the screen. With the backdrop (the game's start menu) the black of the picture
+// becomes the rays of the app's loader: what is not black stays over them, its dark edges blended (a luminance key),
+// so the logo and the menu items sit on the rays. _screen keeps the picture without them.
+void HDRenderer::present(const Common::Rect &r) {
+	if (!_backdrop || _classic || _format.bytesPerPixel != 4) {
+		g_system->copyRectToScreen(_screen.getBasePtr(r.left, r.top), _screen.pitch, r.left, r.top, r.width(), r.height());
+		return;
+	}
+	if (_rays.w != _screen.w || _rays.h != _screen.h) {
+		_rays.free();
+		hdPaintRays(_rays, _format, _screen.w, _screen.h, 0.18f, 0.62f);
+	}
+	Common::Array<uint32> row(r.width());
+	for (int y = r.top; y < r.bottom; y++) {
+		const uint32 *src = (const uint32 *)_screen.getBasePtr(r.left, y), *bg = (const uint32 *)_rays.getBasePtr(r.left, y);
+		for (int x = 0; x < r.width(); x++) {
+			byte r1, g1, b1, r2, g2, b2;
+			_format.colorToRGB(src[x], r1, g1, b1);
+			_format.colorToRGB(bg[x], r2, g2, b2);
+			int m = MAX(r1, MAX(g1, b1));
+			int a = CLIP((m - 16) * 256 / 112, 0, 256);	// 0 = black (rays), 256 = opaque
+			row[x] = _format.RGBToColor(MIN(255, r1 + r2 * (256 - a) / 256), MIN(255, g1 + g2 * (256 - a) / 256), MIN(255, b1 + b2 * (256 - a) / 256));
+		}
+		g_system->copyRectToScreen(row.data(), r.width() * 4, r.left, y, r.width(), 1);
+	}
+}
+
+// moves the composed picture and the copies of the previous frame (8-bit pixels, sprite ids) by
+// the scroll delta (dx, dy original pixels): content at window x + dx is now at x
+void HDRenderer::shiftWindow(int dx, int dy, int w, int h) {
+	const int S = _scale, bpp = _format.bytesPerPixel;
+	// HD picture
+	{
+		int sw = _screen.w, sh = _screen.h, sdx = dx * S, sdy = dy * S;
+		int cols = sw - ABS(sdx);
+		int srcX = MAX(0, sdx), dstX = MAX(0, -sdx);
+		if (sdy >= 0) {
+			for (int y = 0; y < sh - sdy; y++)
+				memmove(_screen.getBasePtr(dstX, y), _screen.getBasePtr(srcX, y + sdy), cols * bpp);
+		} else {
+			for (int y = sh - 1; y >= -sdy; y--)
+				memmove(_screen.getBasePtr(dstX, y), _screen.getBasePtr(srcX, y + sdy), cols * bpp);
+		}
+	}
+	// previous 8-bit frame and sprite ids, w x h
+	int cols = w - ABS(dx), srcX = MAX(0, dx), dstX = MAX(0, -dx);
+	if (dy >= 0) {
+		for (int y = 0; y < h - dy; y++) {
+			memmove(_prevFrame + y * w + dstX, _prevFrame + (y + dy) * w + srcX, cols);
+			memmove(_prevIds + y * w + dstX, _prevIds + (y + dy) * w + srcX, cols * sizeof(uint32));
+		}
+	} else {
+		for (int y = h - 1; y >= -dy; y--) {
+			memmove(_prevFrame + y * w + dstX, _prevFrame + (y + dy) * w + srcX, cols);
+			memmove(_prevIds + y * w + dstX, _prevIds + (y + dy) * w + srcX, cols * sizeof(uint32));
+		}
+	}
+}
+
