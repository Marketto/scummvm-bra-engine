+void PathWalker_BR::freeFoot(AnimationPtr a) {
+	if (!_vm->_gfx->_backgroundInfo->_path)
+		return;
+
+	const int w = getPathWidth(), h = getPathHeight();
+	const auto canStep = [&](int x, int y) {
+		if (x <= 0 || y <= 0 || x >= w || y >= h || !isPathClear(x, y))
+			return false;
+		int xStep, yStep;
+		stepSize(y, xStep, yStep);
+		return (x + xStep < w && isPathClear(x + xStep, y)) || (x - xStep > 0 && isPathClear(x - xStep, y)) ||
+			(y + yStep < h && isPathClear(x, y + yStep)) || (y - yStep > 0 && isPathClear(x, y - yStep));
+	};
+
+	Common::Point foot;
+	a->getFoot(foot);
+	if (canStep(foot.x, foot.y))
+		return;
+
+	// a few pixels are what the frames differ by: farther than this it isn't this case
+	const int maxDistance = 24;
+	int bestDistance = maxDistance * maxDistance + 1;
+	Common::Point best(foot);
+	for (int dy = -maxDistance; dy <= maxDistance; dy++) {
+		for (int dx = -maxDistance; dx <= maxDistance; dx++) {
+			const int distance = dx * dx + dy * dy;
+			if (distance < bestDistance && canStep(foot.x + dx, foot.y + dy)) {
+				bestDistance = distance;
+				best = Common::Point(foot.x + dx, foot.y + dy);
+			}
+		}
+	}
+	if (best != foot) {
+		debugC(1, kDebugWalk, "freeFoot: feet moved from (%i, %i) to (%i, %i)", foot.x, foot.y, best.x, best.y);
+		a->setFoot(best);
+	}
+}
