+bool PathWalker_BR::closeTo(const Common::Point &foot, const Common::Point &p) {
+	int xStep, yStep;
+	stepSize(foot.y, xStep, yStep);
+	return ABS(foot.x - p.x) <= xStep && ABS(foot.y - p.y) <= yStep;
