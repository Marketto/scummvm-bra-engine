+// Remastered balloons (BRA, HD look): the original balloon is one picture (fumetto.ani, fumdx.ani) of a fixed size, the
+// text wrapped at 216 pixels and centred: long lines went beyond the oval. Here the oval of the original picture is the
+// smallest size; it grows (away from the tail) until the text fits, the lines following its shape (shorter at the top
+// and the bottom). The 8-bit balloon gets the same shape (clicks on the answers, the original look under F8 is the
+// original picture: only balloons made in the HD look are like this), the HD renderer draws it as a vector shape.
+class OvalText : public WrappedLineFormatter {
+protected:
+	void setup() override {}
+	void action() override {}
+	void end() override {}
+
+public:
+	OvalText(Font *font) : WrappedLineFormatter(font) {}
+
+	// the text in an oval of half axes a, b: lines (and widths) or false if it does not fit
+	bool fit(const Common::String &text, float a, float b, Common::Array<Common::String> &lines, Common::Array<int> &widths) {
+		Common::Array<Common::String> tokens;
+		Common::StringTokenizer tk(text, " ");
+		while (!tk.empty()) {
+			Common::String t = expandCounter(expand(tk.nextToken()));
+			if (!t.empty())
+				tokens.push_back(t);
+		}
+		const int H = _font->height(), blank = _font->getStringWidth(" ");
+		const float pad = 7.0f, inner = b - 4.0f;
+		for (int n = 1; n * H <= 2 * inner; n++) {
+			lines.clear();
+			widths.clear();
+			uint k = 0;
+			bool ok = true;
+			for (int i = 0; i < n && ok; i++) {
+				float top = -n * H / 2.0f + i * H, bottom = top + H;
+				float ym = MAX(fabsf(top), fabsf(bottom)) / inner;
+				float avail = ym >= 1 ? 0 : 2 * a * sqrtf(1 - ym * ym) - 2 * pad;
+				Common::String line;
+				int w = 0;
+				while (k < tokens.size()) {
+					if (tokens[k] == "/") {
+						k++;
+						if (!line.empty())
+							break;
+						continue;
+					}
+					int tw = _font->getStringWidth(tokens[k].c_str());
+					int nw = line.empty() ? tw : w + blank + tw;
+					if (nw > avail) {
+						if (line.empty())
+							ok = false;	// a word longer than the line
+						break;
+					}
+					line += line.empty() ? tokens[k] : " " + tokens[k];
+					w = nw;
+					k++;
+				}
+				lines.push_back(line);
+				widths.push_back(w);
+			}
+			if (ok && k >= tokens.size()) {
+				// no empty line at the top or at the bottom
+				while (!lines.empty() && lines.back().empty()) { lines.pop_back(); widths.pop_back(); }
+				return !lines.empty() && (int)lines.size() == n;
+			}
+		}
+		return false;
+	}
+};
