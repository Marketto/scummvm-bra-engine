+void Parallaction_br::applyPendingLoad() {
+	BraSaveState *st = _pendingLoad;
+
+	g_globalFlags = st->globalFlags;
+	memcpy(_counters, st->counters, sizeof(_counters));
+
+	_numLocations = st->numLocations;
+	memcpy(_locationNames, st->locationNames, sizeof(_locationNames));
+	memcpy(_localFlags, st->localFlags, sizeof(_localFlags));
+	for (int i = 0; i < NUM_LOCATIONS; i++)
+		for (int j = 0; j < NUM_ZONES; j++)
+			_zoneFlags[i][j] = st->zoneFlags[i * NUM_ZONES + j];
+
+	Inventory *inv[3] = { _dinoInventory, _donnaInventory, _dougInventory };
+	for (int k = 0; k < 3; k++) {
+		inv[k]->clear(false);
+		for (uint i = 0; i < st->inventories[k].size(); i++)
+			inv[k]->addItem(st->inventories[k][i]._index, st->inventories[k][i]._id);
+	}
+
+	_location._startPosition = st->foot;
+	_location._startFrame = st->frame;
+	_followerName = st->follower;
+	_location._followerStartPosition = st->followerFoot;
+	_location._followerStartFrame = st->followerFrame;
+
+	if (!st->musicFile.empty())
+		_soundMan->execute(SC_SETMUSICFILE, st->musicFile.c_str());
+
+	// saved games without these lines (older ones) remember nothing
+	_partFlags = st->partFlags;
+	memset(_takenItems, 0, sizeof(_takenItems));
+	for (uint i = 0; i < st->takenItems.size(); i++)
+		markTaken(st->takenItems[i]);
+	for (int k = 0; k < 3; k++)
+		for (uint i = 0; i < st->inventories[k].size(); i++)
+			markTaken(st->inventories[k][i]._index);
+}
