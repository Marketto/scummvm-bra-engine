+void Disk_br::loadLineEdits() {
+	_lineEditsLoaded = true;
+	for (uint n = 0; n < ARRAYSIZE(kLineEditFiles); n++)
+		loadLineEdits(kLineEditFiles[n].file, kLineEditFiles[n].setting);
+	debugC(1, kDebugDisk, "%d line edits loaded", _lineEdits.size());
+}
+
+void Disk_br::loadLineEdits(const char *path, const char *setting) {
+	Common::File f;
+	if (!f.open(Common::Path(path, '/')))
+		return;
+	while (!f.eos() && !f.err()) {
+		Common::String line = f.readLine();
+		if (line.empty() || line[0] == '#')
+			continue;
+		// <part> TAB <file> TAB <original lines> TAB <new lines>   (lines separated by \n)
+		Common::StringArray w;
+		Common::String cur;
+		for (uint i = 0; i < line.size(); i++) {
+			if (line[i] == '\t') {
+				w.push_back(cur);
+				cur.clear();
+			} else if (line[i] != '\r') {
+				cur += line[i];
+			}
+		}
+		w.push_back(cur);
+		if (w.size() < 3 || w[0].empty() || !Common::isDigit(w[0][0]) || w[2].empty()) {
+			warning("%s: bad line '%s'", path, line.c_str());
+			continue;
+		}
+		LineEdit e;
+		e.source = path;
+		e.setting = setting;
+		e.part = atoi(w[0].c_str());
+		e.file = w[1];
+		e.file.trim();
+		e.file.toLowercase();
+		e.from = splitEditLines(w[2]);
+		for (uint i = 0; i < e.from.size(); i++)
+			e.from[i].trim();
+		if (w.size() > 3)
+			e.to = splitEditLines(w[3]);
+		_lineEdits.push_back(e);
+	}
+}
+
+Common::SeekableReadStream *Disk_br::applyLineEdits(Common::SeekableReadStream *stream, const Common::String &file) {
+	if (!stream)
+		return stream;
+	if (!_lineEditsLoaded)
+		loadLineEdits();
+	if (_lineEdits.empty())
+		return stream;
+	int part = -1;
+	for (uint i = 0; i < _currentPart.size(); i++) {
+		if (Common::isDigit(_currentPart[i])) {
+			part = atoi(_currentPart.c_str() + i);
+			break;
+		}
+	}
+	Common::String name(file);
+	name.toLowercase();
+	Common::Array<bool> on;
+	bool any = false;
+	for (uint i = 0; i < _lineEdits.size(); i++) {
+		const LineEdit &e = _lineEdits[i];
+		on.push_back(e.part == part && e.file == name && (e.setting.empty() || braSettingOn(e.setting.c_str())));
+		any = any || on.back();
+	}
+	if (!any)
+		return stream;
+
+	Common::StringArray lines;
+	while (!stream->eos() && !stream->err()) {
+		Common::String l = stream->readLine();
+		if (stream->eos() && l.empty())
+			break;
+		lines.push_back(l);
+	}
+	delete stream;
+
+	for (uint i = 0; i < _lineEdits.size(); i++) {
+		const LineEdit &e = _lineEdits[i];
+		if (!on[i])
+			continue;
+		int applied = 0;
+		for (uint at = 0; at + e.from.size() <= lines.size(); ) {
+			bool match = true;
+			for (uint k = 0; k < e.from.size() && match; k++) {
+				Common::String l = lines[at + k];
+				l.trim();
+				match = !l.compareToIgnoreCase(e.from[k]);
+			}
+			if (!match) {
+				at++;
+				continue;
+			}
+			Common::StringArray out;
+			for (uint k = 0; k < at; k++)
+				out.push_back(lines[k]);
+			for (uint k = 0; k < e.to.size(); k++)
+				out.push_back(e.to[k]);
+			for (uint k = at + e.from.size(); k < lines.size(); k++)
+				out.push_back(lines[k]);
+			lines = out;
+			at += e.to.size();
+			applied++;
+		}
+		debugC(1, kDebugDisk, "%s: %s '%s' applied %d times", e.source.c_str(), name.c_str(), e.from[0].c_str(), applied);
+	}
+
+	Common::String text;
+	for (uint i = 0; i < lines.size(); i++) {
+		text += lines[i];
+		text += "\r\n";
+	}
+	byte *buf = (byte *)malloc(text.size() + 1);
+	memcpy(buf, text.c_str(), text.size());
+	return new Common::MemoryReadStream(buf, text.size(), DisposeAfterUse::YES);
+}
