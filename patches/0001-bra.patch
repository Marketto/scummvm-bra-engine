+// sets a CLUT8 cursor, upscaling it when the HD renderer is active
+void Input::replaceCursor(const byte *buf, uint w, uint h, int hotX, int hotY, uint32 keyColor) {
+	HDRenderer *hd = _vm->_gfx ? _vm->_gfx->_hd : nullptr;
+	if (!hd) {
+		CursorMan.replaceCursor(buf, w, h, hotX, hotY, keyColor);
+		_cursorCopy.free();
+		_cursorWhat = Common::String::format("original %ux%u", w, h);
+		return;
+	}
+	int s = hd->scale();
+	byte *scaled = hd->scaleIndexed(buf, w, h, w);
+	Graphics::PixelFormat clut8 = Graphics::PixelFormat::createFormatCLUT8();
+	CursorMan.replaceCursor(scaled, w * s, h * s, hotX * s, hotY * s, keyColor, &clut8);
+	// a copy for the autotest, with the current palette
+	Graphics::Surface copy;
+	copy.create(w * s, h * s, HDRenderer::cursorFormat());
+	for (uint i = 0; i < w * s * h * s; i++)
+		((uint32 *)copy.getPixels())[i] = scaled[i] == keyColor ? 0 : hd->paletteARGB(scaled[i]);
+	keepCursor(copy, "scaled");
+	copy.free();
+	delete[] scaled;
+}
