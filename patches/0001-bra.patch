+	_vm->_dialogueFont->setColor(color);
+	for (uint i = 0; i < lines.size(); i++) {
+		if (lines[i].empty())
+			continue;
+		int x = (int)(sh.cx - widths[i] / 2.0f + 0.5f);
+		int y = (int)(sh.cy - lines.size() * H / 2.0f + i * H + 0.5f);
+		_vm->_dialogueFont->drawString(surf, x, y, lines[i].c_str());
