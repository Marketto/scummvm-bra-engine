+			for (uint i = 0; i < br->partFlags().size(); i++)
+				l += " " + br->partFlags()[i];
+			debug("AutoTest: flag-parti%s", l.c_str());
+		} else if (c == "cond" && _vm->getGameType() == GType_BRA) {
+			// a condition of the hints, evaluated now: "cond INV:dino:anello ZONA:camalb:numero"
+			Common::String cond;
+			for (uint i = 1; i < tok.size(); i++)
+				if (!tok[i].empty())
+					cond += (cond.empty() ? "" : " ") + tok[i];
+			debug("AutoTest: cond %s = %d", cond.c_str(), ((Parallaction_br *)_vm)->hintCondition(cond) ? 1 : 0);
+		} else if (c == "quit") {
+			_vm->quitGame();
+			return;
+		}
+	}
+	_active = false;
+}
