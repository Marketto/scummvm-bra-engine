+struct HintEntry {
+	int part;
+	Common::String title, done, situation, hint, solution;
+};
+
+static Common::Array<HintEntry> loadHints(const char *lang) {
+	Common::Array<HintEntry> list;
+	Common::File f;
+	if (!f.open(Common::Path(Common::String::format("hint/%s.txt", lang), '/')))
+		return list;
+	int part = -1;
+	HintEntry cur;
+	bool open = false;
+	while (!f.eos() && !f.err()) {
+		Common::String line = f.readLine();
+		line.trim();
+		if (line.empty()) {
+			if (open && !cur.title.empty())
+				list.push_back(cur);
+			open = false;
+			continue;
+		}
+		if (line[0] == '#')
+			continue;
+		if (line.hasPrefix("@parte")) {
+			if (open && !cur.title.empty())
+				list.push_back(cur);
+			open = false;
+			part = atoi(line.c_str() + 6);
+			continue;
+		}
+		int colon = line.findFirstOf(':');
+		if (colon <= 0)
+			continue;
+		Common::String key(line.c_str(), colon);
+		Common::String val = line.substr(colon + 1);
+		val.trim();
+		if (!open) {
+			cur = HintEntry();
+			cur.part = part;
+			open = true;
+		}
+		if (key == "obiettivo" || key == "objective")
+			cur.title = val;
+		else if (key == "fatto" || key == "done")
+			cur.done = val;
+		else if (key == "situazione" || key == "situation")
+			cur.situation = val;
+		else if (key == "indizio" || key == "hint")
+			cur.hint = val;
+		else if (key == "soluzione" || key == "solution")
+			cur.solution = val;
+	}
+	if (open && !cur.title.empty())
+		list.push_back(cur);
+	return list;
+}
