+// the game's language (0 it, 1 fr, 2 en, 3 de)
+static uint gameLanguage() {
+	return g_engine ? ((Parallaction *)g_engine)->getInternLanguage() : 0;
+}
+
+static bool italian() {
+	return gameLanguage() == 0;
+}
+
+// the words of the game's own menus in the game's language (UTF-8); English when a language has none
+static Common::U32String T(const char *it, const char *en, const char *fr = nullptr, const char *de = nullptr) {
+	const char *t = en;
+	switch (gameLanguage()) {
+	case 0: t = it; break;
+	case 1: t = fr ? fr : en; break;
+	case 3: t = de ? de : en; break;
+	default: break;
+	}
+	return Common::U32String(t, Common::kUtf8);
+}
+
+static void paintRays(Graphics::ManagedSurface &s, int w, int h) {
+	Graphics::Surface t;
+	hdPaintRays(t, g_system->getOverlayFormat(), w, h, 0.22f, 0.35f);
+	s.copyFrom(t);
+	t.free();
+}
+
+// The rays of a dialog, inside its 3 pixel red frame, drawn with its background (under the widgets)
+class Rays {
+	Graphics::ManagedSurface _s;
+	Common::Point _at;
+
+public:
+	void place(GUI::Dialog *d) {
+		int in = (int)ceilf(3 * g_gui.getScaleFactor());
+		int w = d->getWidth() - 2 * in, h = d->getHeight() - 2 * in;
+		if (w <= 0 || h <= 0)
+			return;
+		_at = Common::Point(in, in);
+		if (_s.w != w || _s.h != h)
+			paintRays(_s, w, h);
+	}
+
+	void draw(GUI::Dialog *d) {
+		if (_s.w)
+			g_gui.theme()->drawManagedSurfaceBackground(Common::Point(d->getAbsX() + _at.x, d->getAbsY() + _at.y), _s);
+	}
+};
