+namespace Parallaction {
+
+/* ---------------- host ---------------- */
+
+namespace Host {
+
+#if !defined(__EMSCRIPTEN__) && defined(POSIX)
+// The Mac app starts the native engine with BRA_HOST=1 and talks over the standard streams:
+// "BRA> command" lines out, "BRA< dropbox state" lines in (read without waiting)
+static bool hosted() {
+	static int h = -1;
+	if (h < 0) {
+		const char *e = getenv("BRA_HOST");
+		h = e && *e == '1';
+		if (h)
+			fcntl(0, F_SETFL, fcntl(0, F_GETFL) | O_NONBLOCK);
+	}
+	return h == 1;
+}
+// function statics: no global constructors
+static Common::String &stateLine() { static Common::String s; return s; }
+static Common::String &partialLine() { static Common::String s; return s; }
+#endif
+
+void send(const Common::String &cmd) {
+#ifdef __EMSCRIPTEN__
+	EM_ASM({ if (typeof window.braMotore === 'function') window.braMotore(UTF8ToString($0)); }, cmd.c_str());
+#elif defined(POSIX)
+	if (!hosted())
+		return;
+	fprintf(stdout, "\nBRA> %s\n", cmd.c_str());
+	fflush(stdout);
+#endif
+}
+
+// a launcher page or app runs the engine (it keeps the settings it passes on the command line)
+bool present() {
+#ifdef __EMSCRIPTEN__
+	return EM_ASM_INT({ return typeof window.braMotore === 'function' ? 1 : 0; }) != 0;
+#elif defined(POSIX)
+	return hosted();
+#else
+	return false;
+#endif
+}
+
+Common::String dropboxState() {
+#ifdef __EMSCRIPTEN__
+	char *s = (char *)EM_ASM_PTR({
+		var t = typeof window.braMotoreStato === 'function' ? String(window.braMotoreStato() || '') : '';
+		var n = lengthBytesUTF8(t) + 1;
+		var p = _malloc(n);
+		stringToUTF8(t, p, n);
+		return p;
+	});
+	Common::String r(s ? s : "");
+	free(s);
+	return r;
+#elif defined(POSIX)
+	if (!hosted())
+		return Common::String();
+	char buf[1024];
+	ssize_t n;
+	while ((n = read(0, buf, sizeof(buf))) > 0) {
+		Common::String &partial = partialLine();
+		partial += Common::String(buf, n);
+		int nl;
+		while ((nl = partial.find('\n')) >= 0) {
+			Common::String line = partial.substr(0, nl);
+			partial = partial.substr(nl + 1);
+			if (line.hasPrefix("BRA< "))
+				stateLine() = line.substr(5);
+		}
+	}
+	return stateLine();
+#else
+	return Common::String();
+#endif
+}
+
+void announce() {
+	bool on = !ConfMan.hasKey("bra_scorciatoie") || ConfMan.getBool("bra_scorciatoie");
+	send(on ? "scorciatoie 1" : "scorciatoie 0");
+	send("dropbox-stato");
+}
