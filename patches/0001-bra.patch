+	}
+
+	writeLine(f, _vm->_soundManI ? _vm->_soundManI->getMusicFile() : Common::String());
+
+	// optional lines, only when not empty: older engines stop reading before them
+	const Common::StringArray &pf = _vm->partFlags();
+	if (!pf.empty()) {
+		Common::String l("flag-parti:");
+		for (uint i = 0; i < pf.size(); i++)
+			l += " " + pf[i];
+		writeLine(f, l);
+	}
+	Common::Array<uint16> taken = _vm->takenItems();
+	if (!taken.empty()) {
+		Common::String l("preso:");
+		for (uint i = 0; i < taken.size(); i++)
+			l += Common::String::format(" %u", taken[i]);
+		writeLine(f, l);
+	}
+
+	// date, play time and thumbnail for the ScummVM save/load dialogs; the
+	// thumbnail comes from the game screen (HD and 16:9 included), the ScummVM
+	// menu is drawn on the overlay and does not appear in it
+	_vm->getMetaEngine()->appendExtendedSaveToStream(f, _vm->getTotalPlayTime(), desc, false);
+
+	f->finalize();
+	delete f;
 }
 
+void SaveLoad_br::doLoadGame(uint16 slot) {
+	Common::InSaveFile *f = getInSaveFile(slot);
+	if (!f)
+		return;
+
+	f->readLine();	// description
+	Common::String tag = f->readLine();
+	int version = 0;
+	if (!tag.hasPrefix(BRA_SAVE_TAG) || (version = atoi(tag.c_str() + strlen(BRA_SAVE_TAG))) > BRA_SAVE_VERSION || version < 1) {
+		warning("SaveLoad_br: slot %d is not a valid saved game", slot);
+		delete f;
+		return;
+	}
+
+	BraSaveState *st = new BraSaveState;
+	int part = readInt(f);
+	st->location = f->readLine();
+	st->character = f->readLine();
+	int x = 0, y = 0, fr = 0;
+	sscanf(f->readLine().c_str(), "%d %d %d", &x, &y, &fr);
+	st->foot = Common::Point(x, y);
+	st->frame = fr;
+	st->follower = f->readLine();
+	sscanf(f->readLine().c_str(), "%d %d %d", &x, &y, &fr);
+	st->followerFoot = Common::Point(x, y);
+	st->followerFrame = fr;
+	st->globalFlags = strtoul(f->readLine().c_str(), nullptr, 10);
+	for (int i = 0; i < 32; i++)
+		st->counters[i] = readInt(f);
+
+	st->numLocations = CLIP(readInt(f), 0, NUM_LOCATIONS);
+	memset(st->locationNames, 0, sizeof(st->locationNames));
+	memset(st->localFlags, 0, sizeof(st->localFlags));
+	st->zoneFlags.resize(NUM_LOCATIONS * NUM_ZONES);
+	for (uint i = 0; i < st->zoneFlags.size(); i++)
+		st->zoneFlags[i] = 0;
+	for (int i = 0; i < st->numLocations; i++) {
+		Common::strlcpy(st->locationNames[i], f->readLine().c_str(), 32);
+		st->localFlags[i] = strtoul(f->readLine().c_str(), nullptr, 10);
+		Common::String zf = f->readLine();
+		const char *p = zf.c_str();
+		for (int j = 0; j < NUM_ZONES && *p; j++) {
+			char *e;
+			st->zoneFlags[i * NUM_ZONES + j] = strtoul(p, &e, 10);
+			if (e == p)
+				break;
+			p = e;
+		}
+	}
+
+	for (int k = 0; k < 3; k++) {
+		int n = readInt(f);
+		for (int i = 0; i < n; i++) {
+			InventoryItem item;
+			uint id = 0, index = 0;
+			sscanf(f->readLine().c_str(), "%u %u", &id, &index);
+			item._id = id;
+			item._index = index;
+			st->inventories[k].push_back(item);
+		}
+	}
+	st->musicFile = f->readLine();
+
+	// optional lines (flag-parti:, preso:), before the extended header (its offset is in the last 4 bytes)
+	{
+		int64 start = f->pos();
+		int64 limit = f->size();
+		if (f->size() >= 8) {
+			f->seek(-4, SEEK_END);
+			uint32 off = f->readUint32LE();
+			if (off > (uint32)start && off < (uint32)f->size())
+				limit = off;
+		}
+		f->seek(start, SEEK_SET);
+		while (!f->eos() && !f->err() && f->pos() < limit) {
+			int64 at = f->pos();
+			Common::String l = f->readLine();
+			if (l.hasPrefix("flag-parti:")) {
+				Common::StringTokenizer tok(l.c_str() + 11, " ");
+				while (!tok.empty()) {
+					Common::String w = tok.nextToken();
+					if (!w.empty())
+						st->partFlags.push_back(w);
+				}
+			} else if (l.hasPrefix("preso:")) {
+				Common::StringTokenizer tok(l.c_str() + 6, " ");
+				while (!tok.empty()) {
+					Common::String w = tok.nextToken();
+					if (!w.empty())
+						st->takenItems.push_back(atoi(w.c_str()));
+				}
+			} else {
+				f->seek(at, SEEK_SET);
+				break;
+			}
+		}
+		f->clearErr();
+	}
+
+	// play time from the extended header, when the file has one
+	ExtendedSavegameHeader header;
+	bool hasHeader = MetaEngine::readSavegameHeader(f, &header, true);
+
+	if (f->err()) {
+		warning("SaveLoad_br: error reading slot %d", slot);
+		delete st;
+		delete f;
+		return;
+	}
+	delete f;
+
+	if (hasHeader)
+		_vm->setTotalPlayTime(header.playtime);
+
+	debugC(1, kDebugExec, "SaveLoad_br: loading slot %d: part %d, location %s, character %s", slot, part, st->location.c_str(), st->character.c_str());
+
+	// The state is applied by changeLocation(), once the saved part is loaded
+	delete _vm->_pendingLoad;
+	_vm->_pendingLoad = st;
+	_vm->_nextPart = part;
+	_vm->_input->_inputMode = Input::kInputModeGame;
+	_vm->scheduleLocationSwitch(st->location.c_str());
+}
