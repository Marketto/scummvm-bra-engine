+// bit of a local flag of a location (LOCALFLAGS line of its script, after the fixed "visited" and
+// "testtrue" entries of BRA), 0 if unknown. The names of the current location are already loaded; for
+// another one the script is read.
+uint32 Parallaction_br::hintLocalFlag(const Common::String &loc, const Common::String &flag) {
+	if (!scumm_stricmp(flag.c_str(), "visited"))
+		return kFlagsVisited;
+	if (!scumm_stricmp(flag.c_str(), "testtrue"))
+		return kFlagsTestTrue;
+	if (!scumm_stricmp(_location._name, loc.c_str())) {
+		uint16 i = _localFlagNames->lookup(flag.c_str());
+		return i == Table::notFound ? 0 : 1u << (i - 1);
+	}
+	Script *script = _disk->loadLocation(loc.c_str());
+	uint32 bit = 0;
+	char buf[400];
+	while (char *line = script->readLine(buf, sizeof(buf) - 1)) {
+		Common::StringTokenizer tok(line, " \t");
+		if (scumm_stricmp(tok.nextToken().c_str(), "LOCALFLAGS"))
+			continue;
+		for (int n = 3; !tok.empty(); n++)
+			if (!scumm_stricmp(tok.nextToken().c_str(), flag.c_str())) {
+				bit = 1u << (n - 1);
+				break;
+			}
+		break;
+	}
+	delete script;
+	return bit;
+}
+
+// the index the location parser gives a zone or an animation of a location (1 for the first ZONE or ANIMATION of
+// its script, in order), 0 if the script has none with that name
+static uint16 zoneIndexInScript(Script *script, const Common::String &zone) {
+	uint16 prog = 0;
+	char buf[400];
+	const char *end = nullptr;
+	while (char *line = script->readLine(buf, sizeof(buf) - 1)) {
+		Common::StringTokenizer tok(line, " \t");
+		Common::String w = tok.nextToken();
+		if (end) {
+			if (!scumm_stricmp(w.c_str(), end))
+				end = nullptr;
+			continue;
+		}
+		bool isZone = !scumm_stricmp(w.c_str(), "ZONE"), isAnim = !scumm_stricmp(w.c_str(), "ANIMATION");
+		if (!isZone && !isAnim)
+			continue;
+		prog++;
+		if (!scumm_stricmp(tok.nextToken().c_str(), zone.c_str()))
+			return prog;
+		end = isZone ? "ENDZONE" : "ENDANIMATION";
+	}
+	return 0;
+}
