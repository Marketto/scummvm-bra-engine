+/*
+	Music sources, by the name of the MSC piece (.flac/.mp3/.wav work too):
+	- Remastered mode: music/remaster/<name>.ogg if present, else the CD track
+	  of the piece, else the digital replacement music/<name>.ogg, else MIDI;
+	- Original mode (F8, hd_classic): the CD track, else the MSC file through
+	  the MIDI/AdLib driver.
+*/
+static Common::String musicBaseName(const Common::String &name) {
+	Common::String base(name);
+	int dot = base.findFirstOf('.');
+	if (dot != -1)
+		base = Common::String(base.c_str(), dot);
+	base.toLowercase();
+	return base;
+}
+
+static bool remasteredMusic() {
+	// original graphics (F8): original music too
+	return !(ConfMan.hasKey("hd_classic") && ConfMan.getBool("hd_classic"));
+}
+
+static Audio::SeekableAudioStream *openRemaster(const Common::String &base) {
+	return Audio::SeekableAudioStream::openStreamFile(Common::Path("music/remaster/" + base, '/'));
+}
+
+bool DosSoundMan_br::hasRemaster() const {
+	Common::String base = musicBaseName(_musicFile);
+	if (base.empty() || !remasteredMusic())
+		return false;
+	Audio::SeekableAudioStream *stream = openRemaster(base);
+	delete stream;
+	return stream != nullptr;
+}
+
+// Remastered mode only: the remastered piece, or (pieces without a CD track)
+// the digital replacement of the MIDI piece
+bool DosSoundMan_br::playDigital(bool restart) {
+	Common::String base = musicBaseName(_musicFile);
+	if (base.empty() || !_musicEnabled || !remasteredMusic())
+		return false;
+	if (!restart && _digitalActive && _digitalName == base && _mixer->isSoundHandleActive(_digitalHandle))
+		return true;
+
+	const char *kind = "remastered";
+	Audio::SeekableAudioStream *stream = openRemaster(base);
+	if (!stream && !_cdTrack) {
+		kind = "digital";
+		stream = Audio::SeekableAudioStream::openStreamFile(Common::Path("music/" + base, '/'));
+	}
+	if (!stream)
+		return false;
+
+	stopDigital();
+	stopCDTrack();
+	_midiPlayer->stop();
+	debugC(1, kDebugAudio, "DosSoundMan_br: playing %s music %s (loop %d, from %u ms)", kind, base.c_str(), _musicLoop, _resumeMs);
+	_digitalLength = stream->getLength().msecs();
+	bool seeked = false;
+	if (_resumeMs && _digitalLength) {
+		uint32 at = _musicLoop ? _resumeMs % _digitalLength : MIN(_resumeMs, _digitalLength);
+		seeked = stream->seek(Audio::Timestamp(at, 1000));
+		_digitalStartOffset = seeked ? at : 0;
+	} else {
+		_digitalStartOffset = 0;
+	}
+	// no rewind when it starts from the middle (Remastered/Original switch)
+	Audio::AudioStream *s = _musicLoop ? (Audio::AudioStream *)new Audio::LoopingAudioStream(stream, 0, DisposeAfterUse::YES, !seeked)
+		: (Audio::AudioStream *)stream;
+	_mixer->playStream(Audio::Mixer::kMusicSoundType, &_digitalHandle, s, -1, _musicVolume);
+	_digitalActive = true;
+	_digitalName = base;
+	_digitalSource = kind;
+	return true;
+}
+
+void DosSoundMan_br::stopDigital() {
+	if (_digitalActive) {
+		_mixer->stopHandle(_digitalHandle);
+		_digitalActive = false;
+		_digitalName.clear();
+	}
+}
+
+int DosSoundMan_br::lookupCDTrack(const Common::String &name) const {
+	if (!_hasCDAudio)
+		return 0;
+	// the original strips the extension (strtok on '.')
+	Common::String base(name);
+	int dot = base.findFirstOf('.');
+	if (dot != -1)
+		base = Common::String(base.c_str(), dot);
+	for (uint i = 0; i < ARRAYSIZE(kCDMusicNames); i++) {
+		if (!base.compareToIgnoreCase(kCDMusicNames[i]))
+			return i + 2;
+	}
+	return 0;
+}
+
+// Plays the piece of a CD track: its remastered version in Remastered mode,
+// if the patch has one, otherwise the CD track.
+void DosSoundMan_br::playCDTrack(bool restart) {
+	if (!_cdTrack || !_musicEnabled)
+		return;
+	if (playDigital(restart))
+		return;
+	AudioCDManager *cd = g_system->getAudioCDManager();
+	if (!restart && _cdPlayingTrack == _cdTrack && cd->isPlaying())
+		return;	// keep the music flowing across locations
+	stopDigital();
+	uint32 at = _resumeMs;
+	if (at && _musicLoop) {
+		uint32 len = cdTrackLength(_cdTrack);
+		at = len ? at % len : 0;
+	}
+	debugC(1, kDebugAudio, "DosSoundMan_br: playing CD track %d (loop %d, from %u ms)", _cdTrack, _musicLoop, at);
+	// the CD manager loops from the start frame: a looping piece resumed from the middle plays
+	// once to the end, then update() starts it again from the beginning, looping
+	cd->play(_cdTrack, (_musicLoop && !at) ? -1 : 1, at * 75 / 1000, 0, false, Audio::Mixer::kMusicSoundType);
+	cd->setVolume(_musicVolume);
+	_cdPlayingTrack = _cdTrack;
+	_cdLoopPending = _musicLoop && at;
+	_cdStartTime = _vm->getTotalPlayTime();
+	_cdStartOffset = at;
+}
+
+void DosSoundMan_br::stopCDTrack() {
+	if (_cdPlayingTrack) {
+		g_system->getAudioCDManager()->stop();
+		_cdPlayingTrack = 0;
+	}
+	_cdLoopPending = false;
+}
+
+// length in ms of an extracted CD track, 0 if unknown (cached for the last track asked)
+uint32 DosSoundMan_br::cdTrackLength(int track) {
+	if (track == _cdLengthTrack)
+		return _cdLength;
+	_cdLengthTrack = track;
+	_cdLength = 0;
+	const char *const names[] = { "track%02d", "track%d", "track_%02d", "track_%d" };
+	for (uint i = 0; i < ARRAYSIZE(names) && !_cdLength; i++) {
+		Audio::SeekableAudioStream *s = Audio::SeekableAudioStream::openStreamFile(
+			Common::Path(Common::String::format(names[i], track), '/'));
+		if (s)
+			_cdLength = s->getLength().msecs();
+		delete s;
+	}
+	return _cdLength;
+}
+
+void DosSoundMan_br::update() {
+	if (!_cdPlayingTrack)
+		return;
+	AudioCDManager *cd = g_system->getAudioCDManager();
+	cd->update();
+	if (_cdLoopPending && !cd->isPlaying()) {
+		// end of a looping track resumed from the middle: loop it from the start
+		_cdLoopPending = false;
+		debugC(1, kDebugAudio, "DosSoundMan_br: looping CD track %d from the start", _cdPlayingTrack);
+		cd->play(_cdPlayingTrack, -1, 0, 0, false, Audio::Mixer::kMusicSoundType);
+		cd->setVolume(_musicVolume);
+		_cdStartTime = _vm->getTotalPlayTime();
+		_cdStartOffset = 0;
+	}
+}
+
+void DosSoundMan_br::locationMusic() {
+	// The original restarts the CD track at the end of every location change.
+	// We only (re)start it if it is not already playing, so music continues
+	// seamlessly from room to room. MIDI music is started by MUSIC PLAY.
+	if (_musicFile.empty())
+		return;
+	_cdTrack = lookupCDTrack(_musicFile);
+	if (_cdTrack) {
+		playCDTrack(false);
+	}
+}
+
+void DosSoundMan_br::musicCommand(int cmd, int parm) {
+	enum { kPlay = 1, kStop = 2, kPause = 3, kFadeIn = 5, kFadeOut = 6, kVolume = 7, kLoop = 17 };
+
+	switch (cmd) {
+	case kPlay:
+		_musicWanted = true;
+		break;
+	case kStop:
+		_musicWanted = false;
+		break;
+	case kLoop:
+		if (_musicLoop == (parm != 0) && ((_digitalActive && _mixer->isSoundHandleActive(_digitalHandle)) || _cdPlayingTrack)) {
+			// same piece, same mode, already playing (the film of the intro repeats MUSIC LOOP
+			// in every scene): don't restart it from the beginning
+			return;
+		}
+		_musicLoop = (parm != 0);
+		break;
+	case kVolume:
+		// the intro lowers the music under the narrator (MUSIC VOLUME 40): the CD tracks and the
+		// digital replacements ignored it, so the music covered the voice
+		_musicVolume = CLIP(parm * 255 / 127, 0, 255);
+		if (_cdPlayingTrack)
+			g_system->getAudioCDManager()->setVolume(_musicVolume);
+		if (_digitalActive)
+			_mixer->setChannelVolume(_digitalHandle, _musicVolume);
+		break;
+	default:
+		break;
+	}
+
+	if (_cdTrack) {
+		switch (cmd) {
+		case kPlay:
+			// the original restarts the track here; rooms with the same piece (hall and hotel
+			// room say MUSIC PLAY on entry) must go on from where it is
+			_midiPlayer->stop();
+			playCDTrack(false);
+			break;
+		case kStop:
+			// the original clears the current CD track: it won't restart
+			// until a location declares a new MUSIC
+			stopCDTrack();
+			stopDigital();
+			_cdTrack = 0;
+			_musicFile.clear();
+			break;
+		case kLoop:
+			// the original restarts the track for every MUSIC command; we just
+			// re-arm it with the new looping mode if it is playing
+			if (_cdPlayingTrack || _digitalActive)
+				playCDTrack(true);
+			break;
+		case kFadeOut:
+			// TODO: real fade; the CD driver had no fading either
+			break;
+		default:
+			break;
+		}
+		return;
+	}
+
+	switch (cmd) {
+	case kPlay:
+		// same piece already playing (setMusicFile stops any other): don't restart it
+		if (!_midiPlayer->isPlaying())
+			playMusic();
+		break;
+	case kStop:
+		stopMusic();
+		break;
+	case kPause:
+		pause(parm != 0);
+		break;
+	case kLoop:
+		if (_digitalActive)
+			playDigital(true);
+		break;
+	case kVolume:
+		_midiPlayer->setVolume(_musicVolume);
+		break;
+	default:
+		debugC(1, kDebugAudio, "DosSoundMan_br: unhandled MIDI command %d (%d)", cmd, parm);
+		break;
+	}
+}
