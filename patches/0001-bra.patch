+
+/*
+ * In-game manual (key M, BRA). manual/<language>.txt in the game folder lists the page images
+ * (JPEG or PNG, paths relative to manual/) in reading order, one per line, '#' comments; the
+ * engine knows nothing about the pages themselves. Shown as an open booklet at the resolution of
+ * the overlay: the first page alone on the right, then two pages side by side (one at a time when
+ * two do not fit). A click on a page shows it at the width of the screen, scrolled by dragging,
+ * the wheel or the arrow keys. The game is paused (runDialog) while the manual is open.
+ * Format in docs/formati.md of the remaster project.
+ */
+
+#include "common/file.h"
+#include "common/str-array.h"
+#include "common/system.h"
+#include "graphics/font.h"
+#include "graphics/managed_surface.h"
+#include "gui/dialog.h"
+#include "gui/gui-manager.h"
+#include "gui/ThemeEngine.h"
+#include "gui/widget.h"
+#include "image/jpeg.h"
+#include "image/png.h"
+
+#include "parallaction/parallaction.h"
+
+namespace Parallaction {
+
+// R, G, B, A from the top byte down
+static const Graphics::PixelFormat kManualFormat(4, 8, 8, 8, 8, 24, 16, 8, 0);
+
+static Common::StringArray loadManualList(const char *lang) {
+	Common::StringArray pages;
+	Common::File f;
+	if (!f.open(Common::Path(Common::String::format("manual/%s.txt", lang), '/')))
+		return pages;
+	while (!f.eos() && !f.err()) {
+		Common::String line = f.readLine();
+		line.trim();
+		if (line.empty() || line[0] == '#' || line.contains(".."))
+			continue;
+		pages.push_back(line);
+	}
+	return pages;
+}
+
+// a page image in kManualFormat (nullptr if missing or unreadable)
+static Graphics::Surface *decodeManualPage(const Common::String &name) {
+	Common::File f;
+	if (!f.open(Common::Path("manual/" + name, '/'))) {
+		warning("Manual: cannot open manual/%s", name.c_str());
+		return nullptr;
+	}
+	Image::PNGDecoder png;
+	Image::JPEGDecoder jpeg;
+	jpeg.setOutputPixelFormat(kManualFormat);
+	Image::ImageDecoder *dec = &jpeg;
+	if (name.hasSuffixIgnoreCase(".png"))
+		dec = &png;
+	if (!dec->loadStream(f) || !dec->getSurface()) {
+		warning("Manual: cannot decode manual/%s", name.c_str());
+		return nullptr;
+	}
+	return dec->getSurface()->convertTo(kManualFormat, dec->getPalette().data(), dec->getPalette().size());
+}
+
+// Separable resampling: a tent filter as wide as the scale factor (area-like when shrinking, so the
+// small print stays readable; bilinear when enlarging). Weights in 1/16384.
+struct ManualTaps {
+	Common::Array<int> first, num, wt;
+	int stride = 0;
+
+	void make(int sn, int dn) {
+		double ratio = (double)sn / dn;
+		double r = MAX(1.0, ratio);
+		stride = (int)ceil(r) * 2 + 2;
+		first.resize(dn);
+		num.resize(dn);
+		wt.resize(dn * stride);
+		Common::Array<double> w(stride);
+		for (int i = 0; i < dn; i++) {
+			double c = (i + 0.5) * ratio - 0.5;
+			int a = MAX(0, (int)floor(c - r) + 1), b = MIN(sn - 1, (int)floor(c + r));
+			if (b < a)
+				a = b = CLIP((int)(c + 0.5), 0, sn - 1);
+			int n = MIN(b - a + 1, stride);
+			double sum = 0;
+			for (int k = 0; k < n; k++) {
+				w[k] = MAX(0.0, 1.0 - fabs(a + k - c) / r);
+				sum += w[k];
+			}
+			first[i] = a;
+			num[i] = n;
+			for (int k = 0; k < n; k++)
+				wt[i * stride + k] = sum > 0 ? (int)(w[k] / sum * 16384 + 0.5) : (k == 0 ? 16384 : 0);
+		}
+	}
+};
+
+// horizontal pass: src (kManualFormat) -> RGB, dw x src.h
+static void manualScaleRows(const Graphics::Surface &src, int dw, Common::Array<byte> &out) {
+	ManualTaps t;
+	t.make(src.w, dw);
+	out.resize(dw * src.h * 3);
+	for (int y = 0; y < src.h; y++) {
+		const uint32 *row = (const uint32 *)src.getBasePtr(0, y);
+		byte *o = &out[y * dw * 3];
+		for (int x = 0; x < dw; x++) {
+			int r = 0, g = 0, b = 0;
+			const int *w = &t.wt[x * t.stride];
+			const uint32 *p = row + t.first[x];
+			for (int k = 0; k < t.num[x]; k++) {
+				uint32 c = p[k];
+				r += (c >> 24) * w[k];
+				g += ((c >> 16) & 0xff) * w[k];
+				b += ((c >> 8) & 0xff) * w[k];
+			}
+			*o++ = CLIP((r + 8192) >> 14, 0, 255);
+			*o++ = CLIP((g + 8192) >> 14, 0, 255);
+			*o++ = CLIP((b + 8192) >> 14, 0, 255);
+		}
+	}
+}
+
+// vertical pass for the output rows [y0, y1) of a dw x dh image, into dst at (dx, dy)
+static void manualScaleCols(const Common::Array<byte> &rows, int dw, const ManualTaps &t, int y0, int y1,
+		Graphics::ManagedSurface &dst, int dx, int dy) {
+	for (int y = y0; y < y1; y++) {
+		int ty = dy + y - y0;
+		if (ty < 0 || ty >= dst.h)
+			continue;
+		uint32 *o = (uint32 *)dst.getBasePtr(0, ty);
+		const int *w = &t.wt[y * t.stride];
+		for (int x = 0; x < dw; x++) {
+			int tx = dx + x;
+			if (tx < 0 || tx >= dst.w)
+				continue;
+			int r = 0, g = 0, b = 0;
+			for (int k = 0; k < t.num[y]; k++) {
+				const byte *p = &rows[((t.first[y] + k) * dw + x) * 3];
+				r += p[0] * w[k];
+				g += p[1] * w[k];
+				b += p[2] * w[k];
+			}
+			o[tx] = kManualFormat.RGBToColor(CLIP((r + 8192) >> 14, 0, 255), CLIP((g + 8192) >> 14, 0, 255), CLIP((b + 8192) >> 14, 0, 255));
+		}
+	}
+}
+
+class ManualView : public GUI::Widget {
+public:
+	ManualView(GUI::GuiObject *boss) : GUI::Widget(boss, 0, 0, 1, 1, false) {
+		setFlags(GUI::WIDGET_ENABLED);
+	}
+	Graphics::ManagedSurface _surf;
+
+	void drawWidget() override {
+		if (_surf.getPixels())
+			g_gui.theme()->drawManagedSurface(Common::Point(_x, _y), _surf, Graphics::ALPHA_OPAQUE);
+	}
+};
+
+class ManualDialog : public GUI::Dialog {
+public:
+	ManualDialog(const Common::StringArray &pages) : GUI::Dialog(0, 0, 16, 16), _pages(pages) {
+		_backgroundType = GUI::ThemeEngine::kDialogBackgroundNone;
+		_view = new ManualView(this);
+		_openTime = g_system->getMillis();
+		layout();
+	}
+
+	~ManualDialog() override {
+		clearCache();
+	}
+
+	void reflowLayout() override {
+		GUI::Dialog::reflowLayout();
+		// called when the dialog opens too: start again only if the overlay changed size
+		if (_W == (int)g_system->getOverlayWidth() && _H == (int)g_system->getOverlayHeight()) {
+			_x = _y = 0;
+			_w = _W;
+			_h = _H;
+			_view->resize(0, 0, _W, _H, false);
+			return;
+		}
+		int page = firstPage();
+		clearCache();
+		layout();
+		_pos = viewOf(page);
+		if (_zoom >= 0)
+			enterZoom(_zoom);
+		redraw();
+	}
+
+	void handleKeyDown(Common::KeyState state) override {
+		switch (state.keycode) {
+		case Common::KEYCODE_ESCAPE:
+			if (_zoom >= 0)
+				leaveZoom();
+			else
+				close();
+			return;
+		case Common::KEYCODE_m:
+			// the key that opened the manual, if held, repeats: not a request to close it
+			if (g_system->getMillis() - _openTime > 400)
+				close();
+			return;
+		case Common::KEYCODE_LEFT:
+		case Common::KEYCODE_KP4:
+			turn(-1);
+			return;
+		case Common::KEYCODE_RIGHT:
+		case Common::KEYCODE_KP6:
+			turn(1);
+			return;
+		case Common::KEYCODE_UP:
+		case Common::KEYCODE_KP8:
+			if (_zoom >= 0) scrollBy(-_H / 8); else turn(-1);
+			return;
+		case Common::KEYCODE_DOWN:
+		case Common::KEYCODE_KP2:
+			if (_zoom >= 0) scrollBy(_H / 8); else turn(1);
+			return;
+		case Common::KEYCODE_PAGEUP:
+		case Common::KEYCODE_BACKSPACE:
+			if (_zoom >= 0) scrollBy(-_H * 9 / 10); else turn(-1);
+			return;
+		case Common::KEYCODE_PAGEDOWN:
+		case Common::KEYCODE_SPACE:
+			if (_zoom >= 0) scrollBy(_H * 9 / 10); else turn(1);
+			return;
+		case Common::KEYCODE_HOME:
+			if (_zoom >= 0) scrollBy(-_zoomH); else show(0);
+			return;
+		case Common::KEYCODE_END:
+			if (_zoom >= 0) scrollBy(_zoomH); else show(numViews() - 1);
+			return;
+		case Common::KEYCODE_RETURN:
+		case Common::KEYCODE_KP_ENTER:
+			if (_zoom >= 0) leaveZoom(); else enterZoom(firstPage());
+			return;
+		default:
+			break;
+		}
+	}
+
+	void handleMouseDown(int x, int y, int button, int clickCount) override {
+		if (button != 1)
+			return;
+		_pressed = true;
+		_dragged = false;
+		_downX = x;
+		_downY = y;
+		_downScroll = _zoomY;
+		_downPan = _zoomX;
+	}
+
+	void handleMouseMoved(int x, int y, int button) override {
+		if (!_pressed)
+			return;
+		if (ABS(x - _downX) > _slop || ABS(y - _downY) > _slop)
+			_dragged = true;
+		if (_zoom >= 0 && _dragged)
+			scrollTo(_downScroll - (y - _downY), _downPan - (x - _downX));
+	}
+
+	void handleMouseUp(int x, int y, int button, int clickCount) override {
+		if (button == 2) {
+			// right button: one step back, like Esc
+			if (_zoom >= 0)
+				leaveZoom();
+			else
+				close();
+			return;
+		}
+		if (!_pressed)
+			return;
+		_pressed = false;
+		if (ABS(x - _downX) > _slop || ABS(y - _downY) > _slop)
+			_dragged = true;
+		if (_zoom >= 0) {
+			if (!_dragged)
+				leaveZoom();
+			else
+				debug("MANUAL: page %d/%d zoomed %dx%d, scroll %d,%d", _zoom + 1, numPages(), _zoomW, _zoomH, _zoomX, _zoomY);
+			return;
+		}
+		int dx = x - _downX, dy = y - _downY;
+		if (_dragged) {
+			// a horizontal swipe turns the page (touch screens)
+			if (ABS(dx) > _W / 12 && ABS(dx) > ABS(dy))
+				turn(dx < 0 ? 1 : -1);
+			return;
+		}
+		for (int i = 0; i < 2; i++)
+			if (_hitPage[i] >= 0 && _hitRect[i].contains(x, y)) {
+				enterZoom(_hitPage[i]);
+				return;
+			}
+		turn(x < _W / 2 ? -1 : 1);
+	}
+
+	void handleMouseWheel(int x, int y, int direction) override {
+		if (_zoom >= 0)
+			scrollBy(direction * _H / 6);
+		else
+			turn(direction);
+	}
+
+private:
+	Common::StringArray _pages;
+	ManualView *_view;
+	uint32 _openTime;
+
+	int _W = 0, _H = 0, _em = 0, _slop = 8;
+	int _slotW = 0, _slotH = 0, _top = 0;
+	bool _single = false;
+	int _pos = 0;			// view: spread (or page, with _single)
+
+	int _hitPage[2] = { -1, -1 };
+	Common::Rect _hitRect[2];
+
+	// pages fitted to the booklet, the last few used
+	struct Fitted {
+		int page;
+		Graphics::ManagedSurface *surf;
+		uint32 used;
+	};
+	Common::Array<Fitted> _cache;
+	uint32 _useCount = 0;
+
+	// zoomed page: rows already scaled horizontally, the vertical pass is done for the visible part
+	int _zoom = -1, _zoomY = 0, _zoomX = 0, _zoomW = 0, _zoomH = 0;
+	Common::Array<byte> _zoomRows;
+	ManualTaps _zoomTaps;
+
+	bool _pressed = false, _dragged = false;
+	int _downX = 0, _downY = 0, _downScroll = 0, _downPan = 0;
+
+	int numPages() const { return _pages.size(); }
+	int numViews() const { return _single ? numPages() : 1 + numPages() / 2; }
+
+	// pages of a view: left, right (-1 = none); the first page alone on the right
+	void viewPages(int v, int &left, int &right) const {
+		if (_single) {
+			left = -1;
+			right = v;
+			return;
+		}
+		left = v == 0 ? -1 : 2 * v - 1;
+		right = v == 0 ? 0 : (2 * v < numPages() ? 2 * v : -1);
+	}
+
+	int viewOf(int page) const {
+		if (_single)
+			return CLIP(page, 0, numPages() - 1);
+		return page <= 0 ? 0 : (page + 1) / 2;
+	}
+
+	int firstPage() const {
+		if (_zoom >= 0)
+			return _zoom;
+		int l, r;
+		viewPages(_pos, l, r);
+		return l >= 0 ? l : r;
+	}
+
+	void clearCache() {
+		for (uint i = 0; i < _cache.size(); i++)
+			delete _cache[i].surf;
+		_cache.clear();
+	}
+
+	void layout() {
+		_W = g_system->getOverlayWidth();
+		_H = g_system->getOverlayHeight();
+		_em = MAX(10, _H * 28 / 1000);
+		_slop = MAX(6, _em / 2);
+		_top = _em / 2;
+		_slotH = _H - _top - _em * 2;
+		// the proportions of the first page give the size of the booklet
+		double aspect = 1400.0 / 1988.0;
+		if (numPages()) {
+			Graphics::Surface *s = decodeManualPage(_pages[0]);
+			if (s) {
+				aspect = (double)s->w / s->h;
+				s->free();
+				delete s;
+			}
+		}
+		_slotW = (int)(_slotH * aspect);
+		// two pages side by side when they fit next to the arrows; else one at a time (they are as
+		// tall either way: the screen height sets the size)
+		_single = 2 * _slotW + 6 * _em > _W;
+		if (_single && _slotW + 6 * _em > _W) {
+			_slotW = _W - 6 * _em;
+			_slotH = (int)(_slotW / aspect);
+		}
+		_pos = CLIP(_pos, 0, MAX(0, numViews() - 1));
+		_view->_surf.create(_W, _H, kManualFormat);
+		_w = _W;
+		_h = _H;
+		_x = 0;
+		_y = 0;
+		_view->resize(0, 0, _W, _H, false);
+		redraw();
+	}
+
+	Graphics::ManagedSurface *fitted(int page) {
+		for (uint i = 0; i < _cache.size(); i++)
+			if (_cache[i].page == page) {
+				_cache[i].used = ++_useCount;
+				return _cache[i].surf;
+			}
+		Graphics::ManagedSurface *out = nullptr;
+		Graphics::Surface *src = decodeManualPage(_pages[page]);
+		if (src) {
+			int dw = _slotW, dh = (int)((int64)src->h * _slotW / src->w);
+			if (dh > _slotH) {
+				dh = _slotH;
+				dw = (int)((int64)src->w * _slotH / src->h);
+			}
+			dw = MAX(1, dw);
+			dh = MAX(1, dh);
+			Common::Array<byte> rows;
+			manualScaleRows(*src, dw, rows);
+			ManualTaps t;
+			t.make(src->h, dh);
+			out = new Graphics::ManagedSurface(dw, dh, kManualFormat);
+			manualScaleCols(rows, dw, t, 0, dh, *out, 0, 0);
+			src->free();
+			delete src;
+		}
+		// keep a few pages: the open spread and the ones next to it (memory, on the web too)
+		if (_cache.size() >= 4) {
+			uint old = 0;
+			for (uint i = 1; i < _cache.size(); i++)
+				if (_cache[i].used < _cache[old].used)
+					old = i;
+			delete _cache[old].surf;
+			_cache.remove_at(old);
+		}
+		Fitted f = { page, out, ++_useCount };
+		_cache.push_back(f);
+		return out;
+	}
+
+	void fill(const Common::Rect &r, uint32 c) {
+		Common::Rect cr = r;
+		cr.clip(Common::Rect(_W, _H));
+		if (!cr.isEmpty())
+			_view->_surf.fillRect(cr, c);
+	}
+
+	void arrow(int cx, int cy, int size, int dir, uint32 c) {
+		// a triangle pointing left (dir -1) or right (dir 1)
+		for (int y = -size; y <= size; y++) {
+			int len = size - ABS(y);
+			int x0 = dir > 0 ? cx - size / 2 : cx + size / 2 - len;
+			fill(Common::Rect(x0, cy + y, x0 + len, cy + y + 1), c);
+		}
+	}
+
+	void text(const Common::String &s, int y, uint32 c) {
+		GUI::ThemeEngine *th = g_gui.theme();
+		const Graphics::Font *font = th->getScalableFont("Rubik-Regular.ttf", _em);
+		if (!font)
+			font = th->getFont(GUI::ThemeEngine::kFontStyleNormal);
+		if (font)
+			font->drawString(&_view->_surf, s, 0, y - font->getFontHeight() / 2, _W, c, Graphics::kTextAlignCenter);
+	}
+
+	void redraw() {
+		Graphics::ManagedSurface &s = _view->_surf;
+		const uint32 bg = kManualFormat.RGBToColor(0x16, 0x13, 0x11);
+		const uint32 dim = kManualFormat.RGBToColor(0x9a, 0x92, 0x88);
+		s.fillRect(Common::Rect(_W, _H), bg);
+		_hitPage[0] = _hitPage[1] = -1;
+
+		if (_zoom >= 0) {
+			int x0 = _zoomW < _W ? (_W - _zoomW) / 2 : -_zoomX;
+			int y0 = _zoomH < _H ? (_H - _zoomH) / 2 : 0;
+			int from = _zoomH < _H ? 0 : _zoomY;
+			manualScaleCols(_zoomRows, _zoomW, _zoomTaps, from, MIN(_zoomH, from + _H), s, x0, y0);
+			if (_zoomH > _H) {
+				// where we are in the page
+				int bw = MAX(3, _em / 4);
+				int th = MAX(_em, _H * _H / _zoomH);
+				int ty = (int)((int64)(_H - th) * _zoomY / (_zoomH - _H));
+				fill(Common::Rect(_W - bw - 2, ty, _W - 2, ty + th), dim);
+			}
+			if (!_pressed)
+				debug("MANUAL: page %d/%d zoomed %dx%d, scroll %d,%d", _zoom + 1, numPages(), _zoomW, _zoomH, _zoomX, _zoomY);
+		} else {
+			int l, r;
+			viewPages(_pos, l, r);
+			int pages[2] = { l, r };
+			for (int i = 0; i < 2; i++) {
+				if (pages[i] < 0)
+					continue;
+				Common::Rect slot = _single ? Common::Rect((_W - _slotW) / 2, _top, (_W + _slotW) / 2, _top + _slotH)
+					: (i == 0 ? Common::Rect(_W / 2 - _slotW, _top, _W / 2, _top + _slotH)
+						: Common::Rect(_W / 2, _top, _W / 2 + _slotW, _top + _slotH));
+				Graphics::ManagedSurface *p = fitted(pages[i]);
+				Common::Rect pr;
+				if (p) {
+					// against the spine, centred in height
+					int px = _single ? slot.left + (slot.width() - p->w) / 2 : (i == 0 ? slot.right - p->w : slot.left);
+					pr = Common::Rect(px, slot.top + (slot.height() - p->h) / 2, px + p->w, slot.top + (slot.height() - p->h) / 2 + p->h);
+					s.blitFrom(*p, Common::Point(pr.left, pr.top));
+				} else {
+					pr = slot;
+					fill(pr, kManualFormat.RGBToColor(0x40, 0x3a, 0x34));
+				}
+				_hitPage[i] = pages[i];
+				_hitRect[i] = pr;
+			}
+			if (!_single && l >= 0 && r >= 0) {
+				// the fold
+				int w = MAX(1, _em / 10);
+				fill(Common::Rect(_W / 2 - w, _top, _W / 2 + w, _top + _slotH), kManualFormat.RGBToColor(0x2a, 0x24, 0x20));
+			}
+			const int as = MAX(6, _em * 6 / 5);
+			if (_pos > 0)
+				arrow(_em * 2, _top + _slotH / 2, as, -1, dim);
+			if (_pos < numViews() - 1)
+				arrow(_W - _em * 2, _top + _slotH / 2, as, 1, dim);
+			Common::String counter = l >= 0 && r >= 0 ? Common::String::format("%d-%d / %d", l + 1, r + 1, numPages())
+				: Common::String::format("%d / %d", (l >= 0 ? l : r) + 1, numPages());
+			text(counter, _H - _em, dim);
+			debug("MANUAL: view %d/%d pages %d %d (%s, page %dx%d, overlay %dx%d)", _pos + 1, numViews(), l + 1, r + 1,
+				_single ? "single" : "spread", _slotW, _slotH, _W, _H);
+		}
+		_view->markAsDirty();
+		g_gui.scheduleTopDialogRedraw();
+	}
+
+	void show(int v) {
+		v = CLIP(v, 0, numViews() - 1);
+		if (v == _pos)
+			return;
+		_pos = v;
+		redraw();
+	}
+
+	void turn(int dir) {
+		if (_zoom >= 0) {
+			int p = _zoom + dir;
+			if (p >= 0 && p < numPages())
+				enterZoom(p);
+			return;
+		}
+		show(_pos + dir);
+	}
+
+	void enterZoom(int page) {
+		Graphics::Surface *src = decodeManualPage(_pages[page]);
+		if (!src)
+			return;
+		// the width of the screen (at most twice the image); on a small screen (the overlay of the
+		// classic renderer can be 640x480) the print would be too small: wider, panned by dragging
+		_zoomW = _W * 3 < src->w * 2 ? MIN<int>(src->w, _W * 2) : MIN<int>(_W, src->w * 2);
+		_zoomH = MAX(1, (int)((int64)src->h * _zoomW / src->w));
+		manualScaleRows(*src, _zoomW, _zoomRows);
+		_zoomTaps.make(src->h, _zoomH);
+		src->free();
+		delete src;
+		if (_zoom != page)
+			_zoomY = _zoomX = 0;
+		_zoom = page;
+		_zoomY = CLIP(_zoomY, 0, MAX(0, _zoomH - _H));
+		_zoomX = CLIP(_zoomX, 0, MAX(0, _zoomW - _W));
+		redraw();
+	}
+
+	void leaveZoom() {
+		_pos = viewOf(_zoom);
+		_zoom = -1;
+		_zoomRows.clear();	// frees the memory
+		redraw();
+	}
+
+	void scrollTo(int y, int x) {
+		y = CLIP(y, 0, MAX(0, _zoomH - _H));
+		x = CLIP(x, 0, MAX(0, _zoomW - _W));
+		if (y == _zoomY && x == _zoomX)
+			return;
+		_zoomY = y;
+		_zoomX = x;
+		redraw();
+	}
+
+	void scrollBy(int d) {
+		scrollTo(_zoomY + d, _zoomX);
+	}
+};
+
+void Parallaction_br::showManual() {
+	// the game's language (German: de or ge), else English, else Italian
+	Common::StringArray langs = braLanguageCodes(getInternLanguage());
+	langs.push_back("en");
+	langs.push_back("it");
+	Common::StringArray pages;
+	uint used = 0;
+	for (; used < langs.size(); used++) {
+		pages = loadManualList(langs[used].c_str());
+		if (!pages.empty())
+			break;
+	}
+	if (pages.empty()) {
+		debug("MANUAL: no manual/<language>.txt");
+		return;
+	}
+	debug("MANUAL: open manual/%s.txt, %u pages", langs[used].c_str(), pages.size());
+	ManualDialog dlg(pages);
+	runDialog(dlg);
+	debug("MANUAL: closed");
+}
+
+} // End of namespace Parallaction
