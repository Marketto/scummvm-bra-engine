+// while the screen runs at 30 fps, and beginFrame() runs every frame: the room jumped 32 pixels
+// per frame. The same distance is covered at the same speed as on DOS (32 pixels per step, see
+// setScrollStep), but a few pixels at every frame.
+int32 Gfx::scrollPixels(int32 &remain, uint32 &acc, int perStep, uint32 dt, int minPos, int maxPos, int pos) {
+	if (remain == 0)
