+bool Parallaction::updatePointerOnly() {
+	Common::EventManager *em = _system->getEventManager();
+	Common::Array<Common::Event> pending;
+	Common::Event ev;
+	bool moved = false;
+	while (em->pollEvent(ev)) {
+		if (ev.type == Common::EVENT_MOUSEMOVE)
+			moved = true;
+		// the event manager has already acted on these while polling (the ScummVM menu has been
+		// shown and closed, mute and the virtual keyboard toggled, quitting confirmed): given back,
+		// they would act again (the menu opened a second time after "Resume")
+		if (ev.type == Common::EVENT_MAINMENU || ev.type == Common::EVENT_MUTE ||
+			ev.type == Common::EVENT_VIRTUAL_KEYBOARD || ev.type == Common::EVENT_QUIT ||
+			ev.type == Common::EVENT_RETURN_TO_LAUNCHER)
+			continue;
+		pending.push_back(ev);
+		if (pending.size() > 64)
+			break;
+	}
+	for (uint i = 0; i < pending.size(); i++)
+		em->pushEvent(pending[i]);
+	return moved;
+}
+
+// Length of a game step in BRA (animations and walking advance once per step; the screen and the
+// input keep running at 30 fps in between, see runGameFrame).
+// The DOS game has no timer: each step draws the jobs, then swapbuffers() waits for two vertical
+// retraces, so a step lasts 2 retraces + the time spent drawing, which on VGA is mostly port I/O
+// and does not get faster with the CPU. Measured in DOSBox (same rate at 40000 and 120000 cycles),
+// against the area of the animation frames on screen:
+//   credits (no animations) 43 ms, stairs 49k px 90 ms, Panoram 94k px 133 ms, cradle 217k px 160 ms
+// The step is interpolated on these points and rounded to whole retraces (70 Hz), as on DOS.
+// "bra_tick_ms" in the settings forces a fixed length (33 = the old ScummVM pace, ~4x faster).
+uint32 Parallaction::braTickMillis() {
+	if (ConfMan.hasKey("bra_tick_ms"))
+		return (uint32)CLIP(ConfMan.getInt("bra_tick_ms"), 10, 500);
+
+	uint32 area = 0;
+	for (AnimationList::iterator it = _location._animations.begin(); it != _location._animations.end(); ++it) {
+		if (!((*it)->_flags & kFlagsActive) || !(*it)->gfxobj)
+			continue;
+		Common::Rect r;
+		(*it)->getFrameRect(r);
+		r.clip(Common::Rect(0, 0, 640, 400));
+		if (!r.isEmpty())
+			area += r.width() * r.height();
+	}
+	static const uint32 kArea[] = { 0, 49000, 94000, 217000 };
+	static const uint32 kMs[] = { 43, 90, 133, 160 };
+	uint32 ms = kMs[3] + (area > kArea[3] ? (area - kArea[3]) * 27 / 123000 : 0);
+	for (int i = 0; i < 3; i++) {
+		if (area <= kArea[i + 1]) {
+			ms = kMs[i] + (area - kArea[i]) * (kMs[i + 1] - kMs[i]) / (kArea[i + 1] - kArea[i]);
+			break;
+		}
+	}
+	// whole retraces of a 70 Hz VGA (14.29 ms), at least 3 as for an empty screen
+	uint32 retraces = MAX<uint32>(3, (ms * 70 + 500) / 1000);
+	ms = retraces * 1000 / 70;
+	debugC(3, kDebugExec, "step %s area %u -> %u ms", _location._name, area, ms);
+	return ms;
 }
 
