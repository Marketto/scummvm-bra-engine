+// BRA with the HD renderer (not the original view): the arrow drawn again for HD, hd/<file>.png with alpha
+// (docs/formati.md), and with an object in hand its HD icon (hd/spr, the one of the inventory) over it
+// where the original puts the 51x51 icon. Without the picture (or a backend without alpha cursors) the
+// caller keeps the original pointer upscaled; an object without an HD icon is upscaled over the HD arrow.
+// The HD arrow if it can be shown now. The picture has fixed colours, the original pointer takes them from
+// the palette (the interface entries are grey in a few rooms, fades): the HD one is used only while the
+// palette has, for every entry of the original arrow, the colour the picture shows on most of its pixels
+// (taken at the centres of the original pixels, once per picture).
+const Graphics::Surface *Input::hdArrow() {
+	HDRenderer *hd = _vm->_gfx ? _vm->_gfx->_hd : nullptr;
+	const char *name = arrowName();
+	if (!hd || hd->classic() || !name || !g_system->hasFeature(OSystem::kFeatureCursorAlpha))
+		return nullptr;
+	Common::Rect r;
+	_mouseArrow->getRect(0, r);
+	const Graphics::Surface *arrow = hd->hdPicture(Common::String::format("%s.png", name), r.width(), r.height());
+	if (!arrow)
+		return nullptr;
+	const int s = hd->scale(), w = r.width(), h = r.height();
+	const byte *px = _mouseArrow->getData(0);
+	Common::HashMap<Common::String, Common::Array<uint32> >::iterator it = _arrowRef.find(name);
+	if (it == _arrowRef.end()) {
+		// per palette entry: the most frequent opaque colour at the centres of its pixels (0: none)
+		Common::Array<uint32> ref(256, 0);
+		for (int i = 1; i < 256; i++) {
+			Common::HashMap<uint32, int> votes;
+			int best = 0;
+			for (int y = 0; y < h; y++)
+				for (int x = 0; x < w; x++) {
+					if (px[y * w + x] != i)
+						continue;
+					uint32 c = *(const uint32 *)arrow->getBasePtr(x * s + s / 2, y * s + s / 2);
+					if ((c >> 24) != 255)
+						continue;
+					int v = ++votes[c];
+					if (v > best) {
+						best = v;
+						ref[i] = c;
+					}
+				}
+		}
+		_arrowRef[name] = ref;
+		it = _arrowRef.find(name);
+	}
+	for (int i = 1; i < 256; i++) {
+		uint32 a = it->_value[i];
+		if (!a)
+			continue;
+		uint32 b = hd->paletteARGB(i);
+		for (int sh = 0; sh < 24; sh += 8)
+			if (ABS((int)((a >> sh) & 0xff) - (int)((b >> sh) & 0xff)) > 4)
+				return nullptr;
+	}
+	return arrow;
+}
