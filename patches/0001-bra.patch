+// Names of the inventory items, from the patch (text/inventario-<lang>.txt, UTF-8, see
+// docs/formati.md). One entry per line, "#" starts a comment:
+//   colore oggetti <n> / colore azioni <n>   label colours (palette index, 0 = as the zone names)
+//   azione <zone type> <name>                the verb icons, by their script type (box, get...)
+//   [<part>:]<object> <name>                 an object by its OBJECTS.TAB name, in any part or one
+// An item without a name shows no label.
+void Parallaction_br::loadInventoryNames() {
+	_invNamesLoaded = true;
+	// only the game's language: without a file no labels, as in the original
+	Common::StringArray langs = braLanguageCodes(getInternLanguage());
+	Common::File f;
+	Common::String path;
+	for (uint i = 0; i < langs.size() && !f.isOpen(); i++) {
+		path = Common::String::format("text/inventario-%s.txt", langs[i].c_str());
+		f.open(Common::Path(path, '/'));
+	}
+	if (!f.isOpen())
+		return;
+	while (!f.eos() && !f.err()) {
+		Common::String line = f.readLine();
+		int hash = line.findFirstOf('#');
+		if (hash >= 0)
+			line = Common::String(line.c_str(), hash);
+		line.trim();
+		if (line.empty())
+			continue;
+		// first word: the key; the rest: the value
+		uint i = 0;
+		while (i < line.size() && !Common::isSpace(line[i]))
+			i++;
+		Common::String key(line.c_str(), i);
+		Common::String value(line.c_str() + i);
+		value.trim();
+		key.toLowercase();
+		if (key == "colore" || key == "color") {
+			uint j = 0;
+			while (j < value.size() && !Common::isSpace(value[j]))
+				j++;
+			Common::String which(value.c_str(), j);
+			which.toLowercase();
+			int n = atoi(value.c_str() + j);
+			if (n < 0 || n > 255)
+				warning("%s: bad colour '%s'", path.c_str(), value.c_str());
+			else if (which == "oggetti" || which == "objects")
+				_invObjectColor = n;
+			else if (which == "azioni" || which == "verbs")
+				_invVerbColor = n;
+			else
+				warning("%s: unknown colour '%s'", path.c_str(), which.c_str());
+			continue;
+		}
+		if (key == "azione" || key == "verb") {
+			uint j = 0;
+			while (j < value.size() && !Common::isSpace(value[j]))
+				j++;
+			Common::String type(value.c_str(), j);
+			type.toLowercase();
+			key = "@" + type;
+			value = Common::String(value.c_str() + j);
+			value.trim();
+		}
+		if (value.empty())
+			continue;
+		// UTF-8 -> the game's DOS code page, as text/<lang>.txt
+		Common::U32String u(value.c_str(), Common::kUtf8);
+		_invNames[key] = u.encode(Common::kDos850);
+	}
+	debugC(1, kDebugParser, "%s: %d inventory names", path.c_str(), _invNames.size());
+}
+
+extern const char *_zoneTypeNamesRes_br[];
+
+bool Parallaction_br::inventoryName(const InventoryItem &item, Common::String &name, byte &color) {
+	if (!_invNamesLoaded)
+		loadInventoryNames();
+	if (_invNames.empty() || item._index == 0)
+		return false;
+
+	Common::HashMap<Common::String, Common::String>::const_iterator it;
+	if (item._id & 0xFFFF) {
+		// a verb icon: _id is its zone type (kZoneBox, kZoneGet...)
+		uint type = item._id & 0xFFFF;
+		if (type < 1 || type > kZoneBox)
+			return false;
+		it = _invNames.find(Common::String("@") + _zoneTypeNamesRes_br[type - 1]);
+		color = _invVerbColor;
+	} else {
+		// an object: _index = 4 + its 1-based position in OBJECTS.TAB
+		if (!_objectsNames || item._index < 5 || (uint)(item._index - 5) >= _objectsNames->count())
+			return false;
+		Common::String obj(_objectsNames->item(item._index - 5));
+		obj.toLowercase();
+		it = _invNames.find(Common::String::format("%d:", _part) + obj);
+		if (it == _invNames.end())
+			it = _invNames.find(obj);
+		color = _invObjectColor;
+	}
+	if (it == _invNames.end())
+		return false;
+	name = bitmapFontSpelling(it->_value);
+	return true;
+}
+
+
 } // namespace Parallaction
