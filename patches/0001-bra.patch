+
+Common::StringArray braLanguageCodes(uint lang) {
+	static const char *const codes[] = { "it", "fr", "en", "de" };
+	Common::StringArray out;
+	if (lang < ARRAYSIZE(codes))
+		out.push_back(codes[lang]);
+	if (lang == kGerman)
+		out.push_back("ge");
+	return out;
+}
+
+void Parallaction::loadTextFixes() {
+	_textFixesLoaded = true;
+	// only the game's language: without a file the original texts stay
+	Common::StringArray langs = braLanguageCodes(getInternLanguage());
+	Common::File f;
+	Common::String path;
+	for (uint i = 0; i < langs.size() && !f.isOpen(); i++) {
+		path = Common::String::format("text/%s.txt", langs[i].c_str());
+		f.open(Common::Path(path, '/'));
+	}
+	if (!f.isOpen()) {
+		debugC(1, kDebugParser, "no text/<language>.txt for language %u: original texts", getInternLanguage());
+		return;
+	}
+	while (!f.eos() && !f.err()) {
+		Common::String line = f.readLine();
+		if (line.empty() || line[0] == '#')
+			continue;
+		int tab = line.findFirstOf('\t');
+		if (tab != 8)
+			continue;
+		Common::String key = line.substr(0, 8);
+		// UTF-8 -> the game's DOS code page (850 has all the accents, È included)
+		Common::U32String u(line.substr(9).c_str(), Common::kUtf8);
+		_textFixes[key] = u.encode(Common::kDos850);
+	}
+	debugC(1, kDebugParser, "%s: %d corrected texts loaded", path.c_str(), _textFixes.size());
+}
+
+void Parallaction::loadDialogueFixes() {
+	_dialogueFixesLoaded = true;
+	if (getGameType() != GType_BRA)
+		return;
+	Common::File f;
+	if (!f.open(Common::Path("text/dialoghi.txt", '/')))
+		return;
+	while (!f.eos() && !f.err()) {
+		Common::String line = f.readLine();
+		int hash = line.findFirstOf('#');
+		if (hash >= 0)
+			line = Common::String(line.c_str(), hash);
+		line.trim();
+		if (line.size() < 10 || !Common::isSpace(line[8]))
+			continue;
+		Common::String key(line.c_str(), 8);
+		key.toLowercase();
+		DialogueFix &fix = _dialogueFixes[key];
+		// fields separated by spaces or tabs: ritratto=<frame> tal=<talk file>
+		Common::StringTokenizer tok(line.c_str() + 9, " \t");
+		while (!tok.empty()) {
+			Common::String field = tok.nextToken();
+			int eq = field.findFirstOf('=');
+			if (eq <= 0)
+				continue;
+			Common::String name(field.c_str(), eq);
+			Common::String value(field.c_str() + eq + 1);
+			if (name.equalsIgnoreCase("ritratto") || name.equalsIgnoreCase("portrait"))
+				fix.frame = atoi(value.c_str());
+			else if (name.equalsIgnoreCase("tal") || name.equalsIgnoreCase("talk"))
+				fix.talk = value;
+			else
+				warning("text/dialoghi.txt: unknown field '%s' for %s", name.c_str(), key.c_str());
+		}
+	}
+	debugC(1, kDebugParser, "%d dialogue corrections loaded", _dialogueFixes.size());
+}
+
+const Parallaction::DialogueFix *Parallaction::dialogueFix(const Common::String &text) {
+	if (!_dialogueFixesLoaded)
+		loadDialogueFixes();
+	if (_dialogueFixes.empty() || text.empty())
+		return nullptr;
+	Common::HashMap<Common::String, DialogueFix>::const_iterator it = _dialogueFixes.find(voiceKey(text));
+	return it == _dialogueFixes.end() ? nullptr : &it->_value;
+}
+
+Common::String Parallaction::fixText(const Common::String &text) {
+	if (!_textFixesLoaded)
+		loadTextFixes();
+	if (_textFixes.empty() || text.empty())
+		return text;
+	Common::HashMap<Common::String, Common::String>::iterator it = _textFixes.find(voiceKey(text));
+	if (it == _textFixes.end())
+		return text;
+	return bitmapFontSpelling(it->_value);
+}
+
+Common::String Parallaction::bitmapFontSpelling(const Common::String &t, bool always) {
+	if (hdTextActive() && !always)
+		return t;
+	// The original bitmap fonts (_braDosFullCharMap) have the lowercase accented letters but ì and ó,
+	// and no accented capitals: fall back to the old spelling of the original scripts, base letter
+	// plus apostrophe for grave and acute accents (È -> E', COSÌ -> COSI'), base letter alone for
+	// the others (Ä -> A). Code page 850.
+	static const struct { byte c; char base; bool apostrophe; } missing[] = {
+		{ 0x8D, 'i', true }, { 0xA2, 'o', true }, { 0x8B, 'i', false }, { 0x8C, 'i', false },
+		{ 0xB7, 'A', true }, { 0xB5, 'A', true }, { 0xB6, 'A', false }, { 0x8E, 'A', false },
+		{ 0xD4, 'E', true }, { 0x90, 'E', true }, { 0xD2, 'E', false }, { 0xD3, 'E', false },
+		{ 0xDE, 'I', true }, { 0xD6, 'I', true }, { 0xD7, 'I', false }, { 0xD8, 'I', false },
+		{ 0xE3, 'O', true }, { 0xE0, 'O', true }, { 0xE2, 'O', false }, { 0x99, 'O', false },
+		{ 0xEB, 'U', true }, { 0xE9, 'U', true }, { 0xEA, 'U', false }, { 0x9A, 'U', false }
+	};
+	Common::String o;
+	for (uint i = 0; i < t.size(); i++) {
+		byte c = t[i];
+		uint m = 0;
+		while (m < ARRAYSIZE(missing) && missing[m].c != c)
+			m++;
+		if (m == ARRAYSIZE(missing)) {
+			o += (char)c;
+			continue;
+		}
+		o += missing[m].base;
+		if (missing[m].apostrophe)
+			o += '\'';
+	}
+	return o;
+}
+
+void Parallaction::setVoiceSpeaker(const Common::String &name, int frame) {
+	_voiceSpeaker = name;
+	_voiceSpeaker.toLowercase();
+	if (_voiceSpeaker.hasSuffix(".tal"))
+		_voiceSpeaker = Common::String(_voiceSpeaker.c_str(), _voiceSpeaker.size() - 4);
+	_voiceSpeakerFrame = frame;
+}
+
+// voice/personaggi.txt (UTF-8): "<who> <voice name>" per line, '#' starts a comment.
+// <who> is "<speaker>", "<speaker>-<frame>" (one portrait of a talk file with two people),
+// either one prefixed by "<part>:" for one part only, or "@<key>" for one line whoever says it.
+void Parallaction::loadVoiceSpeakers() {
+	_voiceSpeakersLoaded = true;
+	if (getGameType() != GType_BRA)
+		return;
+	Common::File f;
+	if (!f.open(Common::Path("voice/personaggi.txt", '/')))
+		return;
+	while (!f.eos() && !f.err()) {
+		Common::String line = f.readLine();
+		int hash = line.findFirstOf('#');
+		if (hash >= 0)
+			line = Common::String(line.c_str(), hash);
+		Common::StringTokenizer tok(line, " \t\r");
+		Common::String who = tok.nextToken();
+		Common::String name = tok.nextToken();
+		if (who.empty() || name.empty())
+			continue;
+		who.toLowercase();
+		name.toLowercase();
+		_voiceSpeakers[who] = name;
+	}
+	debugC(1, kDebugAudio, "%d voice names loaded", _voiceSpeakers.size());
+}
+
+// The voice name of the line with this key: "<part>:@<key>" (the same text said by different people
+// in two parts, "MATRIOSKA SHOW!": Stroga in PART1, Lenin in PART4), "@<key>", else the most specific
+// entry for the speaker (part and frame, frame, part, plain), else the speaker itself.
+// Empty when nobody was set: only voice/<key> is looked for.
+Common::String Parallaction::voiceSpeakerName(const Common::String &key, const Common::String &speaker, int frame) {
+	if (getGameType() != GType_BRA)
+		return Common::String();
+	if (!_voiceSpeakersLoaded)
+		loadVoiceSpeakers();
+	int part = ((Parallaction_br *)this)->_part;
+	Common::HashMap<Common::String, Common::String>::const_iterator it = _voiceSpeakers.find(Common::String::format("%d:@", part) + key);
+	if (it != _voiceSpeakers.end())
+		return it->_value;
+	it = _voiceSpeakers.find("@" + key);
+	if (it != _voiceSpeakers.end())
+		return it->_value;
+	if (speaker.empty())
+		return Common::String();
+	Common::String who[4];
+	int n = 0;
+	if (frame >= 0) {
+		who[n++] = Common::String::format("%d:%s-%d", part, speaker.c_str(), frame);
+		who[n++] = Common::String::format("%s-%d", speaker.c_str(), frame);
+	}
+	who[n++] = Common::String::format("%d:%s", part, speaker.c_str());
+	who[n++] = speaker;
+	for (int i = 0; i < n; i++) {
+		it = _voiceSpeakers.find(who[i]);
+		if (it != _voiceSpeakers.end())
+			return it->_value;
+	}
+	return speaker;
+}
+
+static bool voiceFileExists(const Common::String &name) {
+	static const char *const exts[] = { ".ogg", ".flac", ".mp3", ".wav" };
+	for (int i = 0; i < ARRAYSIZE(exts); i++)
+		if (Common::File::exists(Common::Path("voice/" + name + exts[i], '/')))
+			return true;
+	return false;
+}
+
+bool Parallaction::playVoice(const Common::String &text, int kind) {
+	// the speaker is for this line only
+	Common::String speaker = _voiceSpeaker;
+	int speakerFrame = _voiceSpeakerFrame;
+	_voiceSpeaker.clear();
+	_voiceSpeakerFrame = -1;
+	if (text.empty())
+		return false;
+	Common::String key = voiceKey(text);
+	// the same text said by two characters: voice/<key>_<voice name> first
+	Common::String name = voiceSpeakerName(key, speaker, speakerFrame);
+	Common::String keys[2];
+	int numKeys = 0;
+	// a line with a value of the game in it ("Per ora ho solo %rubli Rublodollari."): one recording
+	// per value, named after the text with the number written in ("... solo 7 Rublodollari.")
+	if (text.contains('%') && getGameType() == GType_BRA) {
+		Common::String expanded;
+		for (uint i = 0; i < text.size(); i++) {
+			if (text[i] != '%') {
+				expanded += text[i];
+				continue;
+			}
+			uint j = i + 1;
+			while (j < text.size() && Common::isAlnum(text[j]))
+				j++;
+			Common::String counter(text.c_str() + i + 1, j - i - 1);
+			Parallaction_br *br = (Parallaction_br *)this;
+			if (!counter.empty() && br->counterExists(counter)) {
+				expanded += Common::String::format("%d", br->getCounterValue(counter));
+				i = j - 1;
+			} else
+				expanded += text[i];
+		}
+		keys[numKeys++] = voiceKey(expanded);
+	}
+	keys[numKeys++] = key;
+	Common::String file;
+	for (int i = 0; i < numKeys && file.empty(); i++) {
+		if (!name.empty() && voiceFileExists(keys[i] + "_" + name))
+			file = keys[i] + "_" + name;
+		else if (voiceFileExists(keys[i]))
+			file = keys[i];
+	}
+	if (file.empty()) {
+		debugC(2, kDebugAudio, "voice %s (%s) not found for '%s'", key.c_str(), name.c_str(), text.c_str());
+		return false;
+	}
+	key = file;
+	Audio::SeekableAudioStream *stream = Audio::SeekableAudioStream::openStreamFile(Common::Path("voice/" + key, '/'));
+	if (!stream) {
+		debugC(2, kDebugAudio, "voice %s not found for '%s'", key.c_str(), text.c_str());
+		return false;
+	}
+	_mixer->stopHandle(_voiceHandle);
+	stopTextToSpeech();
+	_mixer->playStream(Audio::Mixer::kSpeechSoundType, &_voiceHandle, stream);
+	_voiceKind = kind;
+	debugC(1, kDebugAudio, "playing voice %s", key.c_str());
+	return true;
+}
+
+void Parallaction::stopVoice(bool answersToo) {
+	if (!answersToo && _voiceKind == kVoiceAnswer && _mixer->isSoundHandleActive(_voiceHandle))
+		return;
+	_mixer->stopHandle(_voiceHandle);
+	_voiceKind = kVoiceNone;
+}
+
+bool Parallaction::isVoicePlaying() {
+	return _mixer->isSoundHandleActive(_voiceHandle);
+}
