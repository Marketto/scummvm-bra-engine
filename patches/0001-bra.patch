+void Parallaction_br::loadLocationDetours() {
+	_detoursLoaded = true;
+	Common::File f;
+	if (!f.open(Common::Path("loc/deviazioni.txt", '/')))
+		return;
+	while (!f.eos() && !f.err()) {
+		Common::String line = f.readLine();
+		int hash = line.findFirstOf('#');
+		if (hash >= 0)
+			line = Common::String(line.c_str(), hash);
+		// <part> <location left> <destination of the script> <new destination> [opzione=<setting>]
+		Common::StringTokenizer tok(line, " \t");
+		Common::StringArray w;
+		while (!tok.empty())
+			w.push_back(tok.nextToken());
+		if (w.empty())
+			continue;
+		if (w.size() < 4 || !Common::isDigit(w[0][0])) {
+			warning("loc/deviazioni.txt: bad line '%s'", line.c_str());
+			continue;
+		}
+		LocationDetour d;
+		d.part = atoi(w[0].c_str());
+		d.from = w[1];
+		d.to = w[2];
+		d.instead = w[3];
+		for (uint i = 4; i < w.size(); i++) {
+			if (w[i].hasPrefixIgnoreCase("opzione=") || w[i].hasPrefixIgnoreCase("setting="))
+				d.setting = w[i].c_str() + w[i].findFirstOf('=') + 1;
+			else
+				warning("loc/deviazioni.txt: unknown field '%s'", w[i].c_str());
+		}
+		_detours.push_back(d);
+	}
+	debugC(1, kDebugParser, "%d location detours loaded", _detours.size());
+}
+
+bool Parallaction_br::applyLocationDetour() {
+	if (!_detoursLoaded)
+		loadLocationDetours();
+	for (uint i = 0; i < _detours.size(); i++) {
+		const LocationDetour &d = _detours[i];
+		if (d.part != _part || !_newLocationName.equalsIgnoreCase(d.to) || scumm_stricmp(_location._name, d.from.c_str()))
+			continue;
+		// a setting named by the file can turn the detour off (on when absent)
+		if (!d.setting.empty() && ConfMan.hasKey(d.setting) && !ConfMan.getBool(d.setting))
+			continue;
+		debugC(1, kDebugExec, "changeLocation: detour %s > %s becomes %s > %s", d.from.c_str(), d.to.c_str(), d.from.c_str(), d.instead.c_str());
+		_newLocationName = d.instead;
+		return true;
+	}
+	return false;
+}
+
