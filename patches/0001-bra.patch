+
+namespace Parallaction {
+
+class Parallaction;
+
+/*
+ * High resolution renderer for Big Red Adventure.
+ *
+ * The game keeps running at its native 640x400, 256 colors. Every frame the
+ * renderer composes a true color image at 2x or 3x that resolution:
+ *
+ * - pixels showing the untouched location background are taken from a high
+ *   resolution replacement picture (hd/<PART>/bkg/<name>.png, any integer
+ *   multiple of the original size), when one is available;
+ * - everything else (characters, animations, balloons, text, inventory,
+ *   modified background areas) is upscaled from the 256 color frame with an
+ *   edge-preserving pixel-art scaler (Scale2x/Scale3x, applied on palette
+ *   indices so that palette effects keep working).
+ *
+ * Palette effects are honoured on the HD background too: plain fades and the
+ * grayscale "comment" view are applied to the HD pixels; anything more exotic
+ * (color cycling, blue fade, ...) falls back to the upscaled frame for the
+ * affected colors.
+ */
+class HDRenderer {
+public:
+	HDRenderer(Parallaction *vm, int scale);
+	~HDRenderer();
+
+	int scale() const { return _scale; }
+	// original look (pixels scaled up as they are, original fonts), switchable while playing
+	void forceFullRedraw() { _fullRedraw = true; }
+	void setClassic(bool c) { if (c != _classic) { _classic = c; _fullRedraw = true; _paletteDirty = true; } }
+	bool classic() const { return _classic; }
+	const Graphics::PixelFormat &format() const { return _format; }
+
+	// a new background was set: name is the HD lookup key (e.g. "PART1/bkg/museo"),
+	// empty for none. rgb8 is the palette the background is meant for.
+	void setBackground(const Common::String &name, const Graphics::Surface &bg, const byte *rgb8, int bgX, int bgY, bool flip = false);
+	void setPalette(const byte *rgb8, uint num);
+
