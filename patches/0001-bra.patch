+
+// The original picture (balloon->surface, balloon->box) becomes a remastered balloon: the oval of the picture (rows wide
+// at least 40% of the widest), its tail (the lowest pixel below the oval), its colours; an oval large enough for the
+// text, growing up and away from the tail and kept on the screen (originX/Y: where the box is drawn, screen pixels).
+bool BalloonManager_br::makeOval(Balloon *balloon, const Common::String &text, int originX, int originY) {
+	Graphics::Surface *src = balloon->surface;
+	const byte key = BALLOON_TRANSPARENT_COLOR_BR;
+	int maxW = 0;
+	Common::Array<int> lx(src->h, -1), rx(src->h, -1);
+	for (int y = 0; y < src->h; y++) {
+		const byte *p = (const byte *)src->getBasePtr(0, y);
+		for (int x = 0; x < src->w; x++)
+			if (p[x] != key) { if (lx[y] < 0) lx[y] = x; rx[y] = x; }
+		if (lx[y] >= 0)
+			maxW = MAX(maxW, rx[y] - lx[y] + 1);
+	}
+	if (!maxW)
+		return false;
+	int top = -1, bottom = -1, left = src->w, right = -1;
+	for (int y = 0; y < src->h; y++) {
+		if (lx[y] >= 0 && rx[y] - lx[y] + 1 >= maxW * 2 / 5) {
+			if (top < 0)
+				top = y;
+			bottom = y;
+			left = MIN(left, lx[y]);
+			right = MAX(right, rx[y]);
+		}
+	}
+	HDBalloonShape sh;
+	sh.cx = (left + right + 1) / 2.0f;
+	sh.cy = (top + bottom + 1) / 2.0f;
+	float a0 = (right - left + 1) / 2.0f, b0 = (bottom - top + 1) / 2.0f;
+	int tipY = -1;
+	for (int y = src->h - 1; y > bottom; y--)
+		if (lx[y] >= 0) { tipY = y; break; }
+	if (tipY >= 0) {
+		sh.tail = true;
+		sh.tipX = (lx[tipY] + rx[tipY] + 1) / 2.0f;
+		sh.tipY = tipY + 1.0f;
+	}
+	// colours: the middle of the oval, the first pixel of its middle row
+	int my = (int)sh.cy;
+	sh.fill = *(const byte *)src->getBasePtr((int)sh.cx, my);
+	sh.line = *(const byte *)src->getBasePtr(lx[my] >= 0 ? lx[my] : (int)sh.cx, my);
+	if (sh.line == sh.fill)
+		sh.line = 0;
+
+	// grow until the text fits
+	Common::Array<Common::String> lines;
+	Common::Array<int> widths;
+	float a = a0, b = b0;
+	const float maxA = _vm->_screenWidth / 2.0f - 6, maxB = _vm->_screenHeight / 2.0f - 20;
+	while (!_ot.fit(text, a, b, lines, widths) && (a < maxA || b < maxB)) {
+		a = MIN(maxA, a * 1.06f);
+		b = MIN(maxB, b * 1.06f);
+	}
+	// away from the tail: the bottom of the oval stays, it grows up and to the other side
+	float side = sh.tail ? (sh.tipX < sh.cx ? 1.0f : -1.0f) : 0.0f;
+	sh.cx += side * (a - a0);
+	sh.cy -= (b - b0);
+	sh.a = a;
+	sh.b = b;
+	// on the screen (the tail may stay where it was)
+	float sx = originX + balloon->box.left, sy = originY + balloon->box.top;	// screen position of the picture's 0,0
+	sh.cx = CLIP(sh.cx, 3 + a - sx, _vm->_screenWidth - 3 - a - sx);
+	sh.cy = CLIP(sh.cy, 3 + b - sy, _vm->_screenHeight - 3 - b - sy);
+
+	// the new picture: bounding box of the oval and of the tail
+	float l = sh.cx - a - 2, r = sh.cx + a + 2, t = sh.cy - b - 2, bt = sh.cy + b + 2;
+	if (sh.tail) {
+		l = MIN(l, sh.tipX - 2); r = MAX(r, sh.tipX + 2); t = MIN(t, sh.tipY - 2); bt = MAX(bt, sh.tipY + 2);
+	}
+	int ox = (int)floorf(l), oy = (int)floorf(t);
+	int w = (int)ceilf(r) - ox, h = (int)ceilf(bt) - oy;
+	sh.cx -= ox; sh.cy -= oy;
+	if (sh.tail) { sh.tipX -= ox; sh.tipY -= oy; }
+
+	src->free();
+	src->create(w, h, Graphics::PixelFormat::createFormatCLUT8());
+	balloon->box = Common::Rect(balloon->box.left + ox, balloon->box.top + oy, balloon->box.left + ox + w, balloon->box.top + oy + h);
+	balloon->shape = sh;
+	balloon->oval = true;
+	return true;
+}
