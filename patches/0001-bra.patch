+// ZONA:location:zone. The current location: its loaded zone or animation. Another one: the flags the engine
+// keeps for it (_zoneFlags, stored when leaving it and in the saved games); false if never entered
+bool Parallaction_br::hintZoneOn(const Common::String &loc, const Common::String &zone) {
+	if (!scumm_stricmp(_location._name, loc.c_str())) {
+		ZonePtr z = _location.findZone(zone.c_str());
+		if (z)
+			return !(z->_flags & kFlagsRemove);
+		AnimationPtr a = _location.findAnimation(zone.c_str());
+		if (a)
+			return !(a->_flags & kFlagsRemove);
+		warning("hint: unknown zone '%s' in %s", zone.c_str(), loc.c_str());
+		return false;
+	}
+	for (uint i = 0; i < NUM_LOCATIONS && _locationNames[i][0]; i++) {
+		if (scumm_stricmp(_locationNames[i], loc.c_str()))
+			continue;
+		Script *script = _disk->loadLocation(loc.c_str());
+		uint16 index = zoneIndexInScript(script, zone);
+		delete script;
+		if (!index || index >= NUM_ZONES) {
+			warning("hint: unknown zone '%s' in %s", zone.c_str(), loc.c_str());
+			return false;
+		}
+		return !(_zoneFlags[i][index] & kFlagsRemove);
+	}
+	return false;
+}
+
+// one term of a condition: GF:NAME, LF:location:NAME, INV:[character:]name, PRESO:name, ZONA:location:zone,
+// PG:character, CNT:NAME>n, LOC:name, VISTO:name, sempre, mai; ! negates (docs/aiuti.md)
+bool Parallaction_br::hintTerm(const Common::String &t0) {
+	Common::String t = t0;
+	bool neg = false;
+	if (t.hasPrefix("!")) {
+		neg = true;
+		t.deleteChar(0);
+	}
+	bool v = false;
+	if (t == "sempre" || t == "always") {
+		v = true;
+	} else if (t == "mai" || t == "never") {
+		v = false;
+	} else if (t.hasPrefix("GF:")) {
+		uint16 i = _globalFlagsNames ? _globalFlagsNames->lookup(t.c_str() + 3) : Table::notFound;
+		v = i != Table::notFound && (g_globalFlags & (1u << (i - 1)));
+	} else if (t.hasPrefix("LF:")) {
+		// local flag of a location, kept per location slot by the engine also after leaving it
+		Common::String rest = t.substr(3);
+		int colon = rest.findFirstOf(':');
+		if (colon > 0) {
+			Common::String loc(rest.c_str(), colon);
+			for (uint i = 0; i < NUM_LOCATIONS && _locationNames[i][0]; i++)
+				if (!scumm_stricmp(_locationNames[i], loc.c_str())) {
+					uint32 bit = hintLocalFlag(loc, rest.substr(colon + 1));
+					if (!bit)
+						warning("hint: unknown local flag '%s'", t.c_str());
+					v = bit && (_localFlags[i] & bit);
+					break;
+				}
+		}
+	} else if (t.hasPrefix("INV:")) {
+		// INV:name (the current character), INV:<dino|donna|doug>:name, INV:*:name (any of the three)
+		Common::String rest = t.substr(4);
+		int colon = rest.findFirstOf(':');
+		Common::String who = colon > 0 ? Common::String(rest.c_str(), colon) : Common::String();
+		Common::String name = colon > 0 ? rest.substr(colon + 1) : rest;
+		uint16 i = _objectsNames ? _objectsNames->lookup(name.c_str()) : Table::notFound;
+		if (i != Table::notFound) {
+			if (who.empty()) {
+				v = _inventory && _inventory->findItem(4 + i) != -1;
+			} else if (who == "*") {
+				Inventory *inv[3] = { _dinoInventory, _donnaInventory, _dougInventory };
+				for (int k = 0; k < 3 && !v; k++)
+					v = inv[k] && inv[k]->findItem(4 + i) != -1;
+			} else {
+				Inventory *inv = findInventory(who.c_str());
+				if (!inv)
+					warning("hint: unknown character in '%s'", t.c_str());
+				v = inv && inv->findItem(4 + i) != -1;
+			}
+		}
+	} else if (t.hasPrefix("PRESO:") || t.hasPrefix("TAKEN:")) {
+		// the item has been in an inventory at least once in this part
+		uint16 i = _objectsNames ? _objectsNames->lookup(t.c_str() + 6) : Table::notFound;
+		v = i != Table::notFound && wasTaken(4 + i);
+	} else if (t.hasPrefix("ZONA:") || t.hasPrefix("ZONE:")) {
+		// ZONA:location:zone: the zone is on (not removed by OFF or FLAGS REMOVE)
+		Common::String rest = t.substr(5);
+		int colon = rest.findFirstOf(':');
+		if (colon > 0)
+			v = hintZoneOn(Common::String(rest.c_str(), colon), rest.substr(colon + 1));
+	} else if (t.hasPrefix("PG:") || t.hasPrefix("PC:")) {
+		// the character being played
+		v = !scumm_stricmp(_char.getName(), t.c_str() + 3);
+	} else if (t.hasPrefix("CNT:")) {
+		Common::String rest = t.substr(4);
+		int op = rest.findFirstOf("<>=");
+		if (op > 0 && _countersNames) {
+			Common::String name(rest.c_str(), op);
+			int n = atoi(rest.c_str() + op + 1);
+			uint16 i = _countersNames->lookup(name.c_str());
+			if (i != Table::notFound) {
+				int c = _counters[i - 1];
+				v = rest[op] == '<' ? c < n : rest[op] == '>' ? c > n : c == n;
+			}
+		}
+	} else if (t.hasPrefix("LOC:")) {
+		v = !scumm_stricmp(_location._name, t.c_str() + 4);
+	} else if (t.hasPrefix("VISTO:")) {
+		for (uint i = 0; i < NUM_LOCATIONS && _locationNames[i][0]; i++)
+			if (!scumm_stricmp(_locationNames[i], t.c_str() + 6)) {
+				// a slot is allocated on the first entry (kFlagsVisited only marks a return)
+				v = true;
+				break;
+			}
+	} else {
+		warning("hint: unknown condition '%s'", t.c_str());
+	}
+	return neg ? !v : v;
+}
+
+// "A | B C": (A or B) and C
+bool Parallaction_br::hintCondition(const Common::String &cond) {
+	if (cond.empty())
+		return false;
+	Common::StringTokenizer and_(cond, " ");
+	Common::StringArray words = and_.split();
+	// rebuild groups: "A", "|", "B" joined into one OR group
+	Common::Array<Common::StringArray> groups;
+	bool join = false;
+	for (uint i = 0; i < words.size(); i++) {
+		if (words[i].empty())
+			continue;
+		if (words[i] == "|") {
+			join = true;
+			continue;
+		}
+		Common::StringTokenizer or_(words[i], "|");
+		Common::StringArray alts = or_.split();
+		if (join && !groups.empty()) {
+			for (uint k = 0; k < alts.size(); k++)
+				groups.back().push_back(alts[k]);
+		} else {
+			groups.push_back(alts);
+		}
+		join = words[i].hasSuffix("|");
+	}
+	for (uint g = 0; g < groups.size(); g++) {
+		bool any = false;
+		for (uint k = 0; k < groups[g].size() && !any; k++)
+			if (!groups[g][k].empty())
+				any = hintTerm(groups[g][k]);
+		if (!any)
+			return false;
+	}
+	return true;
+}
+
+static void slashToNewline(Common::String &s) {
+	for (uint i = 0; i < s.size(); i++)
+		if (s[i] == '/')
+			s.setChar('\n', i);
+}
+
+// The hint window: drawn by hand like the game's menu (menu_br.cpp): the rays of the app's loader inside a red
+// frame, white title, gold labels, light text, buttons black with red lettering in the menu's fake Cyrillic
+// face; large text, about the size of the game's own lettering. Fonts are the theme's Rubik
+// TTFs at a size relative to the overlay height; without them (builtin theme) the GUI bold font is used.
+class HintView : public GUI::Widget {
+public:
+	HintView(GUI::GuiObject *boss) : GUI::Widget(boss, 0, 0, 1, 1, false) {
+		setFlags(GUI::WIDGET_ENABLED);
+	}
+	Graphics::ManagedSurface _surf;
+	Common::Rect _buttons[2];
+	int _numButtons = 0;
+	int _pressed = -1;
+
+	void drawWidget() override {
+		if (_surf.getPixels())
+			g_gui.theme()->drawManagedSurface(Common::Point(_x, _y), _surf, Graphics::ALPHA_FULL);
+	}
+	void handleMouseUp(int x, int y, int button, int clickCount) override;
+};
+
+class HintDialog : public GUI::Dialog {
+public:
+	HintDialog(const Common::U32String &title, const Common::U32String &situation, const Common::U32String &hintLabel,
+			const Common::U32String &hint, const Common::U32String &solLabel, const Common::U32String &solution,
+			const Common::U32String &closeLabel, const Common::U32String &solButton)
+		: GUI::Dialog(0, 0, 16, 16), _title(title), _situation(situation), _hintLabel(hintLabel), _hint(hint),
+		  _solLabel(solLabel), _solution(solution), _close(closeLabel), _solButton(solButton) {
+		_backgroundType = GUI::ThemeEngine::kDialogBackgroundNone;
+		_view = new HintView(this);
+		layout();
+	}
+
+	void choose(int b) {
+		if (b == 1 && !_showSolution) {
+			_showSolution = true;
+			layout();
+			g_gui.scheduleTopDialogRedraw();
+			return;
+		}
+		close();
+	}
+
+	void handleKeyDown(Common::KeyState state) override {
+		if (state.keycode == Common::KEYCODE_s && !_showSolution && !_solution.empty()) {
+			choose(1);
+			return;
+		}
+		if (state.keycode == Common::KEYCODE_RETURN || state.keycode == Common::KEYCODE_KP_ENTER ||
+			state.keycode == Common::KEYCODE_h || state.keycode == Common::KEYCODE_SPACE) {
+			close();
+			return;
+		}
+		GUI::Dialog::handleKeyDown(state);
+	}
+
+private:
+	Common::U32String _title, _situation, _hintLabel, _hint, _solLabel, _solution, _close, _solButton;
+	bool _showSolution = false;
+	HintView *_view;
+
+	struct Block {
+		const Graphics::Font *font;
+		uint32 color;
+		Common::Array<Common::U32String> lines;
+		int gap;
+	};
+
+	void layout() {
+		const int ow = g_system->getOverlayWidth(), oh = g_system->getOverlayHeight();
+		// body text about as tall as the game's lettering (16 px of 400 in the original)
+		int em = MAX(14, MIN(oh, ow * 10 / 16) * 34 / 1000);
+		GUI::ThemeEngine *th = g_gui.theme();
+		const Graphics::Font *body = th->getScalableFont("Rubik-Regular.ttf", em);
+		const Graphics::Font *bold = th->getScalableFont("Rubik-SemiBold.ttf", em);
+		const Graphics::Font *big = th->getScalableFont("Rubik-SemiBold.ttf", em * 5 / 4);
+		const Graphics::Font *fb = th->getFont(GUI::ThemeEngine::kFontStyleBold);
+		if (!body) body = th->getFont(GUI::ThemeEngine::kFontStyleNormal);
+		if (!bold) bold = fb;
+		if (!big) big = fb;
+
+		const int W = MIN(ow * 86 / 100, em * 34);
+		const int pad = em, border = MAX(2, em / 8);
+		const int textW = W - 2 * pad - 2 * border;
+
+		Graphics::PixelFormat fmt(4, 8, 8, 8, 8, 24, 16, 8, 0);
+		// the colours of the menu (tools/web/tema_bra.py): paper text, gold labels, red frame and lettering
+		const uint32 cText = fmt.ARGBToColor(255, 0xf3, 0xec, 0xe0);
+		const uint32 cLabel = fmt.ARGBToColor(255, 0xf0, 0xb4, 0x29);
+		const uint32 cWhite = fmt.ARGBToColor(255, 0xff, 0xff, 0xff);
+		const uint32 cShadow = fmt.ARGBToColor(255, 0x0c, 0x08, 0x08);
+		const uint32 cRed = fmt.ARGBToColor(255, 0xc8, 0x16, 0x20), cLine = fmt.ARGBToColor(255, 0x78, 0x16, 0x1c);
+		const uint32 cInk = fmt.ARGBToColor(255, 0x0c, 0x08, 0x08), cButton = fmt.ARGBToColor(255, 0xe6, 0x28, 0x2e);
+		const Graphics::Font *russia = th->getScalableFont("RubikMonoOne-Russia.ttf", em * 17 / 20);
+		if (!russia)
+			russia = bold;
+
+		Common::Array<Block> blocks;
+		auto add = [&](const Graphics::Font *f, uint32 c, const Common::U32String &t, int gap) {
+			if (t.empty())
+				return;
+			Block b;
+			b.font = f;
+			b.color = c;
+			b.gap = gap;
+			f->wordWrapText(t, textW, b.lines);
+			blocks.push_back(b);
+		};
+		add(body, cText, _situation, 0);
+		add(bold, cLabel, _hintLabel, em * 3 / 4);
+		add(body, cText, _hint, em / 6);
+		if (_showSolution) {
+			add(bold, cLabel, _solLabel, em * 3 / 4);
+			add(body, cText, _solution, em / 6);
+		}
+
+		Common::Array<Common::U32String> titleLines;
+		big->wordWrapText(_title, textW, titleLines);
+		const int titleLH = big->getFontHeight() + em / 8;
+		const int headH = pad * 3 / 4 * 2 + titleLines.size() * titleLH;
+
+		int bodyH = 0;
+		for (uint i = 0; i < blocks.size(); i++)
+			bodyH += blocks[i].gap + blocks[i].lines.size() * (blocks[i].font->getFontHeight() + em / 5);
+
+		// buttons
+		Common::U32String labels[2] = { _close, _solButton };
+		_view->_numButtons = (_showSolution || _solution.empty()) ? 1 : 2;
+		const int bh = bold->getFontHeight() + em;
+		int bw[2], totalBW = 0;
+		for (int i = 0; i < _view->_numButtons; i++) {
+			Common::U32String up = labels[i];
+			up.toUppercase();
+			bw[i] = russia->getStringWidth(up) + em * 2;	// measured in the face the button is drawn with
+			totalBW += bw[i];
+		}
+		totalBW += (_view->_numButtons - 1) * em;
+
+		int H = border + headH + pad + bodyH + pad + bh + pad + border;
+		const int maxH = oh * 94 / 100;
+		if (H > maxH)
+			H = maxH;	// very long texts get cut at the bottom: keep them short (docs/aiuti.md)
+
+		Graphics::ManagedSurface &s = _view->_surf;
+		s.create(W, H, fmt);
+		// red frame, the rays inside (like the menu's windows), a red line under the title
+		s.fillRect(Common::Rect(W, H), cRed);
+		{
+			Graphics::Surface rays;
+			hdPaintRays(rays, fmt, W - 2 * border, H - 2 * border, 0.22f, 0.35f);
+			s.copyRectToSurface(rays, border, border, Common::Rect(rays.w, rays.h));
+			rays.free();
+		}
+		Common::Rect head(border, border, W - border, border + headH);
+		s.fillRect(Common::Rect(head.left + pad, head.bottom - MAX(1, border / 2), head.right - pad, head.bottom), cLine);
+		int y = head.top + pad * 3 / 4;
+		const int sh = MAX(1, em / 12);
+		for (uint i = 0; i < titleLines.size(); i++, y += titleLH) {
+			big->drawString(&s, titleLines[i], border + pad + sh, y + sh, textW, cShadow, Graphics::kTextAlignCenter);
+			big->drawString(&s, titleLines[i], border + pad, y, textW, cWhite, Graphics::kTextAlignCenter);
+		}
+
+		const int bottomLimit = H - border - pad - bh - pad / 2;
+		y = head.bottom + pad;
+		for (uint i = 0; i < blocks.size(); i++) {
+			y += blocks[i].gap;
+			const int lh = blocks[i].font->getFontHeight() + em / 5;
+			for (uint k = 0; k < blocks[i].lines.size() && y + lh <= bottomLimit; k++, y += lh)
+				blocks[i].font->drawString(&s, blocks[i].lines[k], border + pad, y, textW, blocks[i].color);
+		}
+
+		int bx = (W - totalBW) / 2, by = H - border - pad - bh;
+		for (int i = 0; i < _view->_numButtons; i++) {
+			Common::Rect r(bx, by, bx + bw[i], by + bh);
+			_view->_buttons[i] = r;
+			// the menu's buttons: black with a thin red edge, red lettering
+			s.fillRect(r, cLine);
+			s.fillRect(Common::Rect(r.left + MAX(1, border / 2), r.top + MAX(1, border / 2), r.right - MAX(1, border / 2), r.bottom - MAX(1, border / 2)), cInk);
+			Common::U32String up = labels[i];
+			up.toUppercase();
+			russia->drawString(&s, up, r.left, r.top + (bh - russia->getFontHeight()) / 2, r.width(), cButton, Graphics::kTextAlignCenter);
+			bx += bw[i] + em;
+		}
+
+		_w = W;
+		_h = H;
+		_x = (ow - W) / 2;
+		_y = (oh - H) / 2;
+		_view->resize(0, 0, W, H, false);
+		_view->markAsDirty();
+	}
+};
+
+void HintView::handleMouseUp(int x, int y, int button, int clickCount) {
+	for (int i = 0; i < _numButtons; i++)
+		if (_buttons[i].contains(x, y)) {
+			((HintDialog *)_boss)->choose(i);
+			return;
+		}
+}
+
+
+// hint/<language>.txt of the game's language (German: de or ge), else English, else Italian (the hints have
+// no original text to fall back to); code: the language of the file, for the window's own words
+static Common::Array<HintEntry> loadGameHints(uint lang, Common::String &code) {
+	Common::StringArray langs = braLanguageCodes(lang);
+	langs.push_back("en");
+	langs.push_back("it");
+	Common::Array<HintEntry> list;
+	code = langs[0];
+	for (uint i = 0; list.empty() && i < langs.size(); i++) {
+		list = loadHints(langs[i].c_str());
+		if (!list.empty())
+			code = langs[i];
+	}
+	return list;
+}
+
+// the window's own words in the language of the hints shown (UTF-8)
+static Common::U32String hintWord(const Common::String &code, const char *it, const char *en, const char *fr, const char *de) {
+	const char *t = en;
+	if (code == "it")
+		t = it;
+	else if (code == "fr")
+		t = fr;
+	else if (code == "de" || code == "ge")
+		t = de;
+	return Common::U32String(t, Common::kUtf8);
+}
+
+void Parallaction_br::logHint() {
+	Common::String code;
+	Common::Array<HintEntry> list = loadGameHints(getInternLanguage(), code);
+	debug("HINT file hint/%s.txt", code.c_str());
+	for (uint i = 0; i < list.size(); i++)
+		if (list[i].part == (int)_part && !hintCondition(list[i].done)) {
+			debug("HINT part %d #%u: %s", _part, i, list[i].title.c_str());
+			return;
+		}
+	debug("HINT part %d: all done (%u entries)", _part, list.size());
+}
+
+void Parallaction_br::showHint() {
+	Common::String code;
+	Common::Array<HintEntry> list = loadGameHints(getInternLanguage(), code);
+
+	const HintEntry *found = nullptr;
+	bool anyForPart = false;
+	for (uint i = 0; i < list.size(); i++) {
+		if (list[i].part != (int)_part)
+			continue;
+		anyForPart = true;
+		if (!hintCondition(list[i].done)) {
+			found = &list[i];
+			break;
+		}
+	}
+
+	// UTF-8 file -> the GUI (U32String)
+	Common::U32String text;
+	if (!found) {
+		text = anyForPart
+			? hintWord(code, "Hai fatto tutto quello che serve in questa parte: prosegui!", "You have done everything needed in this part: go on!",
+				"Vous avez fait tout le nécessaire dans cette partie : continuez !", "Du hast in diesem Teil alles Nötige erledigt: weiter geht's!")
+			: hintWord(code, "Per questa parte del gioco gli aiuti non sono ancora disponibili.", "No hints yet for this part of the game.",
+				"Pas encore d'aide pour cette partie du jeu.", "Für diesen Teil des Spiels gibt es noch keine Hilfe.");
+		HintDialog dlg(hintWord(code, "Aiuti", "Hints", "Aide", "Hilfe"), text, Common::U32String(), Common::U32String(),
+			Common::U32String(), Common::U32String(), hintWord(code, "Chiudi", "Close", "Fermer", "Schließen"), Common::U32String());
+		runDialog(dlg);
+		return;
+	}
+	Common::String title = found->title, situation = found->situation, hint = found->hint, sol = found->solution;
+	slashToNewline(situation);
+	slashToNewline(hint);
+	slashToNewline(sol);
+	HintDialog dlg(Common::U32String(title.c_str(), Common::kUtf8), Common::U32String(situation.c_str(), Common::kUtf8),
+		hintWord(code, "Indizio", "Hint", "Indice", "Tipp"), Common::U32String(hint.c_str(), Common::kUtf8),
+		hintWord(code, "Soluzione", "Solution", "Solution", "Lösung"), Common::U32String(sol.c_str(), Common::kUtf8),
+		hintWord(code, "Chiudi", "Close", "Fermer", "Schließen"),
+		hintWord(code, "Mostra la soluzione", "Show the solution", "Afficher la solution", "Lösung zeigen"));
+	runDialog(dlg);
+}
+
