+class BraSettingsDialog : public RaysDialog {
+	enum {
+		kMusicCmd = 'BMUS',
+		kSfxCmd = 'BSFX',
+		kSpeechCmd = 'BSPE',
+		kScreenCmd = 'BSCR',
+		kShortcutsCmd = 'BSHO',
+		kDirectorsCutCmd = 'BDCU',
+		kDropboxAutoCmd = 'BDBA',
+		kDropboxSyncCmd = 'BDBS',
+		kCloseCmd = 'BCLO'
+	};
+	enum { kFit = 0, kFill = 1, kStretch = 2 };
+
+	Engine *_engine;
+	GUI::StaticTextWidget *_dropboxText, *_dropboxText2;
+	GUI::CheckboxWidget *_dropboxAuto;
+	GUI::ButtonWidget *_dropboxSync;
+	GUI::RadiobuttonGroup *_screen;
+	uint32 _nextPoll = 0;
+	Common::String _shownState = "-";
+	// setState/setValue of ScummVM's widgets send their command as a click would: not while the dialog
+	// is being built or shows what the host says
+	bool _quiet = true;
+
+	GUI::SliderWidget *slider(const char *name, const char *it, const char *en, const char *fr, const char *de, const char *key, uint32 cmd) {
+		new GUI::StaticTextWidget(this, Common::String::format("BraSettings.%sText", name), T(it, en, fr, de), Common::U32String(), GUI::ThemeEngine::kFontStyleNormal);
+		GUI::SliderWidget *s = new GUI::SliderWidget(this, Common::String::format("BraSettings.%sSlider", name), Common::U32String(), cmd);
+		s->setMinValue(0);
+		s->setMaxValue(Audio::Mixer::kMaxMixerVolume);
+		s->setValue(ConfMan.hasKey(key) ? ConfMan.getInt(key) : Audio::Mixer::kMaxMixerVolume);
+		return s;
+	}
+
+	// the title of a group of settings (Audio, Screen, Game, Dropbox): bold, in the theme's alternative colour (gold)
+	void header(const char *name, const Common::U32String &text) {
+		GUI::StaticTextWidget *t = new GUI::StaticTextWidget(this, Common::String::format("BraSettings.%s", name), text);
+		t->setFontColor(GUI::ThemeEngine::kFontColorAlternate);
+	}
+
+	static const char *modeName(int v) {
+		return v == kFill ? "fill" : v == kStretch ? "stretch" : "fit";
+	}
+
+	void setVolume(const char *key, int v) {
+		ConfMan.setInt(key, v);
+		ConfMan.setInt(key, v, Common::ConfigManager::kApplicationDomain);
+		if (v > 0)
+			ConfMan.setBool("mute", false);
+		_engine->syncSoundSettings();
+	}
+
+	void setScreen(int v) {
+		const char *name = modeName(v);
+		for (const OSystem::GraphicsMode *m = g_system->getSupportedStretchModes(); m && m->name; m++) {
+			if (!scumm_stricmp(m->name, name)) {
+				g_system->beginGFXTransaction();
+				g_system->setStretchMode(m->id);
+				g_system->endGFXTransaction();
+				break;
+			}
+		}
+		ConfMan.set("stretch_mode", name, Common::ConfigManager::kApplicationDomain);
+	}
+
+	void showDropbox() {
+		Common::String st = Host::dropboxState();
+		if (st == _shownState)
+			return;
+		_shownState = st;
+		// "linked\tauto\tbusy\ttext"
+		Common::Array<Common::String> p;
+		Common::String rest = st;
+		for (int i = 0; i < 3; i++) {
+			int t = rest.find('\t');
+			if (t < 0)
+				break;
+			p.push_back(rest.substr(0, t));
+			rest = rest.substr(t + 1);
+		}
+		bool ok = p.size() == 3;
+		bool linked = ok && p[0] == "1", automatic = ok && p[1] == "1", busy = ok && p[2] == "1";
+		Common::U32String text = ok ? Common::U32String(rest, Common::kUtf8)
+			: T("Non disponibile qui.", "Not available here.", "Non disponible ici.", "Hier nicht verfügbar.");
+		// two lines, wrapped on the width of the widget (the status texts of the page are long for a phone)
+		Common::Array<Common::U32String> lines;
+		g_gui.getFont(GUI::ThemeEngine::kFontStyleNormal).wordWrapText(text, MAX<int>(_dropboxText->getWidth(), 40), lines);
+		_dropboxText->setLabel(lines.size() > 0 ? lines[0] : Common::U32String());
+		Common::U32String second;
+		for (uint i = 1; i < lines.size(); i++)
+			second += (i > 1 ? Common::U32String(" ") : Common::U32String()) + lines[i];
+		_dropboxText2->setLabel(second);
+		bool q = _quiet;
+		_quiet = true;
+		_dropboxAuto->setState(linked && automatic);
+		_quiet = q;
+		_dropboxAuto->setEnabled(linked && !busy);
+		_dropboxSync->setEnabled(linked && !busy);
+		g_gui.scheduleTopDialogRedraw();
+	}
+
+public:
+	BraSettingsDialog(Engine *engine) : RaysDialog("BraSettings"), _engine(engine) {
+		new GUI::StaticTextWidget(this, "BraSettings.Title", T("Impostazioni", "Settings", "Paramètres", "Einstellungen"));
+
+		header("AudioTitle", T("Audio", "Audio", "Audio", "Audio"));
+		slider("Music", "Musica", "Music", "Musique", "Musik", "music_volume", kMusicCmd);
+		slider("Sfx", "Effetti", "Effects", "Effets", "Effekte", "sfx_volume", kSfxCmd);
+		slider("Speech", "Voci", "Voices", "Voix", "Stimmen", "speech_volume", kSpeechCmd);
+
+		header("ScreenText", T("Schermo", "Screen", "Écran", "Bildschirm"));
+		_screen = new GUI::RadiobuttonGroup(this, kScreenCmd);
+		new GUI::RadiobuttonWidget(this, "BraSettings.ScreenFit", _screen, kFit, T("Originale (bande nere)", "Original (black bands)", "Original (bandes noires)", "Original (schwarze Balken)"));
+		new GUI::RadiobuttonWidget(this, "BraSettings.ScreenFill", _screen, kFill, T("Riempi (taglia i bordi)", "Fill (crops the edges)", "Remplir (rogne les bords)", "Füllen (Ränder weg)"));
+		new GUI::RadiobuttonWidget(this, "BraSettings.ScreenStretch", _screen, kStretch, T("Allarga", "Stretch", "Étirer", "Strecken"));
+		Common::String mode = ConfMan.hasKey("stretch_mode") ? ConfMan.get("stretch_mode") : "fit";
+		_screen->setValue(mode == "fill" ? kFill : mode == "stretch" ? kStretch : kFit);
+
+		header("GameTitle", T("Gioco", "Game", "Jeu", "Spiel"));
+		GUI::CheckboxWidget *sc = new GUI::CheckboxWidget(this, "BraSettings.Shortcuts",
+			T("Pulsanti rapidi a schermo", "Quick buttons on screen", "Boutons rapides à l'écran", "Schnelltasten am Bildschirm"), Common::U32String(), kShortcutsCmd);
+		sc->setState(!ConfMan.hasKey("bra_scorciatoie") || ConfMan.getBool("bra_scorciatoie"));
+
+		// the launcher's game option (game domain); a change counts from the next location
+		GUI::CheckboxWidget *dc = new GUI::CheckboxWidget(this, "BraSettings.DirectorsCut",
+			Common::U32String("Director's Cut"), T("Scene e battute tagliate dall'originale (dalla stanza successiva)",
+			"Scenes and lines cut from the original (from the next location)",
+			"Scènes et répliques coupées de l'original (dès le lieu suivant)",
+			"Aus dem Original geschnittene Szenen und Sätze (ab dem nächsten Ort)"), kDirectorsCutCmd);
+		dc->setState(braSettingOn("bra_directors_cut"));
+
+		header("DropboxTitle", T("Salvataggi su Dropbox", "Saves on Dropbox", "Sauvegardes sur Dropbox", "Spielstände auf Dropbox"));
+		_dropboxText = new GUI::StaticTextWidget(this, "BraSettings.DropboxText", Common::U32String(), Common::U32String(), GUI::ThemeEngine::kFontStyleNormal);
+		_dropboxText2 = new GUI::StaticTextWidget(this, "BraSettings.DropboxText2", Common::U32String(), Common::U32String(), GUI::ThemeEngine::kFontStyleNormal);
+		_dropboxAuto = new GUI::CheckboxWidget(this, "BraSettings.DropboxAuto", T("Sincronizza da solo", "Sync automatically", "Synchroniser automatiquement", "Automatisch synchronisieren"), Common::U32String(), kDropboxAutoCmd);
+		_dropboxSync = new GUI::ButtonWidget(this, "BraSettings.DropboxSync", T("Sincronizza ora", "Sync now", "Synchroniser maintenant", "Jetzt synchronisieren"), Common::U32String(), kDropboxSyncCmd);
+
+		new GUI::ButtonWidget(this, "BraSettings.Close", T("Fatto", "Done", "OK", "Fertig"), Common::U32String(), kCloseCmd);
+		_quiet = false;
+	}
+
+	void open() override {
+		RaysDialog::open();
+		_shownState = "-";
+		Host::send("dropbox-stato");
+		showDropbox();
+	}
+
+	void handleTickle() override {
+		RaysDialog::handleTickle();
+		if (g_system->getMillis() >= _nextPoll) {
+			_nextPoll = g_system->getMillis() + 400;
+			showDropbox();
+		}
+	}
+
+	void handleCommand(GUI::CommandSender *sender, uint32 cmd, uint32 data) override {
+		if (_quiet && cmd != kCloseCmd)
+			return;
+		switch (cmd) {
+		case kMusicCmd: setVolume("music_volume", data); break;
+		case kSfxCmd: setVolume("sfx_volume", data); break;
+		case kSpeechCmd: setVolume("speech_volume", data); break;
+		case kScreenCmd: setScreen(data); break;
+		case kShortcutsCmd:
+			ConfMan.setBool("bra_scorciatoie", data != 0, Common::ConfigManager::kApplicationDomain);
+			Host::send(data ? "scorciatoie 1" : "scorciatoie 0");
+			break;
+		case kDirectorsCutCmd:
+			// with a launcher (app, web page) the setting is its own (command line, transient domain): this session
+			// only, and the launcher is told to keep it; with ScummVM alone, the game's option of the launcher
+			if (Host::present() || ConfMan.getDomain(Common::ConfigManager::kTransientDomain)->contains("bra_directors_cut"))
+				ConfMan.setBool("bra_directors_cut", data != 0, Common::ConfigManager::kTransientDomain);
+			else
+				ConfMan.setBool("bra_directors_cut", data != 0, ConfMan.getActiveDomainName());
+			Host::send(data ? "directors-cut 1" : "directors-cut 0");
+			break;
+		case kDropboxAutoCmd:
+			Host::send(data ? "dropbox-auto 1" : "dropbox-auto 0");
+			break;
+		case kDropboxSyncCmd:
+			_dropboxSync->setEnabled(false);
+			Host::send("dropbox-sincronizza");
+			break;
+		case kCloseCmd:
+			ConfMan.flushToDisk();
+			close();
+			break;
+		default:
+			RaysDialog::handleCommand(sender, cmd, data);
+		}
+	}
+
+	void close() override {
+		ConfMan.flushToDisk();
+		RaysDialog::close();
+	}
+};
+
+/* ---------------- info ---------------- */
+
+class BraInfoDialog : public RaysDialog {
+	enum { kManualCmd = 'BMAN', kCreditsCmd = 'BCRE', kAboutCmd = 'BABO', kBackCmd = 'BBAC' };
+	Parallaction_br *_vm;
+
+public:
+	bool _manual = false;
+
+	BraInfoDialog(Parallaction_br *vm) : RaysDialog("BraInfo"), _vm(vm) {
+		new GUI::StaticTextWidget(this, "BraInfo.Title", Common::U32String("The Big Red Adventure"));
+		Common::String patch;
+		Common::File f;
+		if (f.open("VERSIONE.txt")) {
+			Common::String line = f.readLine();
+			int pos = line.find("patch ");
+			patch = pos >= 0 ? line.substr(pos + 6) : line;
+			patch.trim();
+		}
+		new GUI::StaticTextWidget(this, "BraInfo.Patch",
+			Common::U32String(patch.empty() ? Common::String("Remaster") : "Remaster - patch " + patch), Common::U32String(), GUI::ThemeEngine::kFontStyleNormal);
+		new GUI::StaticTextWidget(this, "BraInfo.Engine",
+			T("Motore: ScummVM ", "Engine: ScummVM ", "Moteur : ScummVM ", "Engine: ScummVM ") + Common::U32String(gScummVMVersion), Common::U32String(), GUI::ThemeEngine::kFontStyleNormal);
+		new GUI::ButtonWidget(this, "BraInfo.Manual", T("Manuale del gioco", "Game manual", "Manuel du jeu", "Spielhandbuch"), Common::U32String(), kManualCmd);
+		// the remaster's credits (crediti/<language>.txt of the patch), when there are
+		if (_vm->hasCredits("crediti"))
+			new GUI::ButtonWidget(this, "BraInfo.Credits", T("Crediti del remaster", "Remaster credits", "Crédits du remaster", "Remaster-Credits"), Common::U32String(), kCreditsCmd);
+		new GUI::ButtonWidget(this, "BraInfo.About", T("ScummVM e licenze", "ScummVM and licences", "ScummVM et licences", "ScummVM und Lizenzen"), Common::U32String(), kAboutCmd);
+		new GUI::ButtonWidget(this, "BraInfo.Back", T("Indietro", "Back", "Retour", "Zurück"), Common::U32String(), kBackCmd);
+	}
+
+	void handleCommand(GUI::CommandSender *sender, uint32 cmd, uint32 data) override {
+		switch (cmd) {
+		case kManualCmd:
+			_manual = true;
+			close();
+			break;
+		case kCreditsCmd:
+			_vm->showCredits("crediti");
+			break;
+		case kAboutCmd: {
+			GUI::AboutDialog about(true);
+			about.runModal();
+			break;
+		}
+		case kBackCmd:
+			close();
+			break;
+		default:
+			RaysDialog::handleCommand(sender, cmd, data);
+		}
+	}
+};
+
+/* ---------------- the menu ---------------- */
+
+class BraMenuDialog : public MainMenuDialog {
+	enum { kHintsCmd = 'BHIN', kRemasterCmd = 'BREM', kSettingsCmd = 'BSET', kInfoCmd = 'BINF', kExitCmd = 'BEXI' };
+
+	Parallaction_br *_vm;
+	Rays _rays;
+	GUI::ButtonWidget *_hints;
+	GUI::ButtonWidget *_remaster;
+
+	bool hd() const { return _vm->_gfx && _vm->_gfx->_hd; }
+
+	void updateRemaster() {
+		_remaster->setLabel(hd() && !hdClassic() ? Common::U32String("Remastered: ON") : Common::U32String("Remastered: OFF"));
+	}
+
+public:
+	BraMenuDialog(Parallaction_br *vm) : MainMenuDialog(vm, false), _vm(vm) {
+		new GUI::ButtonWidget(this, "GlobalMenu.Resume", T("Riprendi", "Resume", "Reprendre", "Fortsetzen"), Common::U32String(), kPlayCmd);
+		new GUI::ButtonWidget(this, "GlobalMenu.Load", T("Carica", "Load", "Charger", "Laden"), Common::U32String(), kLoadCmd);
+		new GUI::ButtonWidget(this, "GlobalMenu.Save", T("Salva", "Save", "Sauvegarder", "Speichern"), Common::U32String(), kSaveCmd);
+		_hints = new GUI::ButtonWidget(this, "GlobalMenu.Hints", T("Suggerimenti", "Hints", "Aide", "Tipps"), Common::U32String(), kHintsCmd);
+		_remaster = new GUI::ButtonWidget(this, "GlobalMenu.Remaster", Common::U32String("Remastered: ON"), Common::U32String(), kRemasterCmd);
+		new GUI::ButtonWidget(this, "GlobalMenu.Settings", T("Impostazioni", "Settings", "Paramètres", "Einstellungen"), Common::U32String(), kSettingsCmd);
+		new GUI::ButtonWidget(this, "GlobalMenu.Info", Common::U32String("Info"), Common::U32String(), kInfoCmd);
+		new GUI::ButtonWidget(this, "GlobalMenu.Quit", T("Esci", "Quit", "Quitter", "Beenden"), Common::U32String(), kExitCmd);
+	}
+
+	void open() override {
+		// hints: while playing (not in the game's own menus), not in the demo
+		_hints->setEnabled(_vm->_input && _vm->_input->_inputMode != Input::kInputModeMenu && (_vm->getFeatures() & GF_DEMO) == 0);
+		_remaster->setEnabled(hd());
+		updateRemaster();
+		MainMenuDialog::open();
+	}
+
+	void reflowLayout() override {
+		MainMenuDialog::reflowLayout();
+		_rays.place(this);
+	}
+
+protected:
+	void drawDecoration() override { _rays.draw(this); }
+
+public:
+
+	void handleCommand(GUI::CommandSender *sender, uint32 cmd, uint32 data) override {
+		switch (cmd) {
+		case kHintsCmd:
+			_vm->_input->requestHint();
+			close();
+			break;
+		case kRemasterCmd:
+			if (hd())
+				_vm->_gfx->toggleClassic();
+			updateRemaster();
+			close();	// the picture changes under the menu: let it be seen
+			break;
+		case kSettingsCmd: {
+			BraSettingsDialog d(_vm);
+			d.runModal();
+			break;
+		}
+		case kInfoCmd: {
+			BraInfoDialog d(_vm);
+			d.runModal();
+			if (d._manual && (_vm->getFeatures() & GF_DEMO) == 0) {
+				_vm->_input->requestManual();
+				close();
+			}
+			break;
+		}
+		case kExitCmd: {
+			GUI::MessageDialog ask(T("Uscire dal gioco? Quello che non hai salvato andrà perso.",
+				"Quit the game? Anything you have not saved will be lost.",
+				"Quitter le jeu ? Tout ce qui n'a pas été sauvegardé sera perdu.",
+				"Spiel beenden? Alles, was du nicht gespeichert hast, geht verloren."), T("Esci", "Quit", "Quitter", "Beenden"), T("Annulla", "Cancel", "Annuler", "Abbrechen"));
+			if (ask.runModal() == GUI::kMessageOK) {
+				Common::Event e;
+				e.type = Common::EVENT_QUIT;
+				g_system->getEventManager()->pushEvent(e);
+				close();
+			}
+			break;
+		}
+		default:
+			MainMenuDialog::handleCommand(sender, cmd, data);
+		}
+	}
+};
+
+GUI::Dialog *createBraMenu(Parallaction_br *vm) {
+	return new BraMenuDialog(vm);
+}
+
+} // End of namespace Parallaction
