+Common::String DosDisk_br::savedLocationFile(const char *background) {
+	static const char * const langs[4] = { "it/", "fr/", "en/", "ge/" };
+	Common::ScopedPtr<Common::SeekableReadStream> own(tryOpenFile(Common::String(langs[_language]) + background, ".loc"));
+	if (own)
+		return Common::String(background);
+	Common::ArchiveMemberList files;
+	_sset.listMatchingMembers(files, Common::Path(Common::String(langs[_language]) + "*.loc"));
+	for (Common::ArchiveMemberList::iterator it = files.begin(); it != files.end(); ++it) {
+		Common::ScopedPtr<Common::SeekableReadStream> s((*it)->createReadStream());
+		if (!s)
+			continue;
+		// the first statement of a location file: LOCATION <background> ...
+		while (!s->eos() && !s->err()) {
+			Common::String line = s->readLine();
+			line.trim();
+			if (line.empty() || line[0] == '#')
+				continue;
+			if (line.hasPrefixIgnoreCase("LOCATION ")) {
+				Common::String bg = line.substr(9);
+				bg.trim();
+				int sp = bg.findFirstOf(" \t");
+				if (sp > 0)
+					bg = bg.substr(0, sp);
+				if (!bg.compareToIgnoreCase(background)) {
+					Common::String f = (*it)->getFileName();
+					return f.substr(0, f.size() - 4);
+				}
+			}
+			break;
+		}
+	}
+	return Common::String(background);
 }
 
