+void HDRenderer::setPalette(const byte *rgb8, uint num) {
+	int changed = 0;
+	for (uint i = 0; i < num && i < 256; i++) {
+		if (_curPal[i * 3 + 0] == rgb8[i * 3 + 0] && _curPal[i * 3 + 1] == rgb8[i * 3 + 1] && _curPal[i * 3 + 2] == rgb8[i * 3 + 2])
+			continue;
+		_curPal[i * 3 + 0] = rgb8[i * 3 + 0];
+		_curPal[i * 3 + 1] = rgb8[i * 3 + 1];
+		_curPal[i * 3 + 2] = rgb8[i * 3 + 2];
+		_curPalPixel[i] = _format.RGBToColor(rgb8[i * 3], rgb8[i * 3 + 1], rgb8[i * 3 + 2]);
+		// an entry the room's effects freeze ("fermi"): the HD picture keeps its colours, its tiles need
+		// no new composition (the dock: its water cycles redrew a large part of the screen 16 times a
+		// second for the same result). The classic view and the fades still see it
+		if (_frozen[i] && !_classic)
+			continue;
+		if (!_palChanged[i]) {
+			_palChanged[i] = true;
+			_palChangedCount++;
+		}
+		changed++;
+	}
+	if (!changed)
+		return;
+	_paletteDirty = true;
+	_diffDirty = true;
+	// colour cycling changes a few entries at every step (the park fountain: 3 entries, COLOR in
+	// the animation script): composing the whole frame again each time made the pointer sluggish
+	// (~100 ms per step at 3x on a desktop, much more in the browser). Only the tiles using the
+	// changed entries are redrawn then; fades and new palettes still redraw everything
+	if (_palChangedCount > kPartialPaletteMax)
+		_fullRedraw = true;
+}
+
+void HDRenderer::updateModes() {
+	_paletteDirty = false;
+	// the last steps of a fade change few entries, like colour cycling: the whole frame still has
+	// to go down, the black of the picture included (its tiles do not use the changed entries)
+	if (computeModes(_bgPal, _mode, _factor))
+		_fullRedraw = true;
+}
+
+// the step of a fade of the whole palette by steps (Palette::fadeTo), 0 if this is not one: the amount
+// most entries went down by, read from their components not yet at 0. The same step for every entry,
+// also those already black (their HD pixels may be brighter: the edges of a logo)
+static int fadeStep(const byte *refPal, const byte *curPal) {
+	int votes[256] = { 0 }, n = 0, black = 0, lit = 0;
+	for (int i = 0; i < 256; i++) {
+		if (curPal[i * 3] | curPal[i * 3 + 1] | curPal[i * 3 + 2])
+			lit++;
+		else if (refPal[i * 3] | refPal[i * 3 + 1] | refPal[i * 3 + 2])
+			black++;
+		int d = -1;
+		bool ok = true;
+		for (int c = 0; c < 3 && ok; c++) {
+			int c0 = refPal[i * 3 + c], c1 = curPal[i * 3 + c];
+			if (c1 > c0)
+				ok = false;
+			else if (c1 > 0 && (d < 0 || c0 - c1 > d))
+				d = c0 - c1;
+		}
+		if (ok && d > 0) {
+			votes[d]++;
+			n++;
+		}
+	}
+	int best = 0;
+	for (int d = 1; d < 256; d++)	// 6-bit steps become 4..7 in 8 bits: neighbours count together
+		if (votes[d] + (d > 1 ? votes[d - 1] : 0) + (d < 255 ? votes[d + 1] : 0) > votes[best] + (best > 0 ? votes[best - 1] : 0) + (best > 0 && best < 255 ? votes[best + 1] : 0))
+			best = d;
+	if (!lit && black >= 16)	// the last step: all black, the HD pixels too
+		return 255;
+	// near the end few entries are still lit (the white of a logo): those already black count as
+	// part of the fade, or their HD pixels came back at full brightness
+	return n + black >= 16 && n * 2 >= lit ? best : 0;
+}
+
+// -> the step of a fade of the whole palette, 0 if this is not one
+int HDRenderer::computeModes(const byte *refPal, byte *mode, uint16 *factor) {
+	const int step = fadeStep(refPal, _curPal);
+	for (int i = 0; i < 256; i++) {
+		int r0 = refPal[i * 3], g0 = refPal[i * 3 + 1], b0 = refPal[i * 3 + 2];
+		int r1 = _curPal[i * 3], g1 = _curPal[i * 3 + 1], b1 = _curPal[i * 3 + 2];
+
+		// black stays black in a fade, but its HD pixels may be brighter (the soft edges of the black
+		// strokes of a logo): they go down with the rest, or they stayed as a ghost on the black screen
+		if (r0 == r1 && g0 == g1 && b0 == b1 && !(step > 0 && MAX(r0, MAX(g0, b0)) <= 8)) {
+			mode[i] = kHDSame;
+			continue;
+		}
+		// the room's effects say this entry belongs to an old colour cycle: the HD picture keeps
+		// its own colours (fades of the whole palette still apply: they change every entry)
+		if (_frozen[i] && !_classic && mode == _mode && _palChangedCount <= kPartialPaletteMax) {
+			mode[i] = kHDSame;
+			continue;
+		}
+
+		// fade of the whole palette by steps (Palette::fadeTo: the splashes of the start): each
+		// 6-bit component lowered by 1 at every step down to 0, not a scale. Shaded colours (the
+		// Core logo, the edges of the Dynabyte one) failed the scale test and jumped between
+		// shifted and low-res pixels from one step to the next: they flickered
+		if (step > 0) {
+			const int c0[3] = { r0, g0, b0 }, c1[3] = { r1, g1, b1 };
+			bool ok = true;
+			for (int c = 0; c < 3 && ok; c++)
+				ok = ABS(MAX(0, c0[c] - step) - c1[c]) <= 5;
+			if (ok) {	// the HD pixel lowered by the same step: brighter ones (the edges of a logo) too
+				mode[i] = kHDDarken;
+				factor[i] = step;
+				continue;
+			}
+		}
+		int m0 = MAX(r0, MAX(g0, b0));
+		// fade: every component scaled by the same factor (black included)
+		if (m0 > 0) {
+			int f = (MAX(r1, MAX(g1, b1)) * 256 + m0 / 2) / m0;
+			if (f <= 256 &&
+				ABS(r0 * f / 256 - r1) <= 4 && ABS(g0 * f / 256 - g1) <= 4 && ABS(b0 * f / 256 - b1) <= 4) {
+				mode[i] = kHDFade;
+				factor[i] = f;
+				continue;
+			}
+			// grayscale view: r = g = b = (scaled) max component. It never brightens the colour:
+			// a highlight of colour cycling that turns white (the park fountain) is not a gray view
+			if (r1 == g1 && g1 == b1 && r1 <= m0 + 4) {
+				mode[i] = kHDGray;
+				factor[i] = (r1 * 256 + m0 / 2) / m0;
+				continue;
+			}
+		} else if (r1 == 0 && g1 == 0 && b1 == 0) {
+			mode[i] = kHDSame;
+			continue;
+		}
+		// colour cycling (the park fountain: water highlights brightened in turn): shift the HD
+		// pixel by the difference instead of falling back to the blocky upscaled pixel
+		{
+			int dr = (r1 - r0) / 8, dg = (g1 - g0) / 8, db = (b1 - b0) / 8;
+			if (ABS(dr) <= 15 && ABS(dg) <= 15 && ABS(db) <= 15) {
+				mode[i] = kHDShift;
+				factor[i] = ((dr & 31) << 10) | ((dg & 31) << 5) | (db & 31);
+				continue;
+			}
+		}
+		mode[i] = kLowRes;
+	}
+	return step;
+}
+
+// ---------------------------------------------------------------------------
+// HD sprites
+// ---------------------------------------------------------------------------
+
+static uint32 frameKey(const byte *pixels, int w, int h) {
+	// zlib compatible CRC32 of: w (LE16), h (LE16), pixels
+	static uint32 table[256];
+	static bool init = false;
+	if (!init) {
+		for (uint32 i = 0; i < 256; i++) {
+			uint32 c = i;
+			for (int k = 0; k < 8; k++)
+				c = (c >> 1) ^ (0xedb88320 & (0 - (c & 1)));
+			table[i] = c;
+		}
+		init = true;
+	}
+	uint32 crc = 0xffffffff;
+	byte hdr[4] = { (byte)(w & 0xff), (byte)(w >> 8), (byte)(h & 0xff), (byte)(h >> 8) };
+	for (int i = 0; i < 4; i++)
+		crc = table[(crc ^ hdr[i]) & 0xff] ^ (crc >> 8);
+	int n = w * h;
+	for (int i = 0; i < n; i++)
+		crc = table[(crc ^ pixels[i]) & 0xff] ^ (crc >> 8);
+	return crc ^ 0xffffffff;
+}
+
+static Common::SeekableReadStream *openHDFile(const Common::String &name) {
+	Common::FSNode gameDir(ConfMan.getPath("path"));
+	Common::FSNode node = gameDir.getChild("hd");
+	Common::String rest = name;
+	while (true) {
+		int slash = rest.findFirstOf('/');
+		if (slash < 0)
+			break;
+		node = node.getChild(rest.substr(0, slash));
+		rest = rest.substr(slash + 1);
+	}
+	node = node.getChild(rest);
+	Common::SeekableReadStream *s = node.exists() ? node.createReadStream() : nullptr;
+	if (!s)
+		s = SearchMan.createReadStreamForMember(Common::Path("hd/" + name, '/'));
+	return s;
+}
+
+void HDRenderer::loadSpriteIndex() {
+	Common::SeekableReadStream *f = openHDFile("spr/index.dat");
+	if (!f)
+		return;
+	uint32 magic = f->readUint32BE();
+	if (magic != MKTAG('B', 'R', 'S', 'P')) {
+		warning("HD sprites: bad index");
+		delete f;
+		return;
+	}
+	// version 1: { key, palette, w, h }; version 2 adds the margins of the HD image { ml, mr }
+	uint16 version = f->readUint16LE();
+	uint16 scale = f->readUint16LE();
+	uint16 numPal = f->readUint16LE();
+	_sprPalettes.resize(numPal * 768);
+	if (numPal)
+		f->read(&_sprPalettes[0], numPal * 768);
+	uint32 n = f->readUint32LE();
+	for (uint32 i = 0; i < n && !f->eos(); i++) {
+		uint32 key = f->readUint32LE();
+		SpriteEntry e;
+		e.pal = f->readUint16LE();
+		e.w = f->readUint16LE();
+		e.h = f->readUint16LE();
+		e.ml = version >= 2 ? f->readUint16LE() : 0;
+		e.mr = version >= 2 ? f->readUint16LE() : 0;
+		e.flags = 0;
+		e.animFrames = e.animMs = 0;
+		if (e.pal < numPal && e.ml + e.w + e.mr < 1024)
+			_sprIndex[key] = e;
+	}
+	delete f;
+	// free shape (spr/forma_libera.txt, one key per line): a file of its own, so that older engines
+	// read the index as before
+	if ((f = openHDFile("spr/forma_libera.txt")) != nullptr) {
+		while (!f->eos() && !f->err()) {
+			Common::String line = f->readLine();
+			int hash = line.findFirstOf('#');
+			if (hash >= 0)
+				line = line.substr(0, hash);
+			line.trim();
+			if (line.empty())
+				continue;
+			uint32 key = (uint32)strtoul(line.c_str(), nullptr, 16);
+			if (_sprIndex.contains(key))
+				_sprIndex[key].flags |= 1;
+		}
+		delete f;
+	}
+	// timed HD frames (spr/animati.txt): "<key> <frames> <ms>" per line. Every original frame listed
+	// shows spr/<key>_<n>.png with n from the clock, so frames of the same animation share the time
+	// base (a breathing bubble over a body that stays the same). A file of its own: older engines
+	// ignore it and keep spr/<key>.png
+	if ((f = openHDFile("spr/animati.txt")) != nullptr) {
+		while (!f->eos() && !f->err()) {
+			Common::String line = f->readLine();
+			int hash = line.findFirstOf('#');
+			if (hash >= 0)
+				line = line.substr(0, hash);
+			line.trim();
+			if (line.empty())
+				continue;
+			Common::StringTokenizer tok(line, " \t");
+			uint32 key = (uint32)strtoul(tok.nextToken().c_str(), nullptr, 16);
+			int frames = atoi(tok.nextToken().c_str()), ms = atoi(tok.nextToken().c_str());
+			if (_sprIndex.contains(key) && frames > 1 && frames < 1000 && ms >= 20) {
+				_sprIndex[key].animFrames = frames;
+				_sprIndex[key].animMs = ms;
+			}
+		}
+		delete f;
+	}
+	_sprEnabled = !_sprIndex.empty() && scale >= _scale;
+	debug(1, "HD sprites: %d frames, %d palettes (%dx)", _sprIndex.size(), numPal, scale);
+}
+
+HDRenderer::HDSprite *HDRenderer::loadSprite(uint32 key, const SpriteEntry &e, const byte *pixels, byte transparentKey, int sub) {
+	// PNG with alpha, or JPEG (alpha rebuilt from the original frame)
+	Image::PNGDecoder png;
+	Image::JPEGDecoder jpeg;
+	jpeg.setOutputPixelFormat(Graphics::PixelFormat(4, 8, 8, 8, 8, 24, 16, 8, 0));
+	Image::ImageDecoder *dec = &png;
+	bool hasAlpha = true;
+	Common::SeekableReadStream *stream = openHDFile(sub >= 0 ? Common::String::format("spr/%08x_%d.png", key, sub)
+		: Common::String::format("spr/%08x.png", key));
+	if (!stream && sub >= 0)
+		return nullptr;	// a timed frame: PNG only (the caller falls back to the still image)
+	if (!stream) {
+		stream = openHDFile(Common::String::format("spr/%08x.jpg", key));
+		dec = &jpeg;
+		hasAlpha = false;
+	}
+	if (!stream)
+		return nullptr;
+	bool ok = dec->loadStream(*stream);
+	delete stream;
+	if (!ok)
+		return nullptr;
+	const Graphics::Surface *src = dec->getSurface();
+	// the HD image covers the original frame plus its margins (index version 2)
+	int fw = e.ml + e.w + e.mr;
+	if (src->w % fw || src->h % e.h || src->w / fw != src->h / e.h || src->w / fw < _scale) {
+		warning("HD sprite %08x: unexpected size %dx%d (original %dx%d, margins %d+%d)", key, src->w, src->h, e.w, e.h, e.ml, e.mr);
+		return nullptr;
+	}
+	const Graphics::PixelFormat argb(4, 8, 8, 8, 8, 16, 8, 0, 24);
+	Graphics::Surface *rgb = src->convertTo(argb, dec->getPalette().data(), dec->getPalette().size());
+	int k = src->w / fw;
+	int dw = fw * _scale, dh = e.h * _scale;
+	HDSprite *spr = new HDSprite;
+	spr->w = fw;
+	spr->h = e.h;
+	spr->ml = e.ml;
+	spr->mr = e.mr;
+	spr->pal = e.pal;
+	spr->lastUsed = _frameNo;
+	memset(spr->used, 0, sizeof(spr->used));
+	spr->px = new uint32[dw * dh];
+	if (k == _scale) {
+		for (int y = 0; y < dh; y++)
+			memcpy(spr->px + y * dw, rgb->getBasePtr(0, y), dw * 4);
+	} else {
+		// box filter k x -> _scale x, alpha weighted
+		for (int y = 0; y < dh; y++) {
+			int sy0 = y * k, sy1 = (y + 1) * k;
+			for (int x = 0; x < dw; x++) {
+				int sx0 = x * k, sx1 = (x + 1) * k;
+				uint32 aa = 0, ar = 0, ag = 0, ab = 0, aw = 0;
+				for (int yy = sy0 / _scale; yy * _scale < sy1; yy++) {
+					int wy = MIN(sy1, (yy + 1) * _scale) - MAX(sy0, yy * _scale);
+					const uint32 *sp = (const uint32 *)rgb->getBasePtr(0, yy);
+					for (int xx = sx0 / _scale; xx * _scale < sx1; xx++) {
+						int wx = MIN(sx1, (xx + 1) * _scale) - MAX(sx0, xx * _scale);
+						uint32 c = sp[xx], a = c >> 24, wgt = wx * wy;
+						aa += a * wgt;
+						ar += ((c >> 16) & 0xff) * a * wgt;
+						ag += ((c >> 8) & 0xff) * a * wgt;
+						ab += (c & 0xff) * a * wgt;
+						aw += wgt;
+					}
+				}
+				uint32 c = 0;
+				if (aa)
+					c = ((aa / aw) << 24) | ((ar / aa) << 16) | ((ag / aa) << 8) | (ab / aa);
+				spr->px[y * dw + x] = c;
+			}
+		}
+	}
+	rgb->free();
+	delete rgb;
+
+	if (!hasAlpha) {
+		// shape of the original opaque pixels, blurred a little (gaussian, sigma ~0.65 px) and
+		// sampled bilinearly; the 0.5 level of that field is a smooth curve through the pixel
+		// corners, so staircases become straight or round edges. A narrow smoothstep around it
+		// gives the anti-aliasing. Outside the frame the border is repeated, so that sprites cut
+		// into adjacent pieces (groups of people, big props) join without seams.
+		const int R = 2;
+		static const float K[2 * R + 1] = { 0.0228f, 0.2135f, 0.5274f, 0.2135f, 0.0228f };	// sigma 0.65
+		int bw = e.w + 2, bh = e.h + 2;	// one pixel of border on every side
+		Common::Array<float> tmp(bw * bh), blur(bw * bh);
+		for (int y = 0; y < bh; y++)
+			for (int x = 0; x < bw; x++) {
+				float acc = 0;
+				for (int k = -R; k <= R; k++) {
+					int sx = CLIP<int>(x - 1 + k, 0, e.w - 1), sy = CLIP<int>(y - 1, 0, e.h - 1);
+					acc += K[k + R] * (pixels[sy * e.w + sx] != transparentKey ? 1.0f : 0.0f);
+				}
+				tmp[y * bw + x] = acc;
+			}
+		for (int y = 0; y < bh; y++)
+			for (int x = 0; x < bw; x++) {
+				float acc = 0;
+				for (int k = -R; k <= R; k++)
+					acc += K[k + R] * tmp[CLIP<int>(y + k, 0, bh - 1) * bw + x];
+				blur[y * bw + x] = acc;
+			}
+		if (e.ml || e.mr)
+			warning("HD sprite %08x: margins need a PNG with alpha, ignored in the JPEG", key);
+		for (int y = 0; y < dh; y++) {
+			float fy = (y + 0.5f) / _scale - 0.5f + 1.0f;	// in the bordered field
+			int y0 = (int)floorf(fy);
+			float wy = fy - y0;
+			for (int x = 0; x < dw; x++) {
+				if (x < e.ml * _scale || x >= (e.ml + e.w) * _scale) {
+					spr->px[y * dw + x] &= 0xffffff;
+					continue;
+				}
+				float fx = (x - e.ml * _scale + 0.5f) / _scale - 0.5f + 1.0f;
+				int x0 = (int)floorf(fx);
+				float wx = fx - x0;
+#define BV(xx, yy) blur[CLIP<int>((yy), 0, bh - 1) * bw + CLIP<int>((xx), 0, bw - 1)]
+				float v = (BV(x0, y0) * (1 - wx) + BV(x0 + 1, y0) * wx) * (1 - wy) +
+						(BV(x0, y0 + 1) * (1 - wx) + BV(x0 + 1, y0 + 1) * wx) * wy;
+#undef BV
+				float t = CLIP((v - 0.36f) / 0.28f, 0.0f, 1.0f);
+				int a = (int)(t * t * (3 - 2 * t) * 255 + 0.5f);
+				uint32 &p = spr->px[y * dw + x];
+				p = (p & 0xffffff) | ((uint32)a << 24);
+			}
+		}
+	}
+
+	// margins: which game pixels of them have something to show (drawn there in the bands)
+	if (e.ml || e.mr) {
+		int mw = e.ml + e.mr;
+		spr->cover.resize(mw * e.h);
+		for (int y = 0; y < e.h; y++)
+			for (int c = 0; c < mw; c++) {
+				int gx = c < e.ml ? c : e.w + c;	// column in the widened image
+				uint32 a = 0;
+				for (int j = 0; j < _scale && !a; j++)
+					for (int i = 0; i < _scale && !a; i++)
+						a = spr->px[(y * _scale + j) * dw + gx * _scale + i] >> 24;
+				spr->cover[y * mw + c] = a ? 1 : 0;
+			}
+	}
+
+	// free shape: the HD image also draws where the original frame is transparent (inside it)
+	if ((e.flags & 1) && hasAlpha) {
+		spr->inner.resize(e.w * e.h);
+		int n = 0;
+		for (int y = 0; y < e.h; y++)
+			for (int x = 0; x < e.w; x++) {
+				uint32 a = 0;
+				if (pixels[y * e.w + x] == transparentKey)
+					for (int j = 0; j < _scale && a < 128; j++)
+						for (int i = 0; i < _scale && a < 128; i++)
+							a = MAX(a, spr->px[(y * _scale + j) * dw + (e.ml + x) * _scale + i] >> 24);
+				spr->inner[y * e.w + x] = a >= 128 ? 1 : 0;
+				n += a >= 128;
+			}
+		if (!n)
+			spr->inner.clear();
+	}
+
+	_sprCacheBytes += dw * dh * 4;
+	return spr;
+}
+
+uint32 HDRenderer::spriteKey(const byte *pixels, int w, int h) {
+	return frameKey(pixels, w, h);
+}
+
+bool HDRenderer::slotMargins(uint32 slot, int &ml, int &mr, const byte *&cover) const {
+	ml = mr = 0;
+	cover = nullptr;
+	if (!slot || slot >= _slots.size() || _slots[slot].spr->cover.empty())
+		return false;
+	const HDSprite *spr = _slots[slot].spr;
+	ml = spr->ml;
+	mr = spr->mr;
+	cover = &spr->cover[0];
+	return true;
+}
