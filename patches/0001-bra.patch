+// the 8-bit picture of the shape (fill, outline, transparent around) and the text, line by line inside the oval
+void BalloonManager_br::writeOval(Balloon *balloon, const Common::String &text, byte color) {
+	Graphics::Surface *surf = balloon->surface;
+	const HDBalloonShape &sh = balloon->shape;
+	hdTextForget(surf);
+	for (int y = 0; y < surf->h; y++) {
+		byte *p = (byte *)surf->getBasePtr(0, y);
+		for (int x = 0; x < surf->w; x++) {
+			float d = hdBalloonDistance(sh, x + 0.5f, y + 0.5f);
+			p[x] = d <= -sh.lineWidth ? sh.fill : d <= 0.3f ? sh.line : BALLOON_TRANSPARENT_COLOR_BR;
