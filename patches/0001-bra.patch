+		if (!ir) {
+			_cursorHD = false;
+			return false;
+		}
+		out.create(_mouseComboProps_BR._width * s, _mouseComboProps_BR._height * s, HDRenderer::cursorFormat());
+		out.fillRect(Common::Rect(out.w, out.h), 0);
+		out.copyRectToSurface(*arrow, 0, 0, Common::Rect(MIN<int>(arrow->w, out.w), MIN<int>(arrow->h, out.h)));
+		const int iw = ir->itemWidth(), ih = ir->itemHeight();
+		Common::Array<byte> icon(iw * ih);
+		const byte *px = ir->itemPixels(item);
+		for (int y = 0; y < ih; y++)
+			memcpy(&icon[y * iw], px + y * ir->itemPitch(), iw);
+		const uint32 *hdIcon = hd->spriteImage(&icon[0], iw, ih, 0);
+		byte *scaled = hdIcon ? nullptr : hd->scaleIndexed(&icon[0], iw, ih, iw);
+		what = hdIcon ? "hd+hd-icon" : "hd+scaled-icon";
+		// the icon over the arrow (alpha not premultiplied)
+		const int ox = _mouseComboProps_BR._xOffset * s, oy = _mouseComboProps_BR._yOffset * s;
+		for (int y = 0; y < ih * s && oy + y < out.h; y++) {
+			uint32 *dp = (uint32 *)out.getBasePtr(ox, oy + y);
+			for (int x = 0; x < iw * s && ox + x < out.w; x++) {
+				uint32 c = hdIcon ? hdIcon[y * iw * s + x] : (scaled[y * iw * s + x] ? hd->paletteARGB(scaled[y * iw * s + x]) : 0);
+				uint32 a = c >> 24, d = dp[x], da = d >> 24;
+				if (a == 255 || !da) {
+					if (a)
+						dp[x] = c;
+					continue;
+				}
+				if (!a)
+					continue;
+				uint32 oa = a * 255 + da * (255 - a);	// alpha x 255
+				uint32 res = (oa / 255) << 24;
+				for (int sh = 0; sh < 24; sh += 8) {
+					uint32 cs = (c >> sh) & 0xff, cd = (d >> sh) & 0xff;
+					res |= ((cs * a * 255 + cd * da * (255 - a)) / oa) << sh;
+				}
+				dp[x] = res;
+			}
+		}
+		delete[] scaled;
+	}
+	Graphics::PixelFormat fmt = HDRenderer::cursorFormat();
+	CursorMan.replaceCursor(out.getPixels(), out.w, out.h, 0, 0, 0, &fmt);
+	keepCursor(out, what);
+	out.free();
+	return true;
+}
