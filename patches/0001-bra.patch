+// where the piece is now, in ms from its start (one loop)
+uint32 DosSoundMan_br::musicPositionMs() {
+	if (_digitalActive && _mixer->isSoundHandleActive(_digitalHandle)) {
+		uint32 t = _mixer->getSoundElapsedTime(_digitalHandle) + _digitalStartOffset;
+		return _digitalLength ? t % _digitalLength : t;
