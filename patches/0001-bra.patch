+	const int rightX = MIN<int>(start.x + xStep, p.x), leftX = MAX<int>(start.x - xStep, p.x);
+	if (start.x < p.x && rightX < maxX && isPathClear(rightX, start.y)) {
+		if (rightX - start.x == xStep)
