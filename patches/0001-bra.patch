+
+static bool autotestErrorHandler(const char *msg) {
+	// don't drop into the debugger or show a message box: just die
+	debug("AUTOTEST FATAL: %s", msg);
+	return true;
+}
+
+AutoTest::AutoTest(Parallaction *vm) : _vm(vm), _wait(0), _active(false), _skipCount(0) {
+	const char *path = getenv("PARALLACTION_AUTOTEST");
+	if (!path)
+		return;
+	Common::setErrorHandler(autotestErrorHandler);
+	Common::FSNode node{Common::Path(path, '/')};
+	Common::SeekableReadStream *f = node.createReadStream();
+	if (!f) {
+		warning("AutoTest: cannot open %s", path);
+		return;
+	}
+	while (!f->eos() && !f->err()) {
+		Common::String s = f->readLine();
+		s.trim();
+		if (!s.empty() && s[0] != '#')
+			_lines.push_back(s);
+	}
+	delete f;
+	_active = true;
+	debug("AutoTest: %d commands loaded", _lines.size());
+}
+
+void AutoTest::pushMouse(Common::EventType type, int x, int y) {
+	Common::Event e;
+	e.type = type;
+	int s = _vm->_gfx ? _vm->_gfx->hdScale() : 1;
+	int m = (_vm->_gfx && _vm->_gfx->_hd) ? _vm->_gfx->_hd->wideMargin() : 0;
+	e.mouse = Common::Point((x + m) * s, y * s);
+	// warpMouse() purges the mouse events still queued: warp only for the first event of a command,
+	// otherwise the release pushed right after a press wiped the press out
+	if (type == Common::EVENT_MOUSEMOVE)
+		_vm->_system->warpMouse((x + m) * s, y * s);
+	_vm->_system->getEventManager()->pushEvent(e);
+}
+
+void AutoTest::betweenFrames() {
+	if (!_jitter)
+		return;
+	_jitterN = (_jitterN + 1) % 24;
+	pushMouse(Common::EVENT_MOUSEMOVE, _jitterX + _jitterN, _jitterY + _jitterN / 2);
+}
+
+void AutoTest::screenshot(const Common::String &file) {
+	Graphics::Surface *screen = _vm->_system->lockScreen();
+	if (!screen)
+		return;
+	byte pal[768];
+	if (screen->format.bytesPerPixel == 1)
+		_vm->_system->getPaletteManager()->grabPalette(pal, 0, 256);
+	Common::DumpFile out;
+	if (out.open(Common::Path(file, '/'), true)) {
+		if (screen->format.bytesPerPixel == 1)
+			Image::writePNG(out, *screen, pal);
+		else
+			Image::writePNG(out, *screen);
+	}
+	_vm->_system->unlockScreen();
+}
+
+void AutoTest::cursorShot(const Common::String &file, const Common::String &screenFile) {
+	const Graphics::Surface &cur = _vm->_input->cursorCopy();
+	debug("AutoTest: cursor %dx%d %s visible %d", cur.w, cur.h, _vm->_input->cursorWhat().c_str(), CursorMan.isVisible() ? 1 : 0);
+	if (!cur.getPixels())
+		return;
+	Common::DumpFile out;
+	if (out.open(Common::Path(file, '/'), true))
+		Image::writePNG(out, cur);
+	out.close();
+	if (screenFile.empty())
+		return;
+	Graphics::Surface *screen = _vm->_system->lockScreen();
+	if (!screen || screen->format.bytesPerPixel == 1) {
+		if (screen)
+			_vm->_system->unlockScreen();
+		return;
+	}
+	Graphics::Surface comp;
+	comp.copyFrom(*screen);
+	_vm->_system->unlockScreen();
+	// the pointer at the mouse position (hot spot 0,0), blended with its alpha
+	Common::Point m = _vm->_system->getEventManager()->getMousePos();
+	for (int y = 0; y < cur.h; y++) {
+		if (m.y + y < 0 || m.y + y >= comp.h)
+			continue;
+		for (int x = 0; x < cur.w; x++) {
+			if (m.x + x < 0 || m.x + x >= comp.w)
+				continue;
+			uint32 c = *(const uint32 *)cur.getBasePtr(x, y), a = c >> 24;
+			if (!a)
+				continue;
+			byte r, g, b;
+			comp.format.colorToRGB(comp.getPixel(m.x + x, m.y + y), r, g, b);
+			r = (((c >> 16) & 0xff) * a + r * (255 - a)) / 255;
+			g = (((c >> 8) & 0xff) * a + g * (255 - a)) / 255;
+			b = ((c & 0xff) * a + b * (255 - a)) / 255;
+			comp.setPixel(m.x + x, m.y + y, comp.format.RGBToColor(r, g, b));
+		}
+	}
+	if (out.open(Common::Path(screenFile, '/'), true))
+		Image::writePNG(out, comp);
+	comp.free();
+}
+
+/*
+ * Drives the ScummVM menu (a modal GUI loop the script cannot reach) from the
+ * event polls: waits, key presses and screenshots of the GUI overlay.
+ */
+class GuiScript : public Common::EventObserver {
+	// a point given in percent of the overlay
+	static Common::Point at(const char *s, int i) {
+		int v[4] = { 50, 50, 50, 50 };
+		for (int k = 0; k < 4 && *s; k++) {
+			v[k] = atoi(s);
+			while (*s && *s != ',')
+				s++;
+			if (*s)
+				s++;
+		}
+		return Common::Point(g_system->getOverlayWidth() * v[i * 2] / 100, g_system->getOverlayHeight() * v[i * 2 + 1] / 100);
+	}
+	static void push(Common::EventType type, const Common::Point &p) {
+		Common::Event e;
+		e.type = type;
+		e.mouse = p;
+		g_system->getEventManager()->pushEvent(e);
+	}
+
+public:
+	GuiScript(const Common::Array<Common::String> &steps, bool menuWatch = false) : _steps(steps), _next(0), _due(0),
+		_menuWatch(menuWatch), _wasPaused(false), _opened(0) {
+		_due = g_system->getMillis() + 500;
+	}
+
+	bool notifyEvent(const Common::Event &event) override { return false; }
+
+	void notifyPoll() override {
+		if (_menuWatch) {
+			// menu opened by an EVENT_MAINMENU (as the keymap makes it from Esc, F5 or Ctrl+F5):
+			// the steps run only inside the menu (the engine is paused there); every opening is
+			// counted, and a menu that opens again after the steps is closed and reported
+			bool paused = g_engine && g_engine->isPaused();
+			if (paused && !_wasPaused) {
+				_opened++;
+				_due = g_system->getMillis() + 500;
+				if (_opened > 1)
+					debug("AutoTest: menu opened again (%d)", _opened);
+			}
+			_wasPaused = paused;
+			if (!paused)
+				return;
+			if (done() && _opened > 1 && g_system->getMillis() >= _due) {
+				Common::Event e;
+				e.type = Common::EVENT_KEYDOWN;
+				e.kbd = Common::KeyState(Common::KEYCODE_ESCAPE, Common::ASCII_ESCAPE);
+				g_system->getEventManager()->pushEvent(e);
+				e.type = Common::EVENT_KEYUP;
+				g_system->getEventManager()->pushEvent(e);
+				_due = g_system->getMillis() + 300;
+				return;
+			}
+		}
+		while (_next < _steps.size() && g_system->getMillis() >= _due) {
+			const Common::String &s = _steps[_next++];
+			if (s.hasPrefix("w:")) {
+				_due = g_system->getMillis() + atoi(s.c_str() + 2);
+			} else if (s.hasPrefix("k:")) {
+				Common::String k(s.c_str() + 2);
+				Common::KeyState ks;
+				if (k == "down")
+					ks = Common::KeyState(Common::KEYCODE_DOWN);
+				else if (k == "up")
+					ks = Common::KeyState(Common::KEYCODE_UP);
+				else if (k == "enter")
+					ks = Common::KeyState(Common::KEYCODE_RETURN, Common::ASCII_RETURN);
+				else if (k == "esc")
+					ks = Common::KeyState(Common::KEYCODE_ESCAPE, Common::ASCII_ESCAPE);
+				else if (k == "left")
+					ks = Common::KeyState(Common::KEYCODE_LEFT);
+				else if (k == "right")
+					ks = Common::KeyState(Common::KEYCODE_RIGHT);
+				else if (k == "pageup")
+					ks = Common::KeyState(Common::KEYCODE_PAGEUP);
+				else if (k == "pagedown")
+					ks = Common::KeyState(Common::KEYCODE_PAGEDOWN);
+				else if (k == "home")
+					ks = Common::KeyState(Common::KEYCODE_HOME);
+				else if (k == "end")
+					ks = Common::KeyState(Common::KEYCODE_END);
+				else if (k == "space")
+					ks = Common::KeyState(Common::KEYCODE_SPACE, ' ');
+				else
+					ks = Common::KeyState((Common::KeyCode)k[0], k[0]);
+				Common::Event e;
+				e.type = Common::EVENT_KEYDOWN;
+				e.kbd = ks;
+				g_system->getEventManager()->pushEvent(e);
+				e.type = Common::EVENT_KEYUP;
+				g_system->getEventManager()->pushEvent(e);
+				_due = g_system->getMillis() + 300;
+			} else if (s.hasPrefix("c:") || s.hasPrefix("rc:")) {
+				bool right = s.hasPrefix("rc:");
+				Common::Point p = at(s.c_str() + (right ? 3 : 2), 0);
+				push(Common::EVENT_MOUSEMOVE, p);
+				push(right ? Common::EVENT_RBUTTONDOWN : Common::EVENT_LBUTTONDOWN, p);
+				push(right ? Common::EVENT_RBUTTONUP : Common::EVENT_LBUTTONUP, p);
+				_due = g_system->getMillis() + 300;
+			} else if (s.hasPrefix("d:")) {
+				Common::Point a = at(s.c_str() + 2, 0), b = at(s.c_str() + 2, 1);
+				push(Common::EVENT_MOUSEMOVE, a);
+				push(Common::EVENT_LBUTTONDOWN, a);
+				for (int i = 1; i <= 8; i++)
+					push(Common::EVENT_MOUSEMOVE, Common::Point(a.x + (b.x - a.x) * i / 8, a.y + (b.y - a.y) * i / 8));
+				push(Common::EVENT_LBUTTONUP, b);
+				_due = g_system->getMillis() + 300;
+			} else if (s.hasPrefix("wh:")) {
+				int n = atoi(s.c_str() + 3);
+				Common::Point p(g_system->getOverlayWidth() / 2, g_system->getOverlayHeight() / 2);
+				for (int i = 0; i < ABS(n); i++)
+					push(n > 0 ? Common::EVENT_WHEELDOWN : Common::EVENT_WHEELUP, p);
+				_due = g_system->getMillis() + 300;
+			} else if (s.hasPrefix("shot:")) {
+				Graphics::Surface surf;
+				surf.create(g_system->getOverlayWidth(), g_system->getOverlayHeight(), g_system->getOverlayFormat());
+				g_system->grabOverlay(surf);
+				Common::DumpFile out;
+				if (out.open(Common::Path(s.c_str() + 5, '/')))
+					Image::writePNG(out, surf);
+				surf.free();
+				debug("AutoTest: gui shot %s (%dx%d)", s.c_str() + 5, surf.w, surf.h);
+			}
+		}
+	}
+
+	bool done() const { return _next >= _steps.size(); }
+	int opened() const { return _opened; }
+
+private:
+	Common::Array<Common::String> _steps;
+	uint _next;
+	uint32 _due;
+	bool _menuWatch;
+	bool _wasPaused;
+	int _opened;
+};
+
+void AutoTest::step() {
+	if (!_active)
+		return;
+	if (_manualScript && _manualScript->done()) {
+		_vm->_system->getEventManager()->getEventDispatcher()->unregisterObserver(_manualScript);
+		delete _manualScript;
+		_manualScript = nullptr;
+	}
+	if (_wait > 0) {
+		_wait--;
+		return;
+	}
+	while (!_lines.empty()) {
+		Common::String line = _lines.front();
+		_lines.pop_front();
+		if (!line.hasPrefix("lup") && !line.hasPrefix("wait"))
+			debug("AutoTest: %s", line.c_str());
+		if (line.hasPrefix("#"))
+			continue;
+
+		Common::Array<Common::String> tok;
+		{
+			Common::String cur;
+			for (uint i = 0; i <= line.size(); i++) {
+				if (i == line.size() || line[i] == ' ' || line[i] == '\t') {
+					if (!cur.empty())
+						tok.push_back(cur);
+					cur.clear();
+				} else {
+					cur += line[i];
+				}
+			}
+		}
+		while (tok.size() < 3)
+			tok.push_back("");
+		const Common::String &c = tok[0];
+		const char *a1 = tok[1].c_str();
+		const char *a2 = tok[2].c_str();
+
+		if (c == "wait") {
+			_wait = atoi(a1);
+			return;
+		} else if (c == "move") {
+			pushMouse(Common::EVENT_MOUSEMOVE, atoi(a1), atoi(a2));
+			return;
+		} else if (c == "click") {
+			int x = atoi(a1), y = atoi(a2);
+			pushMouse(Common::EVENT_MOUSEMOVE, x, y);
+			_lines.push_front(Common::String::format("lup %d %d", x, y));
+			_wait = 3;
+			return;
+		} else if (c == "lup") {
+			pushMouse(Common::EVENT_MOUSEMOVE, atoi(a1), atoi(a2));
+			pushMouse(Common::EVENT_LBUTTONDOWN, atoi(a1), atoi(a2));
+			pushMouse(Common::EVENT_LBUTTONUP, atoi(a1), atoi(a2));
+			_wait = 3;
+			return;
+		} else if (c == "rclick" || c == "rhold") {
+			// rclick: a normal click (~130 ms); rhold: the button kept down (~500 ms), DOS gesture
+			int x = atoi(a1), y = atoi(a2);
+			pushMouse(Common::EVENT_MOUSEMOVE, x, y);
+			pushMouse(Common::EVENT_RBUTTONDOWN, x, y);
+			_lines.push_front(Common::String::format("rup %d %d", x, y));
+			_wait = c == "rclick" ? 4 : 15;
+			return;
+		} else if (c == "state") {
+			// input mode (0 game, 3 inventory), object in hand and inventory size, for the test logs
+			Common::Point foot, scroll;
+			if (_vm->_char._ani && _vm->_char._ani->gfxobj)
+				_vm->_char._ani->getFoot(foot);
+			_vm->_gfx->getScrollPos(scroll);
+			debug("AutoTest: state mode %d held %u items %d char %s flags %x location %s foot %d,%d scroll %d hover %s mouse %d cursor %d", _vm->_input->_inputMode,
+				(_vm->_input->_activeItem._id >> 16) & 0xFFFF,
+				_vm->_inventory ? _vm->_inventory->getNumItems() : -1, _vm->_char.getName(), g_engineFlags,
+				_vm->_location._name, foot.x, foot.y, scroll.x, _vm->_input->hoverZoneName(),
+				(int)_vm->_input->getMouseState(), CursorMan.isVisible() ? 1 : 0);
+		} else if (c == "mouseon") {
+			// a jump out of a cutscene (loc) can leave the mouse disabled by its OFFMOUSE
+			_vm->_input->setMouseState(MOUSE_ENABLED_SHOW);
+		} else if (c == "rtap") {
+			// press and release in the same frame (trackpad tap, touch screen)
+			int x = atoi(a1), y = atoi(a2);
+			pushMouse(Common::EVENT_MOUSEMOVE, x, y);
+			pushMouse(Common::EVENT_RBUTTONDOWN, x, y);
+			pushMouse(Common::EVENT_RBUTTONUP, x, y);
+			_wait = 3;
+			return;
+		} else if (c == "rup") {
+			pushMouse(Common::EVENT_MOUSEMOVE, atoi(a1), atoi(a2));
+			pushMouse(Common::EVENT_RBUTTONUP, atoi(a1), atoi(a2));
+			_wait = 2;
+			return;
+		} else if (c == "key") {
+			Common::Event e;
+			e.type = Common::EVENT_KEYDOWN;
+			Common::String k(a1);
+			if (k.size() >= 2 && (k[0] == 'F' || k[0] == 'f') && Common::isDigit(k[1])) {
+				e.kbd = Common::KeyState((Common::KeyCode)(Common::KEYCODE_F1 + atoi(k.c_str() + 1) - 1));
+			} else {
+				e.kbd = Common::KeyState((Common::KeyCode)k[0], k[0]);
+			}
+			_vm->_system->getEventManager()->pushEvent(e);
+			_wait = 2;
+			return;
+		} else if (c == "shot") {
+			screenshot(a1);
+		} else if (c == "cursorshot") {
+			cursorShot(a1, a2);
+		} else if ((c == "loc" || c == "ingame") &&
+				((_vm->_input->_inputMode != Input::kInputModeGame && _vm->_input->_inputMode != Input::kInputModeMenu) ||
+				 (g_engineFlags & kEngineChangeLocation))) {
+			// advance dialogues / comments until the game is interactive again
+			// cycle the click position so that dialogue answers get picked too
+			static const int ys[] = { 380, 20, 60, 100, 300 };
+			int y = ys[_skipCount++ % 5];
+			if (_skipCount % 20 == 0)
+				debug("AutoTest: still waiting for game mode (mode %d)", _vm->_input->_inputMode);
+			_lines.push_front(line);
+			pushMouse(Common::EVENT_MOUSEMOVE, 320, y);
+			_lines.push_front(Common::String::format("lup 320 %d", y));
+			_wait = 8;
+			return;
+		} else if (c == "ingame") {
+			// nothing: we are in game mode
+		} else if (c == "loc") {
+			_vm->autotestJump(a1, a2[0] ? atoi(a2) : -1);
+			_wait = 5;
+			return;
+		} else if (c == "save") {
+			// save n [description...]: the rest of the line names the saved game (default "autotest")
+			Common::String desc;
+			for (uint i = 2; i < tok.size(); i++) {
+				if (!tok[i].empty())
+					desc += (desc.empty() ? "" : " ") + tok[i];
+			}
+			_vm->_saveLoad->saveSlot(atoi(a1), desc.empty() ? "autotest" : desc.c_str());
+		} else if (c == "load") {
+			_vm->autotestLoad(atoi(a1));
+			_wait = 5;
+			return;
+		} else if (c == "poke") {
+			// click every visible zone of the current location (skipping doors
+			// unless "doors" is given), waiting for the game to be idle in between
+			bool doors = !strcmp(a1, "doors");
+			Common::Array<Common::String> cmds;
+			Common::Point scroll;
+			_vm->_gfx->getScrollPos(scroll);
+			for (ZoneList::iterator it = _vm->_location._zones.begin(); it != _vm->_location._zones.end(); ++it) {
+				ZonePtr z = *it;
+				if (z->_flags & (kFlagsRemove | kFlagsNoName))
+					continue;
+				if (!(z->_flags & kFlagsActive))
+					continue;
+				if (!doors && ACTIONTYPE(z) == kZoneDoor)
+					continue;
+				Common::Rect r;
+				z->getRect(r);
+				if (r.width() <= 0 || r.height() <= 0)
+					continue;
+				int x = (r.left + r.right) / 2 - scroll.x, y = (r.top + r.bottom) / 2 - scroll.y;
+				if (x < 0 || y < 0 || x >= 640 || y >= 400)
+					continue;
+				cmds.push_back(Common::String::format("# poke %s", z->_name));
+				cmds.push_back("ingame");
+				cmds.push_back(Common::String::format("click %d %d", x, y));
+				cmds.push_back("wait 80");
+				cmds.push_back("ingame");
+			}
+			for (int i = cmds.size() - 1; i >= 0; i--)
+				_lines.push_front(cmds[i]);
+			debug("AutoTest: poking %d zones", cmds.size() / 5);
+		} else if (c == "jitter") {
+			// "jitter x y": the mouse moves around x,y also between two frames, as a real one does
+			_jitter = strcmp(a1, "off") != 0;
+			_jitterX = atoi(a1);
+			_jitterY = atoi(a2);
+		} else if (c == "framelog") {
+			// one FRAME line per displayed frame in the log (time, scroll, render cost)
+			_vm->_gfx->_frameLog = !strcmp(a1, "on");
+		} else if (c == "verifyscroll") {
+			// every scrolled (moved) frame is composed again from scratch and compared (SHIFTCHECK)
+			if (_vm->_gfx->_hd)
+			{
+				_vm->_gfx->_hd->_verifyShift = !strcmp(a1, "on") || !strcmp(a1, "all");
+				_vm->_gfx->_hd->_verifyAll = !strcmp(a1, "all");
+			}
+		} else if (c == "fullredraw") {
+			// next frame composed from scratch (to compare with the incremental one)
+			if (_vm->_gfx->_hd)
+				_vm->_gfx->_hd->forceFullRedraw();
+		} else if (c == "time") {
+			debug("AutoTest: time %u ms", _vm->_system->getMillis());
+		} else if (c == "zones") {
+			_vm->autotestLogZones();
+		} else if (c == "zoneon" || c == "zoneoff") {
+			// turn a zone on/off as the ON/OFF commands of the scripts do
+			ZonePtr z = _vm->_location.findZone(a1);
+			if (z)
+				_vm->showZone(z, c == "zoneon");
+			else
+				debug("AutoTest: no zone %s", a1);
+		} else if (c == "scene") {
+			// drawing order of the last frame (bottom first)
+			for (uint i = 0; i < _vm->_gfx->_sceneObjects.size(); i++) {
+				GfxObj *o = _vm->_gfx->_sceneObjects[i];
+				Common::Rect r;
+				o->getRect(o->frame, r);
+				debug("SCENE %2u %-16s z=%d prog=%u pos=(%d,%d) frame=%d rect=(%d,%d,%d,%d) scale=%d layer=%d", i, o->getName(), o->z, o->_prog, o->x, o->y, o->frame,
+					r.left, r.top, r.right, r.bottom, o->scale, o->layer);
+			}
+		} else if (c == "flag" && _vm->_globalFlagsNames) {
+			uint16 i = _vm->_globalFlagsNames->lookup(a1);
+			if (i != Table::notFound)
+				g_globalFlags |= 1u << (i - 1);
+		} else if (c == "lflag" && _vm->_localFlagNames) {
+			// a local flag of the current location (LOCALFLAGS of its script), as SET NAME there
+			uint16 i = _vm->_localFlagNames->lookup(a1);
+			if (i != Table::notFound)
+				_vm->setLocationFlags(1u << (i - 1));
+			else
+				warning("AutoTest: no local flag %s in %s", a1, _vm->_location._name);
+		} else if (c == "flags" && _vm->_globalFlagsNames) {
+			// global flags set (names from GLOBAL.TAB) and local flags of the current location
+			Common::String names;
+			for (uint i = 0; i < _vm->_globalFlagsNames->count() && i < 32; i++)
+				if (g_globalFlags & (1u << i))
+					names += Common::String(" ") + _vm->_globalFlagsNames->item(i);
+			Common::String local;
+			for (uint i = 0; _vm->_localFlagNames && i < _vm->_localFlagNames->count() && i < 32; i++)
+				if (_vm->getLocationFlags() & (1u << i))
+					local += Common::String(" ") + _vm->_localFlagNames->item(i);
+			debug("AutoTest: flags global%s | local %s:%s", names.c_str(), _vm->_location._name, local.c_str());
+		} else if (c == "item" && _vm->_objectsNames) {
+			// "item name": the current character; "item name dino|donna|doug": that character's inventory
+			uint16 i = _vm->_objectsNames->lookup(a1);
+			if (i != Table::notFound) {
+				Inventory *inv = (a2[0] && _vm->getGameType() == GType_BRA) ? ((Parallaction_br *)_vm)->findInventory(a2) : nullptr;
+				if (inv) {
+					inv->addItem(4 + i);
+					((Parallaction_br *)_vm)->markTaken(4 + i);
+				} else {
+					_vm->addInventoryItem(4 + i);
+				}
+			}
+		} else if (c == "dumpall") {
+			// every sprite the location declares, shown or not yet (with hd_dump_sprites): animations, objects of
+			// the zones, portraits of the characters to talk with, the current character; with this location's palette
+			int n = 0;
+			for (AnimationList::iterator it = _vm->_location._animations.begin(); it != _vm->_location._animations.end(); ++it)
+				if ((*it)->gfxobj) { _vm->_gfx->hdDumpObject((*it)->gfxobj); n++; }
+			for (ZoneList::iterator it = _vm->_location._zones.begin(); it != _vm->_location._zones.end(); ++it) {
+				ZonePtr z = *it;
+				if (z->u._gfxobj) { _vm->_gfx->hdDumpObject(z->u._gfxobj); n++; }
+				if (ACTIONTYPE(z) == kZoneSpeak && !z->u._filename.empty() && z->u._filename.compareToIgnoreCase("yourself")) {
+					GfxObj *t = _vm->_disk->loadTalk(z->u._filename.c_str());
+					if (t) { _vm->_gfx->hdDumpObject(t); delete t; n++; }
+				}
+			}
+			if (_vm->_char._ani && _vm->_char._ani->gfxobj) { _vm->_gfx->hdDumpObject(_vm->_char._ani->gfxobj); n++; }
+			if (_vm->_char._talk) { _vm->_gfx->hdDumpObject(_vm->_char._talk); n++; }
+			debug("AutoTest: dumpall %s: %d objects", _vm->_location._name, n);
+		} else if (c == "conf") {
+			ConfMan.set(a1, a2, Common::ConfigManager::kApplicationDomain);
+		} else if (c == "gui") {
+			// the steps run inside the menu's own loop; the last one should close it (k:esc)
+			Common::Array<Common::String> steps;
+			for (uint i = 1; i < tok.size(); i++)
+				if (!tok[i].empty())
+					steps.push_back(tok[i]);
+			GuiScript gs(steps);
+			Common::EventDispatcher *d = _vm->_system->getEventManager()->getEventDispatcher();
+			d->registerObserver(&gs, Common::EventManager::kEventManPriority, false, true);
+			_vm->openMainMenuDialog();
+			// finish what is left (keys for dialogs that closed early are dropped)
+			d->unregisterObserver(&gs);
+			_wait = 5;
+			return;
+		} else if (c == "mainmenu" && !_menuScript) {
+			// like Esc, F5 or Ctrl+F5 (mapped by the keymapper to EVENT_MAINMENU): the steps run
+			// inside the menu ("menucount" logs how many times it opened)
+			Common::Array<Common::String> steps;
+			for (uint i = 1; i < tok.size(); i++)
+				if (!tok[i].empty())
+					steps.push_back(tok[i]);
+			_menuScript = new GuiScript(steps, true);
+			_vm->_system->getEventManager()->getEventDispatcher()->registerObserver(_menuScript, Common::EventManager::kEventManPriority, false, true);
+			Common::Event e;
+			e.type = Common::EVENT_MAINMENU;
+			_vm->_system->getEventManager()->pushEvent(e);
+			// BRA: the key is read where it most often is, while the engine waits for the next frame
+			// and updates the pointer (Parallaction::updateView)
+			if (_vm->getGameType() == GType_BRA)
+				_vm->updatePointerOnly();
+			_wait = 5;
+			return;
+		} else if (c == "menucount" && _menuScript) {
+			debug("AutoTest: menu opened %d times", _menuScript->opened());
+			_vm->_system->getEventManager()->getEventDispatcher()->unregisterObserver(_menuScript);
+			delete _menuScript;
+			_menuScript = nullptr;
+		} else if ((c == "manual" || c == "hint") && _vm->getGameType() == GType_BRA && !_manualScript) {
+			// the steps run inside the manual (or the hint window, "hint"), opened by a real M (H) key press
+			// (the dialog is modal)
+			Common::Array<Common::String> steps;
+			for (uint i = 1; i < tok.size(); i++)
+				if (!tok[i].empty())
+					steps.push_back(tok[i]);
+			_manualScript = new GuiScript(steps);
+			_vm->_system->getEventManager()->getEventDispatcher()->registerObserver(_manualScript, Common::EventManager::kEventManPriority, false, true);
+			Common::Event e;
+			e.type = Common::EVENT_KEYDOWN;
+			e.kbd = c == "hint" ? Common::KeyState(Common::KEYCODE_h, 'h') : Common::KeyState(Common::KEYCODE_m, 'm');
+			_vm->_system->getEventManager()->pushEvent(e);
+			e.type = Common::EVENT_KEYUP;
+			_vm->_system->getEventManager()->pushEvent(e);
+			_wait = 5;
+			return;
+		} else if (c == "modal" && !_manualScript) {
+			// steps for a window the game opens by itself (end titles): they run in whatever loop
+			// reads the events next, timed from now; the game goes on meanwhile
+			Common::Array<Common::String> steps;
+			for (uint i = 1; i < tok.size(); i++)
+				if (!tok[i].empty())
+					steps.push_back(tok[i]);
+			_manualScript = new GuiScript(steps);
+			_vm->_system->getEventManager()->getEventDispatcher()->registerObserver(_manualScript, Common::EventManager::kEventManPriority, false, true);
+		} else if (c == "hintlog" && _vm->getGameType() == GType_BRA) {
+			((Parallaction_br *)_vm)->logHint();
+		} else if (c == "flagparti" && _vm->getGameType() == GType_BRA) {
+			// flags remembered for later parts (loc/flag-parti.txt); "flagparti add 4:FLAG" adds one
+			Parallaction_br *br = (Parallaction_br *)_vm;
+			if (tok[1] == "add" && !tok[2].empty())
+				br->addPartFlag(tok[2]);
