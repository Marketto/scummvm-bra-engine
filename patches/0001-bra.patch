+void DosSoundMan_br::musicStyleChanged() {
+	// Remastered: remastered piece > CD track > digital replacement > MIDI; Original: CD track >
+	// MIDI. The piece goes on from the same place in the other source.
+	// (a piece started by a HEAR zone has no MUSIC PLAY behind it: it switches too)
+	if (_musicFile.empty())
+		return;
+	bool digital = _digitalActive && _mixer->isSoundHandleActive(_digitalHandle);
+	if (_cdTrack) {
+		// a CD piece changes only if it has a remastered version (in both directions); a track
+		// that has ended stays silent
+		bool playing = digital || (_cdPlayingTrack && g_system->getAudioCDManager()->isPlaying());
+		if (!playing || (!digital && !hasRemaster()))
+			return;
+	} else if (!_musicWanted && !digital && !_midiPlayer->isPlaying()) {
+		return;
+	}
+	_resumeMs = musicPositionMs();
+	stopDigital();
+	stopCDTrack();
+	_midiPlayer->stop();
+	playMusic();
+	debugC(1, kDebugAudio, "DosSoundMan_br: music style changed at %u ms, now at %u ms (%s)", _resumeMs, musicPositionMs(),
+		_digitalActive ? _digitalSource : (_cdPlayingTrack ? "CD" : "MIDI"));
+	_resumeMs = 0;
 }
 
 void DosSoundMan_br::stopMusic() {
+	// called when a location declares a different piece: it starts again at full volume
+	_musicVolume = 255;
+	// and the CD track of the previous piece is no longer the current one: the MUSIC PLAY of the
+	// new room (run before locationMusic) restarted it, so a MIDI room went on with the CD music of
+	// the room before and the F8 switch only added the MIDI piece (or its digital version) over it
+	_cdTrack = 0;
 	_midiPlayer->stop();
+	stopCDTrack();
+	stopDigital();
 }
 
