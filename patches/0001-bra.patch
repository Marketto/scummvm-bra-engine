+
+// start the piece at a time (the switch between the digital and the MIDI version keeps the place):
+// the tick with that time is found by halving (jumps are computed from the start, so the time of
+// a tick follows the tempo changes), then the parser jumps there sending the controllers
+void MidiPlayer_MSC::seekMs(uint32 ms) {
+	Common::StackLock lock(_mutex);
+	if (!_parser || !ms)
+		return;
+	MidiParser_MSC *p = (MidiParser_MSC *)_parser;
+	uint32 lo = 0, hi = 64;
+	for (;;) {
+		if (!p->jumpToTick(hi, false, true, true)) {
+			break;				// beyond the end
+		}
+		if (p->playTimeMs() >= ms)
+			break;
+		lo = hi;
+		hi *= 2;
+		if (hi > (1u << 24))
+			break;
+	}
+	while (hi - lo > 1) {
+		uint32 mid = (lo + hi) / 2;
+		if (p->jumpToTick(mid, false, true, true) && p->playTimeMs() <= ms)
+			lo = mid;
+		else
+			hi = mid;
+	}
+	p->jumpToTick(lo, true, true, true);
+}
