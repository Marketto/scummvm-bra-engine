+// BRA smooth motion. The game moves the figures once per step (90-160 ms, as on DOS) while the
+// screen runs at 30 fps: a walking figure jumped a few pixels every 3-5 frames. Between two steps the
+// figure is drawn on the way from its previous position to the new one (one step behind, the
+// sprite frame changes as before). Big jumps (a figure placed elsewhere by a script, a new room) are
+// not smoothed, unless the same big move repeats step after step: steady motion, like the waitress on
+// skates at McRomanov (PART1 VAIDES.SCR, 60 px a step), which went by in jerks while her way back (30 px)
+// glided. A one-off move (LEGGILIB.SCR: 85 px to line up with the character) stays a jump.
+// "bra_smooth_motion=false" in the settings turns it off.
+// A figure moved by the walker (the character, the follower) is drawn ahead instead: from where this
+// step put it towards where the next step will take it (PathWalker_BR::nextFoot). One step behind,
+// the new walking frame appeared where the previous one stood and only then slid forward: steps on
+// the spot, then a glide without steps, very visible when the screen runs slower than 30 fps (web).
+// Now the frame and the position change together, as on DOS, and the glide goes on in between.
+void Parallaction::smoothPosition(AnimationPtr anim, GfxObj *obj) {
+	if (_ipMode == 0 || !_ipEnabled) {
+		anim->_ipValid = false;
+		anim->_ipAhead = false;
+		return;
+	}
+	int16 x = anim->getX(), y = anim->getY();
+	if (_ipMode == 1) {
+		// drawn ahead during the last step: it is already where this step put it
+		int16 dx = x - anim->_ipCurX, dy = y - anim->_ipCurY;
+		bool steady = (dx || dy) && dx == anim->_ipLastDX && dy == anim->_ipLastDY && ABS(dx) <= 128 && ABS(dy) <= 64;
+		bool near = anim->_ipValid && !anim->_ipAhead && ((ABS(dx) <= 48 && ABS(dy) <= 32) || steady);
+		anim->_ipLastDX = anim->_ipValid ? dx : 0;
+		anim->_ipLastDY = anim->_ipValid ? dy : 0;
+		anim->_ipPrevX = near ? anim->_ipCurX : x;
+		anim->_ipPrevY = near ? anim->_ipCurY : y;
+		anim->_ipCurX = x;
+		anim->_ipCurY = y;
+		anim->_ipValid = true;
+		anim->_ipAhead = false;
+		Common::Point foot, next;
+		if (anim->gfxobj && nextWalkFoot(anim, next)) {
+			anim->getFoot(foot);
+			if (ABS(next.x - foot.x) <= 48 && ABS(next.y - foot.y) <= 32) {
+				anim->_ipAhead = true;
+				anim->_ipDX = next.x - foot.x;
+				anim->_ipDY = next.y - foot.y;
+			}
+		}
+	} else if (!anim->_ipValid || x != anim->_ipCurX || y != anim->_ipCurY) {
+		// moved by something else than a game step: show it where it is
+		anim->_ipValid = false;
+		anim->_ipAhead = false;
+		return;
+	}
+	uint32 t = MIN<uint32>(_system->getMillis() - _ipStepStart, _ipStepLen);
+	if (anim->_ipAhead) {
+		obj->x = anim->_ipCurX + (int32)anim->_ipDX * (int32)t / (int32)_ipStepLen;
+		obj->y = anim->_ipCurY + (int32)anim->_ipDY * (int32)t / (int32)_ipStepLen;
+		return;
+	}
+	obj->x = anim->_ipPrevX + (int32)(anim->_ipCurX - anim->_ipPrevX) * (int32)t / (int32)_ipStepLen;
+	obj->y = anim->_ipPrevY + (int32)(anim->_ipCurY - anim->_ipPrevY) * (int32)t / (int32)_ipStepLen;
