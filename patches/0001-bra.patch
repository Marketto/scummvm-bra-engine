+// R, G, B, A from the top byte down (as the manual)
+static const Graphics::PixelFormat kCreditsFormat(4, 8, 8, 8, 8, 24, 16, 8, 0);
+
+/* ---------------- files ---------------- */
+
+// a file of the game folder by a relative path, any case (the original folders are in capitals)
+static Common::SeekableReadStream *openGamePath(const Common::String &path) {
+	Common::FSNode node(ConfMan.getPath("path"));
+	Common::StringTokenizer tok(path, "/");
+	while (!tok.empty()) {
+		Common::String part = tok.nextToken();
+		Common::FSNode child = node.getChild(part);
+		if (!child.exists()) {
+			Common::FSList list;
+			if (node.getChildren(list, Common::FSNode::kListAll)) {
+				for (uint i = 0; i < list.size(); i++)
+					if (list[i].getName().equalsIgnoreCase(part)) {
+						child = list[i];
+						break;
+					}
+			}
+		}
+		if (!child.exists())
+			return SearchMan.createReadStreamForMember(Common::Path(path, '/'));
+		node = child;
+	}
+	return node.isDirectory() ? nullptr : node.createReadStream();
+}
+
+static const char *const kCreditsLangs[] = { "it", "fr", "en", "de" };
+
+// <name>/<language>.txt, German also as "ge" (the code of text/ and hint/); else English, else Italian. lang is
+// BRA's _langIndex (0 it, 1 fr, 2 en, 3 de), the same as getInternLanguage()
+static Common::SeekableReadStream *openCreditsText(const Common::String &name, uint lang, Common::String &found) {
+	Common::StringArray tries;
+	if (lang < ARRAYSIZE(kCreditsLangs))
+		tries.push_back(kCreditsLangs[lang]);
+	if (lang == 3)
+		tries.push_back("ge");
+	tries.push_back("en");
+	tries.push_back("it");
+	for (uint i = 0; i < tries.size(); i++) {
+		found = name + "/" + tries[i] + ".txt";
+		Common::SeekableReadStream *s = openGamePath(found);
+		if (s)
+			return s;
+	}
+	found.clear();
+	return nullptr;
+}
+
+/* ---------------- the text ---------------- */
+
+struct CreditsLine {
+	enum Kind { kTitle, kSection, kRole, kNote, kText, kSpace, kPage } kind;
+	Common::U32String a, b;		// text; role and name for kRole
+};
+
+static Common::Array<CreditsLine> parseCredits(Common::SeekableReadStream &f) {
+	Common::Array<CreditsLine> out;
+	while (!f.eos() && !f.err()) {
+		Common::String raw = f.readLine();
+		raw.trim();
+		if (raw.hasPrefix("#"))
+			continue;
+		CreditsLine l;
+		l.kind = CreditsLine::kText;
+		Common::String t = raw;
+		if (t.empty()) {
+			l.kind = CreditsLine::kSpace;
+		} else if (t == "---") {
+			l.kind = CreditsLine::kPage;
+		} else if (t.hasPrefix("== ")) {
+			l.kind = CreditsLine::kTitle;
+			t = t.substr(3);
+		} else if (t.hasPrefix("= ")) {
+			l.kind = CreditsLine::kSection;
+			t = t.substr(2);
+		} else if (t.hasPrefix("> ")) {
+			l.kind = CreditsLine::kNote;
+			t = t.substr(2);
+		} else {
+			// "Role: name" (as the launchers: a role shorter than 60 characters)
+			int colon = t.find(": ");
+			if (colon > 0 && colon < 60) {
+				l.kind = CreditsLine::kRole;
+				l.b = Common::U32String(t.substr(colon + 2).c_str(), Common::kUtf8);
+				t = t.substr(0, colon);
+			}
+		}
+		t.trim();
+		l.a = Common::U32String(t.c_str(), Common::kUtf8);
+		out.push_back(l);
+	}
+	// no empty lines at the ends
+	while (!out.empty() && (out.back().kind == CreditsLine::kSpace || out.back().kind == CreditsLine::kPage))
+		out.pop_back();
+	while (!out.empty() && (out[0].kind == CreditsLine::kSpace || out[0].kind == CreditsLine::kPage))
+		out.remove_at(0);
+	return out;
+}
+
+// capitals for the fake Cyrillic font (Latin-1 letters too: è -> È)
+static Common::U32String creditsUpper(const Common::U32String &s) {
+	Common::U32String u = s;
+	for (uint i = 0; i < u.size(); i++) {
+		uint32 c = u[i];
+		if (c < 128)
+			c = toupper(c);
+		else if (c >= 0xe0 && c <= 0xfe && c != 0xf7)
+			c -= 0x20;
+		u.setChar(c, i);
+	}
+	return u;
+}
+
+/* ---------------- faces ---------------- */
+
+// a font at a size, drawing coverage (fill, outline) into a line of overlay pixels
+class CreditsFace {
+public:
+	virtual ~CreditsFace() {}
+	virtual int height() const = 0;
+	virtual int width(const Common::String &s) const = 0;
+	// cov: w x height() pairs (fill, outline), x0 = pen position
+	virtual void draw(Common::Array<byte> &cov, int w, int x0, const Common::String &s) const = 0;
+	virtual bool caps() const { return false; }
+	virtual bool bitmap() const { return false; }
+};
+
+// an atlas of hd/fonts (3x the original font), resampled to the size asked
+class AtlasFace : public CreditsFace {
+	const HDRenderer::HDFont &_f;
+	int _num, _den;		// overlay pixels = atlas pixels * _num / _den
+	bool _caps;
+
+public:
+	AtlasFace(const HDRenderer::HDFont &f, int num, int den, bool caps) : _f(f), _num(num), _den(den), _caps(caps) {}
+	int height() const override { return (int)((int64)_f.line * _num / _den); }
+	int width(const Common::String &s) const override {
+		int w = 0;
+		for (uint i = 0; i < s.size(); i++)
+			w += _f.g[(byte)s[i]].adv;
+		return (int)((int64)w * _num / _den);
+	}
+	bool caps() const override { return _caps; }
+
+	void draw(Common::Array<byte> &cov, int w, int x0, const Common::String &s) const override {
+		const int h = height();
+		int pen = 0;	// atlas units
+		for (uint i = 0; i < s.size(); i++) {
+			const HDRenderer::HDFont::Glyph &g = _f.g[(byte)s[i]];
+			if (g.w && g.h) {
+				int gx0 = x0 + (int)((int64)(pen + g.bx) * _num / _den);
+				int gy0 = (int)((int64)g.by * _num / _den);
+				int gw = (int)((int64)g.w * _num / _den) + 2, gh = (int)((int64)g.h * _num / _den) + 2;
+				for (int y = MAX(0, gy0); y < MIN(h, gy0 + gh); y++) {
+					// atlas coordinate (8 bit fraction) of the pixel centre
+					int ay = (int)(((int64)(y - gy0) * 2 + 1) * _den * 128 / _num) - 128;
+					int ay0 = ay >> 8, wy = ay & 255;
+					for (int x = MAX(0, gx0); x < MIN(w, gx0 + gw); x++) {
+						int ax = (int)(((int64)(x - gx0) * 2 + 1) * _den * 128 / _num) - 128;
+						int ax0 = ax >> 8, wx = ax & 255;
+						for (int c = 0; c < 2; c++) {
+#define AT(xx, yy) (((xx) >= 0 && (yy) >= 0 && (xx) < g.w && (yy) < g.h) ? _f.atlas[((g.ay + (yy)) * _f.aw + g.ax + (xx)) * 2 + c] : 0)
+							int v = ((AT(ax0, ay0) * (256 - wx) + AT(ax0 + 1, ay0) * wx) * (256 - wy) +
+									 (AT(ax0, ay0 + 1) * (256 - wx) + AT(ax0 + 1, ay0 + 1) * wx) * wy) >> 16;
+#undef AT
+							byte &d = cov[(y * w + x) * 2 + c];
+							d = MAX<int>(d, v);
+						}
+					}
+				}
+			}
+			pen += g.adv;
+		}
+	}
+};
+
+// an original bitmap font of the game, scaled by a whole factor; characters the font draws blank
+// ('/', '-', brackets...) come from ScummVM's GUI font
+class BitmapFace : public CreditsFace {
+	Font *_font;
+	int _k;
+	bool _caps;
+	const Graphics::Font *_gui;
+	int8 _blank[256];
+
+	void drawRaw(Graphics::Surface &s, int x, const char *str) const {
+		int hd = _font->_hdFont;
+		_font->_hdFont = -1;
+		_font->setColor(1);
+		_font->drawString(&s, x, 0, str);
+		_font->_hdFont = hd;
+	}
+
+	bool blank(byte c) {
+		if (_blank[c] < 0) {
+			char str[2] = { (char)c, 0 };
+			Graphics::Surface s;
+			s.create(_font->getStringWidth(str) + 4, _font->height(), Graphics::PixelFormat::createFormatCLUT8());
+			drawRaw(s, 0, str);
+			bool empty = true;
+			for (int i = 0; i < s.w * s.h && empty; i++)
+				empty = ((const byte *)s.getPixels())[i] == 0;
+			s.free();
+			_blank[c] = c != ' ' && empty;
+		}
+		return _blank[c] == 1;
+	}
+
+public:
+	BitmapFace(Font *font, int k, bool caps) : _font(font), _k(MAX(1, k)), _caps(caps) {
+		_gui = FontMan.getFontByUsage(Graphics::FontManager::kGUIFont);
+		memset(_blank, -1, sizeof(_blank));
+	}
+	bool caps() const override { return _caps; }
+	bool bitmap() const override { return true; }
+	int height() const override { return _font->height() * _k; }
+
+	int charWidth(byte c) const {
+		if (const_cast<BitmapFace *>(this)->blank(c) && _gui)
+			return _gui->getCharWidth(c) + 1;
+		char str[2] = { (char)c, 0 };
+		return _font->getStringWidth(str);
+	}
+	int width(const Common::String &s) const override {
+		int w = 0;
+		for (uint i = 0; i < s.size(); i++)
+			w += charWidth(s[i]);
+		return w * _k;
+	}
+
+	void draw(Common::Array<byte> &cov, int w, int x0, const Common::String &s) const override {
+		const int fh = _font->height();
+		Graphics::Surface line;
+		line.create(MAX(1, width(s) / _k + 8), fh, Graphics::PixelFormat::createFormatCLUT8());
+		int pen = 0;
+		for (uint i = 0; i < s.size(); i++) {
+			byte c = s[i];
+			if (const_cast<BitmapFace *>(this)->blank(c) && _gui) {
+				// the GUI font, as tall as it is, centred on the line
+				_gui->drawChar(&line, c, pen, MAX(0, (fh - _gui->getFontHeight()) / 2), 1);
+			} else {
+				char str[2] = { (char)c, 0 };
+				drawRaw(line, pen, str);
+			}
+			pen += charWidth(c);
+		}
+		const int h = height();
+		for (int y = 0; y < h; y++) {
+			const byte *src = (const byte *)line.getBasePtr(0, y / _k);
+			for (int x = MAX(0, x0); x < MIN(w, x0 + line.w * _k); x++)
+				if (src[(x - x0) / _k])
+					cov[(y * w + x) * 2] = 255;
+		}
+		line.free();
+	}
+};
+
+/* ---------------- the window ---------------- */
+
+class CreditsView : public GUI::Widget {
+public:
+	CreditsView(GUI::GuiObject *boss) : GUI::Widget(boss, 0, 0, 1, 1, false) {
+		setFlags(GUI::WIDGET_ENABLED);
+	}
+	Graphics::ManagedSurface _surf;
+
+	void drawWidget() override {
+		if (_surf.getPixels())
+			g_gui.theme()->drawManagedSurface(Common::Point(_x, _y), _surf, Graphics::ALPHA_OPAQUE);
+	}
+};
+
+struct CreditsLook {
+	Common::Array<CreditsLine> lines;
+	Common::String bgPart, bg;	// background: part number and name ("0", "cornice"), empty = black
+	Common::Rect box;			// in game pixels; empty = the whole picture with a margin
+	int speed = 20;				// game pixels per second
+	bool roll = true;			// end titles (skipped by a click, closed at the end); else the menu window
+};
+
+class CreditsDialog : public GUI::Dialog {
+public:
+	CreditsDialog(Parallaction_br *vm, const CreditsLook &look) : GUI::Dialog(0, 0, 16, 16), _vm(vm), _look(look) {
+		_backgroundType = GUI::ThemeEngine::kDialogBackgroundNone;
+		_view = new CreditsView(this);
+		layout();
+	}
+
+	~CreditsDialog() override {
+		freeFaces();
+		clearRows();
+	}
+
+	void reflowLayout() override {
+		GUI::Dialog::reflowLayout();
+		if (_W == (int)g_system->getOverlayWidth() && _H == (int)g_system->getOverlayHeight()) {
+			_x = _y = 0;
+			_w = _W;
+			_h = _H;
+			_view->resize(0, 0, _W, _H, false);
+			return;
+		}
+		// the same place in the text after a change of size
+		double at = _stripH > 0 ? _pos / _stripH : 0;
+		layout();
+		_pos = at * _stripH;
+		redraw();
+	}
+
+	void open() override {
+		GUI::Dialog::open();
+		_last = g_system->getMillis();
+		if (!_look.roll)
+			hold();		// the window starts still on the first page
+		redraw();
+	}
+
+	void handleTickle() override {
+		uint32 now = g_system->getMillis();
+		uint32 dt = MIN<uint32>(now - _last, 250);
+		_last = now;
+		if (now >= _holdUntil)
+			_pos += (double)dt * _speed / 1000.0;
+		if (_look.roll && _pos > _stripH + _em) {
+			debug("CREDITS: roll ended");
+			close();
+			return;
+		}
+		if (!_look.roll)
+			_pos = MIN(_pos, (double)maxPos());
+		if ((int)_pos != _drawnPos)
+			redraw();
+		GUI::Dialog::handleTickle();
+	}
+
+	void handleKeyDown(Common::KeyState state) override {
+		switch (state.keycode) {
+		case Common::KEYCODE_UP:
+		case Common::KEYCODE_KP8:
+			scrollBy(-_lineStep);
+			return;
+		case Common::KEYCODE_DOWN:
+		case Common::KEYCODE_KP2:
+			scrollBy(_lineStep);
+			return;
+		case Common::KEYCODE_PAGEUP:
+			scrollBy(-_box.height() * 9 / 10);
+			return;
+		case Common::KEYCODE_PAGEDOWN:
+			scrollBy(_box.height() * 9 / 10);
+			return;
+		case Common::KEYCODE_HOME:
+			scrollBy(-_stripH * 2);
+			return;
+		case Common::KEYCODE_END:
+			scrollBy(_stripH * 2);
+			return;
+		case Common::KEYCODE_ESCAPE:
+		case Common::KEYCODE_RETURN:
+		case Common::KEYCODE_KP_ENTER:
+		case Common::KEYCODE_SPACE:
+			debug("CREDITS: closed by a key at %d/%d", (int)_pos, _stripH);
+			close();
+			return;
+		default:
+			break;
+		}
+	}
+
+	void handleMouseDown(int x, int y, int button, int clickCount) override {
+		if (button != 1)
+			return;
+		_pressed = true;
+		_dragged = false;
+		_downY = y;
+		_downPos = _pos;
+	}
+
+	void handleMouseMoved(int x, int y, int button) override {
+		if (!_pressed)
+			return;
+		if (ABS(y - _downY) > _slop)
+			_dragged = true;
+		if (_dragged) {
+			_pos = clampPos(_downPos - (y - _downY));
+			hold();
+			redraw();
+		}
+	}
+
+	void handleMouseUp(int x, int y, int button, int clickCount) override {
+		bool click = button == 2 || (button == 1 && _pressed && !_dragged && ABS(y - _downY) <= _slop);
+		_pressed = false;
+		if (click) {
+			debug("CREDITS: closed by a click at %d/%d", (int)_pos, _stripH);
+			close();
+		}
+	}
+
+	void handleMouseWheel(int x, int y, int direction) override {
+		scrollBy(direction * _lineStep * 3);
+	}
+
+private:
+	Parallaction_br *_vm;
+	CreditsLook _look;
+	CreditsView *_view;
+	int _W = 0, _H = 0, _em = 10, _slop = 8;
+	Graphics::ManagedSurface _bg;		// the background fitted to the overlay
+	Common::Rect _box;					// overlay pixels
+	double _pos = 0;					// strip pixel at the top of the box
+	int _drawnPos = -1000000;
+	double _speed = 60;					// overlay pixels per second
+	uint32 _last = 0, _holdUntil = 0;
+	int _lineStep = 20;
+	bool _pressed = false, _dragged = false;
+	int _downY = 0;
+	double _downPos = 0;
+
+	enum { kFaceTitle, kFaceSection, kFaceRole, kFaceText, kFaceNote, kNumFaces };
+	CreditsFace *_faces[kNumFaces] = {};
+	bool _hdLook = false;
+
+	struct Row {
+		int face;
+		uint32 color;
+		Common::String text;	// code page 850, as the face draws it
+		int y, w;
+		Graphics::ManagedSurface *surf;	// drawn when it comes into view
+	};
+	Common::Array<Row> _rows;
+	int _stripH = 0;
+
+	void freeFaces() {
+		for (int i = 0; i < kNumFaces; i++) {
+			delete _faces[i];
+			_faces[i] = nullptr;
+		}
+	}
+
+	void clearRows() {
+		for (uint i = 0; i < _rows.size(); i++)
+			delete _rows[i].surf;
+		_rows.clear();
+	}
+
+	int maxPos() const { return _look.roll ? _stripH + _em : MAX(0, _stripH - _box.height() + _em * 2); }
+	double clampPos(double p) const { return CLIP<double>(p, _look.roll ? -_box.height() : -_em, maxPos()); }
+	void hold() { _holdUntil = g_system->getMillis() + 2500; }
+
+	void scrollBy(int d) {
+		_pos = clampPos(_pos + d);
+		hold();
+		redraw();
+	}
+
+	// the background picture: HD (wide when the screen is), else the original background, else none
+	Graphics::Surface *loadBackground(int &bandL, int &w, int &h) {
+		bandL = 0;
+		w = 640;
+		h = 400;
+		if (_look.bg.empty())
+			return nullptr;
+		Common::String part = "PART" + _look.bgPart;
+		if (_hdLook) {
+			bool wide = _W * 10 > _H * 17;
+			const char *const names[] = { "%s_w.jpg", "%s_w.png", "%s.jpg", "%s.png" };
+			for (int i = wide ? 0 : 2; i < 4; i++) {
+				Common::String file = "hd/" + part + "/bkg/" + Common::String::format(names[i], _look.bg.c_str());
+				Common::SeekableReadStream *s = openGamePath(file);
+				if (!s)
+					continue;
+				Image::PNGDecoder png;
+				Image::JPEGDecoder jpeg;
+				jpeg.setOutputPixelFormat(kCreditsFormat);
+				Image::ImageDecoder *dec = file.hasSuffix(".png") ? (Image::ImageDecoder *)&png : &jpeg;
+				Graphics::Surface *out = nullptr;
+				if (dec->loadStream(*s) && dec->getSurface()) {
+					out = dec->getSurface()->convertTo(kCreditsFormat, dec->getPalette().data(), dec->getPalette().size());
+					// a wide picture has 36 game pixels more on each side (docs: 16:9)
+					w = i < 2 ? 712 : 640;
+					bandL = i < 2 ? 36 : 0;
+				}
+				delete s;
+				if (out) {
+					debug("CREDITS: background %s", file.c_str());
+					return out;
+				}
+			}
+		}
+		// the original background (part folder, BKG)
+		Common::SeekableReadStream *s = openGamePath(part + "/bkg/" + _look.bg + ".bkg");
+		if (!s) {
+			warning("Credits: no background %s/%s", part.c_str(), _look.bg.c_str());
+			return nullptr;
+		}
+		s->skip(4);
+		uint bw = s->readUint32BE();
+		if (bw & 1)
+			bw++;
+		uint bh = s->readUint32BE();
+		s->skip(20);
+		byte rgb[768];
+		s->read(rgb, 768);
+		Common::Array<byte> px(bw * bh);
+		s->read(&px[0], px.size());
+		bool ok = !s->err() && bw > 0 && bh > 0;
+		delete s;
+		if (!ok)
+			return nullptr;
+		Graphics::Surface *out = new Graphics::Surface;
+		out->create(bw, bh, kCreditsFormat);
+		for (uint y = 0; y < bh; y++) {
+			uint32 *d = (uint32 *)out->getBasePtr(0, y);
+			for (uint x = 0; x < bw; x++) {
+				byte c = px[y * bw + x];
+				d[x] = kCreditsFormat.RGBToColor(rgb[c], rgb[c + 256], rgb[c + 512]);
+			}
+		}
+		w = bw;
+		h = bh;
+		debug("CREDITS: background %s/bkg/%s.bkg (original)", part.c_str(), _look.bg.c_str());
+		return out;
+	}
+
+	void makeFaces(double u) {
+		freeFaces();
+		HDRenderer *hd = _vm->_gfx ? _vm->_gfx->_hd : nullptr;
+		const HDRenderer::HDFont *comic = hd ? hd->hdFont(0) : nullptr;
+		const HDRenderer::HDFont *russia = hd ? hd->hdFont(1) : nullptr;
+		_hdLook = hd && !hdClassic() && comic && russia;
+		if (_hdLook) {
+			// atlas at 3x of the original fonts: u / 3 times the size in game pixels
+			int num = (int)(u * 1000);
+			_faces[kFaceTitle] = new AtlasFace(*russia, num * 16 / 10, 3000, true);
+			_faces[kFaceSection] = new AtlasFace(*russia, num * 11 / 10, 3000, true);
+			_faces[kFaceRole] = new AtlasFace(*comic, num * 85 / 100, 3000, false);
+			_faces[kFaceText] = new AtlasFace(*comic, num, 3000, false);
+			_faces[kFaceNote] = new AtlasFace(*comic, num * 8 / 10, 3000, false);
+		} else {
+			int k = MAX(1, (int)(u + 0.01));
+			_faces[kFaceTitle] = new BitmapFace(_vm->_menuFont, k, true);
+			_faces[kFaceSection] = new BitmapFace(_vm->_menuFont, k, true);
+			_faces[kFaceRole] = new BitmapFace(_vm->_dialogueFont, k, false);
+			_faces[kFaceText] = new BitmapFace(_vm->_dialogueFont, k, false);
+			_faces[kFaceNote] = new BitmapFace(_vm->_dialogueFont, k, false);
+		}
+	}
+
+	// a text in the code page of the fonts, wrapped to the box
+	void addRows(int face, uint32 color, const Common::U32String &text, int &y, int lineGap) {
+		CreditsFace *f = _faces[face];
+		Common::String t = (f->caps() ? creditsUpper(text) : text).encode(Common::kDos850);
+		if (f->bitmap())
+			t = Parallaction::bitmapFontSpelling(t, true);
+		const int maxW = _box.width() - 2 * _em;
+		while (!t.empty()) {
+			uint cut = t.size();
+			if (f->width(t) > maxW) {
+				// the longest start that fits, broken at a space
+				uint lastSpace = 0, i = 1;
+				for (; i <= t.size(); i++) {
+					if (i < t.size() && t[i] == ' ')
+						lastSpace = i;
+					if (f->width(t.substr(0, i)) > maxW)
+						break;
+				}
+				cut = lastSpace ? lastSpace : MAX<uint>(1, i - 1);
+			}
+			Row r;
+			r.face = face;
+			r.color = color;
+			r.text = t.substr(0, cut);
+			r.text.trim();
+			r.w = f->width(r.text);
+			r.y = y;
+			r.surf = nullptr;
+			_rows.push_back(r);
+			y += f->height() + lineGap;
+			t = cut < t.size() ? t.substr(cut) : Common::String();
+			t.trim();
+		}
+	}
+
+	void layout() {
+		_W = g_system->getOverlayWidth();
+		_H = g_system->getOverlayHeight();
+		_view->_surf.create(_W, _H, kCreditsFormat);
+		_w = _W;
+		_h = _H;
+		_x = _y = 0;
+		_view->resize(0, 0, _W, _H, false);
+
+		// first guess of the scale (game pixels -> overlay) for the choice of the faces
+		makeFaces(MIN(_W / 640.0, _H / 400.0));
+		int bandL, bw, bh;
+		Graphics::Surface *bg = loadBackground(bandL, bw, bh);
+		// the picture (or the game screen when there is none) fitted to the overlay
+		int pw = bg ? (bandL ? 712 : 640) : 640;
+		double u = MIN((double)_W / pw, (double)_H / 400);
+		if (!_hdLook)
+			u = MAX(1.0, floor(u + 0.01));	// the bitmap fonts at a whole factor, the picture with them
+		int dw = (int)(pw * u), dh = (int)(400 * u);
+		int ox = (_W - dw) / 2, oy = (_H - dh) / 2;
+		makeFaces(u);
+
+		_bg.create(_W, _H, kCreditsFormat);
+		_bg.fillRect(Common::Rect(_W, _H), kCreditsFormat.RGBToColor(0, 0, 0));
+		if (bg) {
+			// scaled to dw x dh: bilinear for the HD picture, pixels as they are for the original
+			for (int y = 0; y < dh; y++) {
+				if (oy + y < 0 || oy + y >= _H)
+					continue;
+				uint32 *d = (uint32 *)_bg.getBasePtr(0, oy + y);
+				double sy = (y + 0.5) * bg->h / dh - 0.5;
+				for (int x = 0; x < dw; x++) {
+					if (ox + x < 0 || ox + x >= _W)
+						continue;
+					double sx = (x + 0.5) * bg->w / dw - 0.5;
+					if (!_hdLook) {
+						int ix = CLIP((int)((x * (int64)bg->w) / dw), 0, (int)bg->w - 1);
+						int iy = CLIP((int)((y * (int64)bg->h) / dh), 0, (int)bg->h - 1);
+						d[ox + x] = *(const uint32 *)bg->getBasePtr(ix, iy);
+						continue;
+					}
+					int x0 = CLIP((int)floor(sx), 0, (int)bg->w - 1), y0 = CLIP((int)floor(sy), 0, (int)bg->h - 1);
+					int x1 = MIN(x0 + 1, (int)bg->w - 1), y1 = MIN(y0 + 1, (int)bg->h - 1);
+					int fx = CLIP((int)((sx - floor(sx)) * 256), 0, 256), fy = CLIP((int)((sy - floor(sy)) * 256), 0, 256);
+					uint32 p00 = *(const uint32 *)bg->getBasePtr(x0, y0), p10 = *(const uint32 *)bg->getBasePtr(x1, y0);
+					uint32 p01 = *(const uint32 *)bg->getBasePtr(x0, y1), p11 = *(const uint32 *)bg->getBasePtr(x1, y1);
+					uint32 o = 0;
+					for (int sh = 8; sh < 32; sh += 8) {
+						int a = ((p00 >> sh) & 255) * (256 - fx) + ((p10 >> sh) & 255) * fx;
+						int b = ((p01 >> sh) & 255) * (256 - fx) + ((p11 >> sh) & 255) * fx;
+						o |= (uint32)(((a * (256 - fy) + b * fy) >> 16) & 255) << sh;
+					}
+					d[ox + x] = o | 0xff;
+				}
+			}
+			bg->free();
+			delete bg;
+		}
+
+		// the box of the text, game pixels of the 640x400 screen -> overlay
+		Common::Rect box = _look.box;
+		if (box.isEmpty())
+			box = Common::Rect(40, 30, 600, 370);
+		_box = Common::Rect(ox + (int)((box.left + bandL) * u), oy + (int)(box.top * u),
+			ox + (int)((box.right + bandL) * u), oy + (int)(box.bottom * u));
+		_box.clip(Common::Rect(_W, _H));
+		_em = MAX(4, (int)(6 * u));
+		_slop = MAX(6, _em);
+		_speed = _look.speed * u;
+
+		// the rows of the text
+		clearRows();
+		const uint32 kTitle = 0xf3ece0, kSection = 0xe6282e, kRole = 0xf0b429, kText = 0xf3ece0, kNote = 0xc8b496;
+		int y = 0;
+		const int gap = MAX(1, (int)u);
+		bool pageStart = true;
+		for (uint i = 0; i < _look.lines.size(); i++) {
+			const CreditsLine &l = _look.lines[i];
+			switch (l.kind) {
+			case CreditsLine::kPage:
+				y += _box.height() / 2;
+				pageStart = true;
+				break;
+			case CreditsLine::kSpace:
+				y += _faces[kFaceText]->height() / 2;
+				break;
+			case CreditsLine::kTitle:
+				if (!pageStart)
+					y += _faces[kFaceTitle]->height();
+				addRows(kFaceTitle, kTitle, l.a, y, gap);
+				y += _faces[kFaceText]->height() / 2;
+				break;
+			case CreditsLine::kSection:
+				y += _faces[kFaceText]->height() * 3 / 4;
+				addRows(kFaceSection, kSection, l.a, y, gap);
+				y += gap * 2;
+				break;
+			case CreditsLine::kRole:
+				// role above, name below, as in the titles of a film
+				addRows(kFaceRole, kRole, l.a, y, gap);
+				addRows(kFaceText, kText, l.b, y, gap);
+				y += gap * 3;
+				break;
+			case CreditsLine::kNote:
+				addRows(kFaceNote, kNote, l.a, y, gap);
+				y += gap * 2;
+				break;
+			case CreditsLine::kText:
+				addRows(kFaceText, kText, l.a, y, gap);
+				y += gap * 2;
+				break;
+			}
+			if (l.kind != CreditsLine::kPage && l.kind != CreditsLine::kSpace)
+				pageStart = false;
+		}
+		_stripH = y;
+		_lineStep = _faces[kFaceText]->height() + gap;
+		_pos = _look.roll ? -_box.height() : -_em;
+		_drawnPos = -1000000;
+		debug("CREDITS: layout %s, overlay %dx%d, box %d,%d-%d,%d, %d rows, %d px, %d px/s", _hdLook ? "hd" : "bitmap",
+			_W, _H, _box.left, _box.top, _box.right, _box.bottom, _rows.size(), _stripH, (int)_speed);
+	}
+
+	Graphics::ManagedSurface *rowSurface(Row &r) {
+		if (r.surf)
+			return r.surf;
+		CreditsFace *f = _faces[r.face];
+		int w = MAX(1, r.w + 4), h = f->height();
+		Common::Array<byte> cov(w * h * 2, 0);
+		f->draw(cov, w, 2, r.text);
+		r.surf = new Graphics::ManagedSurface(w, h, kCreditsFormat);
+		const byte cr = r.color >> 16, cg = (r.color >> 8) & 255, cb = r.color & 255;
+		for (int y = 0; y < h; y++) {
+			uint32 *d = (uint32 *)r.surf->getBasePtr(0, y);
+			for (int x = 0; x < w; x++) {
+				int fill = cov[(y * w + x) * 2], line = cov[(y * w + x) * 2 + 1];
+				// fill over a dark outline: alpha = the union, colour = fill against black
+				int a = MAX(fill, line);
+				int k = a ? fill * 255 / a : 0;
+				d[x] = kCreditsFormat.ARGBToColor(a, cr * k / 255, cg * k / 255, cb * k / 255);
+			}
+		}
+		return r.surf;
+	}
+
+	void redraw() {
+		Graphics::ManagedSurface &s = _view->_surf;
+		s.blitFrom(_bg);
+		_drawnPos = (int)_pos;
+		const int fade = MAX(1, _box.height() / 10);
+		for (uint i = 0; i < _rows.size(); i++) {
+			Row &r = _rows[i];
+			int h = _faces[r.face]->height();
+			int top = _box.top + r.y - _drawnPos;
+			if (top + h <= _box.top || top >= _box.bottom) {
+				// out of view: let go of its picture
+				delete r.surf;
+				r.surf = nullptr;
+				continue;
+			}
+			Graphics::ManagedSurface *rs = rowSurface(r);
+			int left = _box.left + (_box.width() - rs->w) / 2;
+			for (int y = MAX(top, (int)_box.top); y < MIN(top + rs->h, (int)_box.bottom); y++) {
+				// fade in and out at the top and bottom of the box
+				int edge = MIN(y - _box.top, _box.bottom - 1 - y);
+				int fa = edge >= fade ? 256 : edge * 256 / fade;
+				const uint32 *src = (const uint32 *)rs->getBasePtr(0, y - top);
+				uint32 *d = (uint32 *)s.getBasePtr(0, y);
+				for (int x = MAX(left, (int)_box.left); x < MIN(left + rs->w, (int)_box.right); x++) {
+					uint32 p = src[x - left];
+					int a = (p & 255) * fa >> 8;
+					if (!a)
+						continue;
+					uint32 q = d[x];
+					uint32 o = 0xff;
+					for (int sh = 8; sh < 32; sh += 8)
+						o |= (uint32)((((p >> sh) & 255) * a + ((q >> sh) & 255) * (255 - a)) / 255) << sh;
+					d[x] = o;
+				}
+			}
+		}
+		_view->markAsDirty();
+		g_gui.scheduleTopDialogRedraw();
+	}
+};
+
+/* ---------------- the engine ---------------- */
+
+void Parallaction_br::loadCreditsRolls() {
+	_creditsRollsLoaded = true;
+	Common::File f;
+	if (!f.open(Common::Path("loc/titoli.txt", '/')))
+		return;
+	while (!f.eos() && !f.err()) {
+		Common::String line = f.readLine();
+		int hash = line.findFirstOf('#');
+		if (hash >= 0)
+			line = Common::String(line.c_str(), hash);
+		// <part> <location> <seconds> <text> [sfondo=<part>/<background>] [riquadro=x1,y1,x2,y2] [velocita=<px/s>]
+		Common::StringTokenizer tok(line, " \t");
+		Common::StringArray w;
+		while (!tok.empty())
+			w.push_back(tok.nextToken());
+		if (w.empty())
+			continue;
+		if (w.size() < 4 || !Common::isDigit(w[0][0]) || !Common::isDigit(w[2][0])) {
+			warning("loc/titoli.txt: bad line '%s'", line.c_str());
+			continue;
+		}
+		CreditsRoll r;
+		r.part = atoi(w[0].c_str());
+		r.location = w[1];
+		r.delayMs = (uint32)(atof(w[2].c_str()) * 1000);
+		r.text = w[3];
+		for (uint i = 4; i < w.size(); i++) {
+			int eq = w[i].findFirstOf('=');
+			Common::String key = eq > 0 ? Common::String(w[i].c_str(), eq) : w[i];
+			Common::String val = eq > 0 ? Common::String(w[i].c_str() + eq + 1) : Common::String();
+			int x1, y1, x2, y2;
+			if (key.equalsIgnoreCase("sfondo") || key.equalsIgnoreCase("background")) {
+				int slash = val.findFirstOf('/');
+				if (slash > 0) {
+					r.bgPart = val.substr(0, slash);
+					r.bg = val.substr(slash + 1);
+				} else {
+					warning("loc/titoli.txt: background '%s' is not <part>/<name>", val.c_str());
+				}
+			} else if ((key.equalsIgnoreCase("riquadro") || key.equalsIgnoreCase("box")) &&
+					sscanf(val.c_str(), "%d,%d,%d,%d", &x1, &y1, &x2, &y2) == 4 && x2 > x1 && y2 > y1) {
+				r.box = Common::Rect(x1, y1, x2, y2);
+			} else if (key.equalsIgnoreCase("velocita") || key.equalsIgnoreCase("speed")) {
+				r.speed = CLIP(atoi(val.c_str()), 1, 400);
+			} else {
+				warning("loc/titoli.txt: unknown field '%s'", w[i].c_str());
+			}
+		}
+		_creditsRolls.push_back(r);
+	}
+	debugC(1, kDebugParser, "%d credit rolls loaded", _creditsRolls.size());
+}
+
+const Parallaction_br::CreditsRoll *Parallaction_br::creditsRollFor(const Common::String &text) {
+	if (!_creditsRollsLoaded)
+		loadCreditsRolls();
+	for (uint i = 0; i < _creditsRolls.size(); i++)
+		if (_creditsRolls[i].text.equalsIgnoreCase(text))
+			return &_creditsRolls[i];
+	return nullptr;
+}
+
+void Parallaction_br::armCreditsRoll() {
+	if (!_creditsRollsLoaded)
+		loadCreditsRolls();
+	_creditsRollDue = -1;
+	for (uint i = 0; i < _creditsRolls.size(); i++) {
+		const CreditsRoll &r = _creditsRolls[i];
+		if (r.part == _part && !scumm_stricmp(r.location.c_str(), _location._name)) {
+			_creditsRollDue = i;
+			_creditsRollAt = _system->getMillis() + r.delayMs;
+			debug("CREDITS: %s/<language>.txt rolls in %u ms (part %d, %s)", r.text.c_str(), r.delayMs, _part, _location._name);
+			return;
+		}
+	}
+}
+
+void Parallaction_br::updateCreditsRoll() {
+	if (_creditsRollDue < 0 || (int32)(_system->getMillis() - _creditsRollAt) < 0 ||
+		_input->_inputMode != Input::kInputModeGame || (g_engineFlags & kEngineChangeLocation))
+		return;
+	const CreditsRoll r = _creditsRolls[_creditsRollDue];
+	_creditsRollDue = -1;	// once per visit
+	showCredits(r.text, &r);
+}
+
+bool Parallaction_br::hasCredits(const Common::String &text) {
+	Common::String found;
+	Common::SeekableReadStream *s = openCreditsText(text, _langIndex, found);
+	bool ok = s != nullptr;
+	delete s;
+	return ok;
+}
+
+void Parallaction_br::showCredits(const Common::String &text, const CreditsRoll *roll) {
+	Common::String found;
+	Common::SeekableReadStream *s = openCreditsText(text, _langIndex, found);
+	if (!s) {
+		warning("Credits: no %s/<language>.txt", text.c_str());
+		return;
+	}
+	CreditsLook look;
+	look.lines = parseCredits(*s);
+	delete s;
+	look.roll = roll != nullptr;
+	// the window of the menu takes the look of the roll of the same text, if there is one
+	if (!roll)
+		roll = creditsRollFor(text);
+	if (roll) {
+		look.bgPart = roll->bgPart;
+		look.bg = roll->bg;
+		look.box = roll->box;
+		look.speed = roll->speed;
+	}
+	debug("CREDITS: open %s (%s), %u lines", found.c_str(), look.roll ? "roll" : "window", look.lines.size());
+	CreditsDialog dlg(this, look);
+	// the end titles leave the music playing (no pause); from the menu the game is paused already
+	dlg.runModal();
+	debug("CREDITS: closed");
+	if (_input)
+		_input->setCursorFromScreen(_system->getEventManager()->getMousePos());
+}
+
