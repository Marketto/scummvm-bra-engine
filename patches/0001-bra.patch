+	bool moving = false;
+
+	int maxX = _vm->_gfx->_backgroundInfo->width;
+	int minX = 0;
+	int maxY = _vm->_gfx->_backgroundInfo->height;
+	int minY = 0;
+
+	dirFrame = 0;
+	newpos = start;
+	Common::Point delta;
+
+	// The last step towards the destination is shorter than a whole step: check the point it lands on,
+	// not the one a whole step would reach. Checking the whole step (as the original ScummVM code did)
+	// stopped a character a step away from a narrow door at the edge of the background (train roof:
+	// the door to the next carriage is 10 px wide, Doug stopped at x 12 and never went through).
+	const int downY = MIN<int>(start.y + yStep, p.y), upY = MAX<int>(start.y - yStep, p.y);
+	if (start.y < p.y && downY < maxY && isPathClear(start.x, downY)) {
