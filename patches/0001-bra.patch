+HDRenderer::HDRenderer(Parallaction *vm, int scale) : _vm(vm), _scale(scale), _bgX(0), _bgY(0),
+	_paletteDirty(true), _scaled(nullptr), _scaledPitch(0),
+	_prevFrame(nullptr), _prevIds(nullptr), _prevIdsSize(0), _prevScrollX(-1), _prevScrollY(-1), _fullRedraw(true),
+	_xbr(nullptr), _diffDirty(true), _useXBR(scale == 3),
+	_sprEnabled(false), _sprCacheBytes(0), _frameNo(0), _ids(nullptr), _idW(0), _idH(0) {
+
+	if (ConfMan.hasKey("hd_sprite_filter") && ConfMan.get("hd_sprite_filter") == "scale3x")
+		_useXBR = false;
+	// 16:9 picture (hd_widescreen=false keeps the original 16:10 frame)
+	if (!ConfMan.hasKey("hd_widescreen") || ConfMan.getBool("hd_widescreen"))
+		_wideM = 36;
+
+	// pick a true color mode supported by the backend, preferring 32 bits
+	_format = Graphics::PixelFormat(4, 8, 8, 8, 8, 24, 16, 8, 0);
+	Common::List<Graphics::PixelFormat> formats = g_system->getSupportedFormats();
+	for (Common::List<Graphics::PixelFormat>::iterator it = formats.begin(); it != formats.end(); ++it) {
+		if (it->bytesPerPixel == 4) {
+			_format = *it;
+			break;
+		}
+	}
+
+	memset(_bgPal, 0, sizeof(_bgPal));
+	memset(_curPal, 0, sizeof(_curPal));
+	// setPalette only converts the entries that change: start from black in the chosen format
+	for (int i = 0; i < 256; i++)
+		_curPalPixel[i] = _format.RGBToColor(0, 0, 0);
+	memset(_palChanged, 0, sizeof(_palChanged));
+	memset(_frozen, 0, sizeof(_frozen));
+	memset(_mode, kLowRes, sizeof(_mode));
+	memset(_factor, 0, sizeof(_factor));
+
+	g_hdSpriteDebug = ConfMan.hasKey("hd_sprite_debug") && ConfMan.getBool("hd_sprite_debug");
+	if (ConfMan.hasKey("hd_dump_sprites"))
+		_dumpDir = ConfMan.get("hd_dump_sprites");
+	if (!ConfMan.hasKey("hd_sprites") || ConfMan.getBool("hd_sprites"))
+		loadSpriteIndex();
+	loadFonts();
+}
