+// The original (ChangeLocation_ in ADV.EXE) showed the ENDCOMMENT of a location before loading the next
+// one: the palette fades to grey, the comment box, a click. Not when a saved game is loaded or the location
+// is entered again; only with the Director's Cut (bra_directors_cut, on when absent).
+void Parallaction_br::showLocationEndComment() {
+	if (_location._endComment.empty() || _pendingLoad || _locationFile.empty())
+		return;
+	// the file left, not _location._name (its LOCATION line names the background: LENTV.LOC says TV)
+	if (_nextPart == -1 && _newLocationName.equalsIgnoreCase(_locationFile))
+		return;
+	if (!braSettingOn("bra_directors_cut")) {
+		debugC(1, kDebugExec, "end comment of %s: off (bra_directors_cut)", _locationFile.c_str());
+		return;
+	}
+	debugC(1, kDebugExec, "end comment of %s", _locationFile.c_str());
+
+	Palette grey(_gfx->_palette);
+	grey.makeGrayscale();
+	Palette pal(_gfx->_palette);
+	for (uint i = 0; i < 64; i++) {
+		pal.fadeTo(grey, 1);
+		_gfx->setPalette(pal);
+		_gfx->updateScreen();
+		_system->delayMillis(20);
+		if (shouldQuit())
+			return;
+	}
+	_gfx->setPalette(grey);
+
+	showLocationComment(_location._endComment, true);
+	_gfx->updateScreen();
+
+	_input->waitForButtonEvent(kMouseLeftUp);
+	_gfx->freeDialogueObjects();
+	setTTSVoice(_characterVoiceID);
+	_location._endComment.clear();
+	debugC(1, kDebugExec, "end comment of %s closed", _locationFile.c_str());
+}
