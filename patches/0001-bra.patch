+// Where the next step will take the feet of a figure moved by this walker (the smooth motion draws
+// it on the way there); false if it is not walking or the next step does not move it.
+bool PathWalker_BR::nextFoot(const AnimationPtr &a, Common::Point &foot) {
+	State *s = nullptr;
+	if (_character._active && _character._a == a)
+		s = &_character;
+	else if (_follower._active && _follower._a == a)
+		s = &_follower;
+	if (!s || !(g_engineFlags & kEngineWalking) || s->_walkDelay > 0 || s->_walkPath.empty())
+		return false;
+	PointList::iterator node = s->_walkPath.begin();
+	if (!s->_stillWalkingTowardsNode) {
+		// this node is reached: the next step heads for the following one (or ends the walk)
+		++node;
+		if (node == s->_walkPath.end())
+			return false;
+	}
+	Common::Point start;
+	a->getFoot(start);
+	int dirFrame;
+	return stepTowards(start, *node, foot, dirFrame);
+}
