+static Common::StringArray splitEditLines(const Common::String &field) {
+	// lines of a field of loc/righe.txt are separated by the two characters \n; an empty field has no lines
+	Common::StringArray out;
+	if (field.empty())
+		return out;
+	Common::String cur;
+	for (uint i = 0; i < field.size(); i++) {
+		if (field[i] == '\\' && i + 1 < field.size() && field[i + 1] == 'n') {
+			out.push_back(cur);
+			cur.clear();
+			i++;
+		} else {
+			cur += field[i];
+		}
+	}
+	out.push_back(cur);
+	return out;
