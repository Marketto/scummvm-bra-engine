+		Common::String line = f.readLine();
+		int hash = line.findFirstOf('#');
+		if (hash >= 0)
+			line = Common::String(line.c_str(), hash);
+		line.trim();
+		if (line.empty())
+			continue;
+		// <from> TAB <to> TAB <flag> TAB <condition> [TAB opzione=<setting>]
+		Common::StringTokenizer tok(line, "\t");
+		Common::StringArray w;
+		while (!tok.empty()) {
+			Common::String x = tok.nextToken();
+			x.trim();
+			if (!x.empty())
+				w.push_back(x);
+		}
+		if (w.size() < 4 || !Common::isDigit(w[0][0]) || !Common::isDigit(w[1][0])) {
+			warning("loc/flag-parti.txt: bad line '%s'", line.c_str());
+			continue;
+		}
+		PartFlagRule r;
+		r.from = atoi(w[0].c_str());
+		r.to = atoi(w[1].c_str());
+		r.flag = w[2];
+		r.condition = w[3];
+		for (uint i = 4; i < w.size(); i++) {
+			if (w[i].hasPrefixIgnoreCase("opzione=") || w[i].hasPrefixIgnoreCase("setting="))
+				r.setting = w[i].c_str() + w[i].findFirstOf('=') + 1;
+			else
+				warning("loc/flag-parti.txt: unknown field '%s'", w[i].c_str());
+		}
+		_partFlagRules.push_back(r);
+	}
+	debugC(1, kDebugParser, "%d part flag rules loaded", _partFlagRules.size());
+}
+
+void Parallaction_br::addPartFlag(const Common::String &entry) {
+	for (uint i = 0; i < _partFlags.size(); i++)
+		if (_partFlags[i].equalsIgnoreCase(entry))
+			return;
+	_partFlags.push_back(entry);
+}
+
+void Parallaction_br::rememberPartFlags() {
+	if (!_partFlagRulesLoaded)
+		loadPartFlagRules();
+	if (_part < 0 || !_globalFlagsNames)
+		return;
+	for (uint i = 0; i < _partFlagRules.size(); i++) {
+		const PartFlagRule &r = _partFlagRules[i];
+		if (r.from != _part || (!r.setting.empty() && !braSettingOn(r.setting.c_str())))
+			continue;
+		if (!hintCondition(r.condition)) {
+			debugC(1, kDebugExec, "flag-parti: %d:%s not remembered", r.to, r.flag.c_str());
+			continue;
+		}
+		addPartFlag(Common::String::format("%d:%s", r.to, r.flag.c_str()));
+		debugC(1, kDebugExec, "flag-parti: %d:%s remembered", r.to, r.flag.c_str());
+	}
+}
+
+void Parallaction_br::applyPartFlags() {
+	if (!_partFlagRulesLoaded)
+		loadPartFlagRules();
+	for (uint i = 0; i < _partFlags.size(); i++) {
+		const Common::String &e = _partFlags[i];
+		int colon = e.findFirstOf(':');
+		if (colon <= 0 || atoi(e.c_str()) != _part)
+			continue;
+		Common::String flag = e.substr(colon + 1);
+		// a rule turned off by its setting (the Director's Cut switched off since) sets nothing
+		bool off = false;
+		for (uint k = 0; k < _partFlagRules.size(); k++) {
+			const PartFlagRule &r = _partFlagRules[k];
+			if (r.to == _part && r.flag.equalsIgnoreCase(flag) && !r.setting.empty() && !braSettingOn(r.setting.c_str()))
+				off = true;
+		}
+		if (off) {
+			debugC(1, kDebugExec, "flag-parti: %s off by its setting", e.c_str());
+			continue;
+		}
+		uint16 n = _globalFlagsNames ? _globalFlagsNames->lookup(flag.c_str()) : Table::notFound;
+		if (n == Table::notFound) {
+			warning("loc/flag-parti.txt: no global flag %s in part %d", flag.c_str(), _part);
+			continue;
+		}
+		g_globalFlags |= 1u << (n - 1);
+		debugC(1, kDebugExec, "flag-parti: %s set", e.c_str());
+	}
+}
+
+void Parallaction_br::markTaken(int item) {
+	if (item >= 4 && item < (int)(ARRAYSIZE(_takenItems) * 32))
+		_takenItems[item / 32] |= 1u << (item % 32);
+}
+
+bool Parallaction_br::wasTaken(int item) const {
+	return item >= 4 && item < (int)(ARRAYSIZE(_takenItems) * 32) && (_takenItems[item / 32] & (1u << (item % 32)));
+}
+
+Common::Array<uint16> Parallaction_br::takenItems() const {
+	Common::Array<uint16> out;
+	for (int i = 4; i < (int)(ARRAYSIZE(_takenItems) * 32); i++)
+		if (wasTaken(i))
+			out.push_back(i);
+	return out;
+}
