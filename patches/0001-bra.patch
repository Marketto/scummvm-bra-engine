+Common::String Parallaction::voiceKey(const Common::String &text) {
+	// same as zlib's crc32 (reflected, poly 0xedb88320)
+	uint32 crc = 0xffffffff;
+	for (uint i = 0; i < text.size(); i++) {
+		byte c = (byte)text[i];
+		if (c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\\' || c == '\v' || c == '\f')
+			continue;
+		crc ^= c;
+		for (int k = 0; k < 8; k++)
+			crc = (crc >> 1) ^ (0xedb88320 & (0 - (crc & 1)));
+	}
+	return Common::String::format("%08x", crc ^ 0xffffffff);
+}
